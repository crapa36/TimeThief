#include "/Engine/Public/Platform.ush"

int3 GridResolution;
int3 GroupGridResolution;

Texture3D<float4> VelocityTexture;
RWStructuredBuffer<float> OutTileMaximums;

StructuredBuffer<float> TileMaximums;
RWStructuredBuffer<float> OutMaximum;

groupshared float GroupMaximums[64];

[numthreads(4, 4, 4)]
void ReduceTilesCS(
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex,
	uint3 GroupId : SV_GroupID)
{
	float MaximumVelocity = 0.0;

	if (all(DispatchThreadId < uint3(GridResolution)))
	{
		const float3 Velocity = VelocityTexture.Load(int4(int3(DispatchThreadId), 0)).xyz;
		MaximumVelocity = length(Velocity);
	}

	GroupMaximums[GroupIndex] = MaximumVelocity;
	GroupMemoryBarrierWithGroupSync();

	for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
	{
		if (GroupIndex < Stride)
		{
			GroupMaximums[GroupIndex] = max(
				GroupMaximums[GroupIndex],
				GroupMaximums[GroupIndex + Stride]);
		}

		GroupMemoryBarrierWithGroupSync();
	}

	if (GroupIndex == 0u)
	{
		const uint TileGridX = uint(max(GroupGridResolution.x, 1));
		const uint TileGridY = uint(max(GroupGridResolution.y, 1));
		const uint TileIndex =
			GroupId.x +
			GroupId.y * TileGridX +
			GroupId.z * TileGridX * TileGridY;

		OutTileMaximums[TileIndex] = GroupMaximums[0];
	}
}

[numthreads(64, 1, 1)]
void ReduceFinalCS(uint GroupIndex : SV_GroupIndex)
{
	const uint TileCount =
		uint(max(GroupGridResolution.x, 1)) *
		uint(max(GroupGridResolution.y, 1)) *
		uint(max(GroupGridResolution.z, 1));

	float MaximumVelocity = 0.0;
	for (uint TileIndex = GroupIndex; TileIndex < TileCount; TileIndex += 64u)
	{
		MaximumVelocity = max(MaximumVelocity, TileMaximums[TileIndex]);
	}

	GroupMaximums[GroupIndex] = MaximumVelocity;
	GroupMemoryBarrierWithGroupSync();

	for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
	{
		if (GroupIndex < Stride)
		{
			GroupMaximums[GroupIndex] = max(
				GroupMaximums[GroupIndex],
				GroupMaximums[GroupIndex + Stride]);
		}

		GroupMemoryBarrierWithGroupSync();
	}

	if (GroupIndex == 0u)
	{
		OutMaximum[0] = GroupMaximums[0];
	}
}
