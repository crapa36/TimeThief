#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_PRESSURE_JACOBI_PARAMETERS

bool IsSparseSimulationCellActive(uint3 CellCoord)
{
	if (bUseSparseSimulationMask == 0u)
	{
		return true;
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return BrickOccupancyTexture.Load(int4(BrickCoord, 0)) != 0u;
}

bool ResolveSmokeCellCoord(uint3 DispatchThreadId, uint3 GroupId, uint3 GroupThreadId, out uint3 OutCellCoord)
{
	if (bUseActiveBrickDispatch == 0u)
	{
		OutCellCoord = DispatchThreadId;
		return all(OutCellCoord < uint3(GridResolution));
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const uint ActiveBrickCount = min(ActiveBrickCountBuffer[0], (uint)max(MaxActiveSmokeBricks, 1));
	const uint GroupsPerBrickAxis = (uint)((SafeBrickSize + 3) / 4);
	const uint GroupsPerBrick = max(GroupsPerBrickAxis * GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const uint LocalGroupIndex = GroupId.x;
	const uint ActiveBrickIndex = GroupId.y;
	if (ActiveBrickIndex >= ActiveBrickCount || LocalGroupIndex >= GroupsPerBrick)
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint LocalGroupX = LocalGroupIndex % GroupsPerBrickAxis;
	const uint LocalGroupY = (LocalGroupIndex / GroupsPerBrickAxis) % GroupsPerBrickAxis;
	const uint LocalGroupZ = LocalGroupIndex / max(GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const int3 LocalCellCoord = int3(LocalGroupX, LocalGroupY, LocalGroupZ) * 4 + int3(GroupThreadId);
	if (any(LocalCellCoord >= int3(SafeBrickSize, SafeBrickSize, SafeBrickSize)))
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint4 ActiveBrick = ActiveBricks[ActiveBrickIndex];
	const int3 BrickCoord = clamp(int3(ActiveBrick.xyz), int3(0, 0, 0), BrickGridResolution - 1);
	const int3 CellCoord = BrickCoord * SafeBrickSize + LocalCellCoord;
	OutCellCoord = uint3(CellCoord);
	return all(CellCoord >= int3(0, 0, 0)) && all(CellCoord < GridResolution);
}

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float LoadPressure(int3 Coord)
{
	return PressureIn.Load(int4(ClampSmokeCoord(Coord), 0));
}

float LoadPhi(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return ObstacleTexture.SampleLevel(VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), 0.0);
}

float LoadOpen(int3 Coord)
{
	return TimeThiefSmokeObstacleOpenFromSdf(LoadPhi(Coord), ObstacleSdfSurfaceFeatherCm);
}

float ComputeFaceOpen(float PhiA, float PhiB)
{
	if (PhiA <= 0.0 && PhiB <= 0.0)
	{
		return 0.0;
	}
	if (PhiA > 0.0 && PhiB > 0.0)
	{
		return 1.0;
	}
	return saturate(max(PhiA, PhiB) / max(abs(PhiA) + abs(PhiB), 0.0001));
}

float3 LoadFaceOpen(int3 Coord)
{
	return ObstacleFaceOpenTexture.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

float AccumulateNeighborPressure(int3 Coord, int3 Offset, float Weight, float AxisInvCellSizeSq, inout float Denominator)
{
	if (Weight <= 0.0001)
	{
		return 0.0;
	}

	Denominator += Weight * AxisInvCellSizeSq;
	return LoadPressure(Coord + Offset) * Weight * AxisInvCellSizeSq;
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID)
{
	uint3 CellCoord = uint3(0, 0, 0);
	if (!ResolveSmokeCellCoord(DispatchThreadId, GroupId, GroupThreadId, CellCoord))
	{
		return;
	}

	const int3 Coord = int3(CellCoord);
	if (bUseActiveBrickDispatch == 0u && !IsSparseSimulationCellActive(CellCoord))
	{
		OutPressure[CellCoord] = 0.0;
		return;
	}

	if (LoadOpen(Coord) <= 0.01)
	{
		OutPressure[CellCoord] = 0.0;
		return;
	}

	const float3 InvCellSizeSq = 1.0 / max(CellSize * CellSize, 1.0);
	float FaceX0 = 0.0;
	float FaceY0 = 0.0;
	float FaceZ0 = 0.0;
	float FaceX1 = 0.0;
	float FaceY1 = 0.0;
	float FaceZ1 = 0.0;
	[branch]
	if (bUseFaceOpenStencils != 0u)
	{
		const float3 NegativeFaceOpen = LoadFaceOpen(Coord);
		FaceX0 = Coord.x <= 0 ? 0.0 : NegativeFaceOpen.x;
		FaceY0 = Coord.y <= 0 ? 0.0 : NegativeFaceOpen.y;
		FaceZ0 = Coord.z <= 0 ? 0.0 : NegativeFaceOpen.z;
		FaceX1 = Coord.x >= GridResolution.x - 1 ? 0.0 : LoadFaceOpen(Coord + int3(1, 0, 0)).x;
		FaceY1 = Coord.y >= GridResolution.y - 1 ? 0.0 : LoadFaceOpen(Coord + int3(0, 1, 0)).y;
		FaceZ1 = Coord.z >= GridResolution.z - 1 ? 0.0 : LoadFaceOpen(Coord + int3(0, 0, 1)).z;
	}
	else
	{
		const float CenterPhi = LoadPhi(Coord);
		FaceX0 = Coord.x <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(1, 0, 0)));
		FaceY0 = Coord.y <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(0, 1, 0)));
		FaceZ0 = Coord.z <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(0, 0, 1)));
		FaceX1 = Coord.x >= GridResolution.x - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(1, 0, 0)));
		FaceY1 = Coord.y >= GridResolution.y - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(0, 1, 0)));
		FaceZ1 = Coord.z >= GridResolution.z - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(0, 0, 1)));
	}
	float Denominator = 0.0;
	const float NeighborPressure =
		AccumulateNeighborPressure(Coord, int3(1, 0, 0), FaceX1, InvCellSizeSq.x, Denominator) +
		AccumulateNeighborPressure(Coord, int3(-1, 0, 0), FaceX0, InvCellSizeSq.x, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 1, 0), FaceY1, InvCellSizeSq.y, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, -1, 0), FaceY0, InvCellSizeSq.y, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 0, 1), FaceZ1, InvCellSizeSq.z, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 0, -1), FaceZ0, InvCellSizeSq.z, Denominator);
	Denominator = max(Denominator, 0.000001);
	const float Divergence = DivergenceIn.Load(int4(Coord, 0));

	OutPressure[CellCoord] = (NeighborPressure - Divergence) / Denominator;
}
