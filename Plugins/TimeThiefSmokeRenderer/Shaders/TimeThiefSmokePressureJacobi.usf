#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_PRESSURE_JACOBI_PARAMETERS

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float LoadPressure(int3 Coord)
{
	return PressureIn.Load(int4(ClampSmokeCoord(Coord), 0));
}

float LoadPhi(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return ObstacleTexture.SampleLevel(VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), 0.0);
}

float LoadOpen(int3 Coord)
{
	return TimeThiefSmokeObstacleOpenFromSdf(LoadPhi(Coord), ObstacleSdfSurfaceFeatherCm);
}

float ComputeFaceOpen(float PhiA, float PhiB)
{
	if (PhiA <= 0.0 && PhiB <= 0.0)
	{
		return 0.0;
	}
	if (PhiA > 0.0 && PhiB > 0.0)
	{
		return 1.0;
	}
	return saturate(max(PhiA, PhiB) / max(abs(PhiA) + abs(PhiB), 0.0001));
}

float AccumulateNeighborPressure(int3 Coord, int3 Offset, float Weight, float AxisInvCellSizeSq, inout float Denominator)
{
	if (Weight <= 0.0001)
	{
		return 0.0;
	}

	Denominator += Weight * AxisInvCellSizeSq;
	return LoadPressure(Coord + Offset) * Weight * AxisInvCellSizeSq;
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const int3 Coord = int3(DispatchThreadId);
	if (LoadOpen(Coord) <= 0.01)
	{
		OutPressure[DispatchThreadId] = 0.0;
		return;
	}

	const float3 InvCellSizeSq = 1.0 / max(CellSize * CellSize, 1.0);
	const float CenterPhi = LoadPhi(Coord);
	const float FaceX0 = Coord.x <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(1, 0, 0)));
	const float FaceY0 = Coord.y <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(0, 1, 0)));
	const float FaceZ0 = Coord.z <= 0 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord - int3(0, 0, 1)));
	const float FaceX1 = Coord.x >= GridResolution.x - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(1, 0, 0)));
	const float FaceY1 = Coord.y >= GridResolution.y - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(0, 1, 0)));
	const float FaceZ1 = Coord.z >= GridResolution.z - 1 ? 0.0 : ComputeFaceOpen(CenterPhi, LoadPhi(Coord + int3(0, 0, 1)));
	float Denominator = 0.0;
	const float NeighborPressure =
		AccumulateNeighborPressure(Coord, int3(1, 0, 0), FaceX1, InvCellSizeSq.x, Denominator) +
		AccumulateNeighborPressure(Coord, int3(-1, 0, 0), FaceX0, InvCellSizeSq.x, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 1, 0), FaceY1, InvCellSizeSq.y, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, -1, 0), FaceY0, InvCellSizeSq.y, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 0, 1), FaceZ1, InvCellSizeSq.z, Denominator) +
		AccumulateNeighborPressure(Coord, int3(0, 0, -1), FaceZ0, InvCellSizeSq.z, Denominator);
	Denominator = max(Denominator, 0.000001);
	const float Divergence = DivergenceIn.Load(int4(Coord, 0));

	OutPressure[DispatchThreadId] = (NeighborPressure - Divergence) / Denominator;
}
