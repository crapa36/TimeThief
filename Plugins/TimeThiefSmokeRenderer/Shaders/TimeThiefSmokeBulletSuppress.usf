#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_BULLET_SUPPRESS_PARAMETERS

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const float3 UVW = TimeThiefSmokeVoxelUVW(DispatchThreadId, GridResolution);
	const float3 WorldPosition = TimeThiefSmokeVoxelWorld(DispatchThreadId, GridResolution, BoundsExtent, LocalToWorld);
	float Suppression = SuppressionIn.SampleLevel(VolumeSampler, UVW, 0.0);
	Suppression = max(0.0, Suppression - DeltaSeconds / max(SuppressionLife, 0.05));

	[loop]
	for (int EventIndex = 0; EventIndex < EventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const uint EventType = (uint)round(Event.TypeShapeAgeSeed.x);
		if (EventType != 0)
		{
			continue;
		}

		const float3 EventPosition = Event.PositionRadius.xyz;
		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float3 Direction = normalize(Event.DirectionLength.xyz + 0.0001);
		const float Length = max(Event.DirectionLength.w, Radius * 2.0);
		const float Strength = saturate(Event.ExtentsStrength.w);
		const float Seed = Event.TypeShapeAgeSeed.w;
		const float3 ToCell = WorldPosition - EventPosition;
		const float Along = clamp(dot(ToCell, Direction), -Length * 0.5, Length * 0.5);
		const float3 Closest = EventPosition + Direction * Along;
		const float WakeDistance = length(WorldPosition - Closest);
		const float Core = 1.0 - smoothstep(Radius * 0.28, Radius, WakeDistance);
		const float Breakup = lerp(0.72, 1.18, TimeThiefSmokeValueNoise(WorldPosition * 0.036 + Seed));
		Suppression = max(Suppression, saturate(Core * Breakup * lerp(0.82, 1.0, Strength)));
	}

	OutSuppression[DispatchThreadId] = saturate(Suppression);
}
