#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/ScreenPass.ush"

Texture2D SceneColorTexture;
Texture2D<float> SceneDepthTexture;
Texture2D HalfResSmokeTexture;
SamplerState SceneColorSampler;
float4 SceneColorUVScaleBias;
float4 SceneDepthPixelScaleBias;
int4 ViewRect;
int4 SceneDepthViewRect;
float2 HalfResSize;
float BilateralDepthSensitivity;

float LoadSceneDeviceZ(float2 PixelPosition)
{
	const float2 DepthPixelPosition = PixelPosition * SceneDepthPixelScaleBias.xy + SceneDepthPixelScaleBias.zw;
	const int2 DepthMin = SceneDepthViewRect.xy;
	const int2 DepthMax = max(SceneDepthViewRect.xy, SceneDepthViewRect.zw - 1);
	const int2 DepthPixel = clamp((int2)floor(DepthPixelPosition), DepthMin, DepthMax);
	return SceneDepthTexture.Load(int3(DepthPixel, 0)).r;
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 SceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, SceneUV, 0.0);
	const float2 ScreenUV = (SvPosition.xy - float2(ViewRect.xy)) / max(float2(ViewRect.zw - ViewRect.xy), 1.0);
#if TIME_THIEF_SMOKE_DIRECT_RESOLVE
	const int2 DirectCoord = clamp(int2(floor(ScreenUV * HalfResSize)), int2(0, 0), int2(HalfResSize) - 1);
	float4 ResolvedSmoke = HalfResSmokeTexture.Load(int3(DirectCoord, 0));
#else
	const float2 HalfResTexel = ScreenUV * HalfResSize - 0.5;
	const int2 MaxHalfResCoord = int2(HalfResSize) - 1;
	const int2 Coord00 = clamp(int2(floor(HalfResTexel)), int2(0, 0), MaxHalfResCoord);
	const int2 Coord10 = clamp(Coord00 + int2(1, 0), int2(0, 0), MaxHalfResCoord);
	const int2 Coord01 = clamp(Coord00 + int2(0, 1), int2(0, 0), MaxHalfResCoord);
	const int2 Coord11 = clamp(Coord00 + int2(1, 1), int2(0, 0), MaxHalfResCoord);

	const float2 Frac = frac(HalfResTexel);
	const float W00 = (1.0 - Frac.x) * (1.0 - Frac.y);
	const float W10 = Frac.x * (1.0 - Frac.y);
	const float W01 = (1.0 - Frac.x) * Frac.y;
	const float W11 = Frac.x * Frac.y;

	const float4 Smoke00 = HalfResSmokeTexture.Load(int3(Coord00, 0));
	const float4 Smoke10 = HalfResSmokeTexture.Load(int3(Coord10, 0));
	const float4 Smoke01 = HalfResSmokeTexture.Load(int3(Coord01, 0));
	const float4 Smoke11 = HalfResSmokeTexture.Load(int3(Coord11, 0));
	const float SmokeSignal00 = max(max(max(abs(Smoke00.r), abs(Smoke00.g)), abs(Smoke00.b)), abs(1.0 - Smoke00.a));
	const float SmokeSignal10 = max(max(max(abs(Smoke10.r), abs(Smoke10.g)), abs(Smoke10.b)), abs(1.0 - Smoke10.a));
	const float SmokeSignal01 = max(max(max(abs(Smoke01.r), abs(Smoke01.g)), abs(Smoke01.b)), abs(1.0 - Smoke01.a));
	const float SmokeSignal11 = max(max(max(abs(Smoke11.r), abs(Smoke11.g)), abs(Smoke11.b)), abs(1.0 - Smoke11.a));
	const float MaxSmokeSignal = max(max(SmokeSignal00, SmokeSignal10), max(SmokeSignal01, SmokeSignal11));

	float4 ResolvedSmoke;
	if (MaxSmokeSignal <= 0.000001)
	{
		ResolvedSmoke = float4(0.0, 0.0, 0.0, 1.0);
	}
	else
	{
		const float SceneDeviceZ = LoadSceneDeviceZ(SvPosition.xy);
		const float2 FullResOrigin = float2(ViewRect.xy);
		const float2 Pos00 = FullResOrigin + (float2(Coord00) + 0.5) * 2.0;
		const float2 Pos10 = FullResOrigin + (float2(Coord10) + 0.5) * 2.0;
		const float2 Pos01 = FullResOrigin + (float2(Coord01) + 0.5) * 2.0;
		const float2 Pos11 = FullResOrigin + (float2(Coord11) + 0.5) * 2.0;

		const float Diff00 = SceneDeviceZ - LoadSceneDeviceZ(Pos00);
		const float Diff10 = SceneDeviceZ - LoadSceneDeviceZ(Pos10);
		const float Diff01 = SceneDeviceZ - LoadSceneDeviceZ(Pos01);
		const float Diff11 = SceneDeviceZ - LoadSceneDeviceZ(Pos11);

		float FinalW00 = W00 / (1.0 + Diff00 * Diff00 * BilateralDepthSensitivity);
		float FinalW10 = W10 / (1.0 + Diff10 * Diff10 * BilateralDepthSensitivity);
		float FinalW01 = W01 / (1.0 + Diff01 * Diff01 * BilateralDepthSensitivity);
		float FinalW11 = W11 / (1.0 + Diff11 * Diff11 * BilateralDepthSensitivity);
		const float SumWeight = FinalW00 + FinalW10 + FinalW01 + FinalW11;
		if (SumWeight > 0.00001)
		{
			const float InvSumWeight = rcp(SumWeight);
			FinalW00 *= InvSumWeight;
			FinalW10 *= InvSumWeight;
			FinalW01 *= InvSumWeight;
			FinalW11 *= InvSumWeight;
		}
		else
		{
			FinalW00 = W00;
			FinalW10 = W10;
			FinalW01 = W01;
			FinalW11 = W11;
		}

		const float4 UpsampledSmoke =
			Smoke00 * FinalW00 +
			Smoke10 * FinalW10 +
			Smoke01 * FinalW01 +
			Smoke11 * FinalW11;
		const float4 CenterSmoke = Frac.y < 0.5
			? (Frac.x < 0.5 ? Smoke00 : Smoke10)
			: (Frac.x < 0.5 ? Smoke01 : Smoke11);
		const float DetailStrength = 0.25;
		ResolvedSmoke = UpsampledSmoke + (CenterSmoke - UpsampledSmoke) * DetailStrength;
	}
#endif
	ResolvedSmoke.rgb = max(ResolvedSmoke.rgb, 0.0);
	ResolvedSmoke.a = saturate(ResolvedSmoke.a);
	const float3 Composited = SceneColor.rgb * ResolvedSmoke.a + ResolvedSmoke.rgb;
	OutColor = float4(Composited, SceneColor.a);
}
