#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_PROJECT_VELOCITY_PARAMETERS

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float LoadPressure(int3 Coord)
{
	return PressureIn.Load(int4(ClampSmokeCoord(Coord), 0));
}

float LoadOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), ObstacleSdfSurfaceFeatherCm);
}

float LoadNeighborPressure(int3 Coord, float CenterPressure)
{
	return LoadOpen(Coord) > 0.01 ? LoadPressure(Coord) : CenterPressure;
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const int3 Coord = int3(DispatchThreadId);
	const float3 UVW = TimeThiefSmokeVoxelUVW(DispatchThreadId, GridResolution);
	const float OpenMask = TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, UVW, ObstacleSdfSurfaceFeatherCm);
	if (OpenMask <= 0.01)
	{
		OutVelocity[DispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	float3 Velocity = VelocityIn.Load(int4(Coord, 0)).xyz;
	const float3 InvCellSize = 1.0 / max(CellSize, 1.0);
	const float CenterPressure = LoadPressure(Coord);
	const float3 PressureGradient = float3(
		LoadNeighborPressure(Coord + int3(1, 0, 0), CenterPressure) - LoadNeighborPressure(Coord - int3(1, 0, 0), CenterPressure),
		LoadNeighborPressure(Coord + int3(0, 1, 0), CenterPressure) - LoadNeighborPressure(Coord - int3(0, 1, 0), CenterPressure),
		LoadNeighborPressure(Coord + int3(0, 0, 1), CenterPressure) - LoadNeighborPressure(Coord - int3(0, 0, 1), CenterPressure)) * 0.5 * InvCellSize;

	Velocity -= PressureGradient;

	const bool bBoundary =
		Coord.x <= 0 || Coord.y <= 0 || Coord.z <= 0 ||
		Coord.x >= GridResolution.x - 1 ||
		Coord.y >= GridResolution.y - 1 ||
		Coord.z >= GridResolution.z - 1;
	if (bBoundary)
	{
		Velocity *= 0.25;
	}

	OutVelocity[DispatchThreadId] = float4(Velocity * OpenMask, 0.0);
}
