#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_BUILD_MAC_VELOCITY_PARAMETERS

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float3 LoadVelocity(int3 Coord)
{
	return VelocityIn.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

float LoadOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), ObstacleSdfSurfaceFeatherCm);
}

float3 LoadFaceOpen(int3 Coord)
{
	return ObstacleFaceOpenTexture.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

float3 LoadSolidVelocity(int3 Coord)
{
	return ObstacleVelocityTexture.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const int3 Coord = int3(DispatchThreadId);

	const bool bLeftBoundary = Coord.x <= 0;
	const bool bBackBoundary = Coord.y <= 0;
	const bool bBottomBoundary = Coord.z <= 0;

	const float3 FaceOpen = LoadFaceOpen(Coord);

	const float3 CenterVelocity = LoadVelocity(Coord);
	const float3 LeftVelocity = bLeftBoundary ? float3(0.0, 0.0, 0.0) : LoadVelocity(Coord - int3(1, 0, 0));
	const float3 BackVelocity = bBackBoundary ? float3(0.0, 0.0, 0.0) : LoadVelocity(Coord - int3(0, 1, 0));
	const float3 BottomVelocity = bBottomBoundary ? float3(0.0, 0.0, 0.0) : LoadVelocity(Coord - int3(0, 0, 1));
	const float3 CenterSolidVelocity = LoadSolidVelocity(Coord);
	const float3 LeftSolidVelocity = bLeftBoundary ? CenterSolidVelocity : LoadSolidVelocity(Coord - int3(1, 0, 0));
	const float3 BackSolidVelocity = bBackBoundary ? CenterSolidVelocity : LoadSolidVelocity(Coord - int3(0, 1, 0));
	const float3 BottomSolidVelocity = bBottomBoundary ? CenterSolidVelocity : LoadSolidVelocity(Coord - int3(0, 0, 1));

	OutFaceVelocityU[DispatchThreadId] = bLeftBoundary ? 0.0 : lerp(0.5 * (CenterSolidVelocity.x + LeftSolidVelocity.x), 0.5 * (CenterVelocity.x + LeftVelocity.x), FaceOpen.x);
	OutFaceVelocityV[DispatchThreadId] = bBackBoundary ? 0.0 : lerp(0.5 * (CenterSolidVelocity.y + BackSolidVelocity.y), 0.5 * (CenterVelocity.y + BackVelocity.y), FaceOpen.y);
	OutFaceVelocityW[DispatchThreadId] = bBottomBoundary ? 0.0 : lerp(0.5 * (CenterSolidVelocity.z + BottomSolidVelocity.z), 0.5 * (CenterVelocity.z + BottomVelocity.z), FaceOpen.z);
}
