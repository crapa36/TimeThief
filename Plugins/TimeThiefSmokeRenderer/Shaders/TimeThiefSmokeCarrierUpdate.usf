#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeCommon.ush"

StructuredBuffer<FTimeThiefSmokeCarrierParticleShaderData> CarrierParticlesIn;
StructuredBuffer<FTimeThiefSmokeEventShaderData> Events;
Texture3D<float> ObstacleTexture;
SamplerState VolumeSampler;
RWStructuredBuffer<FTimeThiefSmokeCarrierParticleShaderData> OutCarrierParticles;

float DeltaSeconds;
float DriftSpeed;
float InteractionStrength;
int CarrierParticleCount;
int EventCount;
float3 BoundsExtent;
float ObstacleTexelSize;
float4x4 LocalToWorld;
float4x4 WorldToLocal;

float3 LocalToVolumeUVW(float3 LocalPosition)
{
	return LocalPosition / max(BoundsExtent, 1.0) * 0.5 + 0.5;
}

void ResolveObstacleCollision(inout float3 LocalPosition, inout float3 Velocity, float Radius, float SafeDeltaSeconds)
{
	const float3 UVW = LocalToVolumeUVW(LocalPosition);
	if (!TimeThiefSmokeInsideUVW(UVW))
	{
		return;
	}

	float Obstacle = 0.0;
	float MaxNeighborObstacle = 0.0;
	float3 Gradient = float3(0.0, 0.0, 0.0);
	const float Step = max(ObstacleTexelSize, 1.0 / 128.0);
	TimeThiefSmokeSampleObstacleNeighborhood(
		ObstacleTexture,
		VolumeSampler,
		UVW,
		float3(Step, Step, Step),
		float3(1.0, 1.0, 1.0),
		Obstacle,
		MaxNeighborObstacle,
		Gradient);
	const float CollisionWeight = smoothstep(0.18, 0.72, max(Obstacle, MaxNeighborObstacle * 0.35));
	if (CollisionWeight <= 0.001)
	{
		return;
	}

	const float GradientLengthSq = dot(Gradient, Gradient);
	const float3 ObstacleNormal = GradientLengthSq > 0.000001
		? normalize(Gradient)
		: normalize(-Velocity + float3(0.0, 0.0, 0.15));
	const float3 OpenNormal = -ObstacleNormal;
	const float PushDistance = min(max(Radius * 0.28, 8.0), 38.0) * CollisionWeight;
	LocalPosition += OpenNormal * PushDistance;

	const float IntoObstacle = max(dot(Velocity, ObstacleNormal), 0.0);
	Velocity -= ObstacleNormal * IntoObstacle * 1.35;
	Velocity += OpenNormal * (45.0 + max(DriftSpeed, 0.0) * 0.28) * CollisionWeight * SafeDeltaSeconds;
	Velocity *= lerp(1.0, 0.72, CollisionWeight);
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint ParticleIndex = DispatchThreadId.x;
	if (ParticleIndex >= (uint)CarrierParticleCount)
	{
		return;
	}

	const float SafeDeltaSeconds = min(max(DeltaSeconds, 0.0), 1.0 / 15.0);
	FTimeThiefSmokeCarrierParticleShaderData Particle = CarrierParticlesIn[ParticleIndex];
	float3 LocalPosition = Particle.LocalPositionRadius.xyz;
	float3 Velocity = Particle.VelocityPhase.xyz;
	float Radius = max(Particle.LocalPositionRadius.w, 1.0);
	float Phase = Particle.VelocityPhase.w + SafeDeltaSeconds * 0.9;
	const float3 ParticleBounds = max(BoundsExtent * float3(1.08, 1.08, 1.02), 1.0);

	const float3 Wander = normalize(float3(
		sin(Phase + LocalPosition.y * 0.006),
		cos(Phase * 0.73 + LocalPosition.x * 0.005),
		sin(Phase * 0.41 + LocalPosition.z * 0.004) * 0.38) + 0.0001);
	Velocity += Wander * max(DriftSpeed, 0.0) * SafeDeltaSeconds;
	const float3 ParticleWorldPosition = mul(float4(LocalPosition, 1.0), LocalToWorld).xyz;

	const int SafeEventCount = min(EventCount, 128);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const float3 EventLocalPosition = mul(float4(Event.PositionRadius.xyz, 1.0), WorldToLocal).xyz;
		const float3 EventLocalDirection = normalize(mul(float4(Event.DirectionLength.xyz, 0.0), WorldToLocal).xyz + 0.0001);
		const float3 ToParticle = LocalPosition - EventLocalPosition;
		const float ShapeRadius = max(max(Event.PositionRadius.w, max(max(abs(Event.ExtentsStrength.x), abs(Event.ExtentsStrength.y)), abs(Event.ExtentsStrength.z))), 1.0);
		const float Strength = max(Event.ExtentsStrength.w, 0.0) * max(InteractionStrength, 0.0);
		const float Type = Event.TypeShapeAgeSeed.x;

		if (Type < 0.5)
		{
			const float HalfLength = max(Event.DirectionLength.w * 0.5, 1.0);
			const float3 EntryLocal = EventLocalPosition - EventLocalDirection * HalfLength;
			const float3 ExitLocal = EventLocalPosition + EventLocalDirection * HalfLength;
			const float Along = clamp(dot(ToParticle, EventLocalDirection), -HalfLength, HalfLength);
			const float3 Closest = EventLocalPosition + EventLocalDirection * Along;
			const float3 LineDelta = LocalPosition - Closest;
			const float3 Away = normalize(LineDelta + float3(0.0, 0.0, 0.0001));
			const float Distance = length(LineDelta);
			const float CoreWeight = 1.0 - smoothstep(ShapeRadius, ShapeRadius * 3.0, Distance);

			const float EntryWeight = 1.0 - smoothstep(ShapeRadius * 0.6, ShapeRadius * 2.2, length(LocalPosition - (EntryLocal + EventLocalDirection * ShapeRadius * 0.65)));
			const float3 EntryPull = normalize(EventLocalDirection * 0.82 - Away * 0.42);
			const float3 ToExit = LocalPosition - ExitLocal;
			const float ExitBackAlong = clamp(-dot(ToExit, EventLocalDirection), 0.0, ShapeRadius * 7.0);
			const float3 ExitTrailClosest = ExitLocal - EventLocalDirection * ExitBackAlong;
			const float3 ExitTrailDelta = LocalPosition - ExitTrailClosest;
			const float ExitTrailDistance = length(ExitTrailDelta);
			const float ExitTrailWeight =
				(1.0 - smoothstep(ShapeRadius * 0.7, ShapeRadius * 2.35, ExitTrailDistance)) *
				(1.0 - smoothstep(ShapeRadius * 0.55, ShapeRadius * 7.0, ExitBackAlong));
			const float3 BulletTangent = normalize(cross(EventLocalDirection, ExitTrailDelta + Away * ShapeRadius * 0.08));
			const float Spiral = sin(ExitBackAlong * 0.055 + Event.TypeShapeAgeSeed.w * 0.017);

			Velocity += (EventLocalDirection * 690.0 + Away * 760.0) * CoreWeight * Strength * SafeDeltaSeconds;
			Velocity += EntryPull * EntryWeight * 260.0 * Strength * SafeDeltaSeconds;
			Velocity += (EventLocalDirection * 460.0 + BulletTangent * Spiral * 390.0) * ExitTrailWeight * Strength * SafeDeltaSeconds;
		}
		else if (Type < 1.5)
		{
			const float ShockRadius = max(Event.PositionRadius.w, 1.0);
			const float Distance = length(ToParticle);
			const float Weight = 1.0 - smoothstep(ShockRadius * 0.1, ShockRadius, Distance);
			const float3 Radial = normalize(ToParticle + EventLocalDirection * 0.0001);
			Velocity += Radial * max(Event.ExtentsStrength.x, 1.0) * 0.92 * Weight * Strength * SafeDeltaSeconds;
		}
		else
		{
			const float SpeedScale = saturate(Event.PreviousPositionSpeed.w / 900.0);
			const float ShapeSdf = TimeThiefSmokeActorShapeSdf(Event, ParticleWorldPosition);
			const float PushWeight = 1.0 - smoothstep(ShapeRadius * 0.05, ShapeRadius * 1.25, ShapeSdf);
			const float3 SurfaceNormalWorld = TimeThiefSmokeActorShapeNormal(Event, ParticleWorldPosition, max(ShapeRadius * 0.025, 2.0));
			const float3 SurfaceNormalLocal = normalize(mul(float4(SurfaceNormalWorld, 0.0), WorldToLocal).xyz + 0.0001);
			const float3 Away = normalize(lerp(ToParticle - EventLocalDirection * 0.0001, SurfaceNormalLocal, PushWeight) + 0.0001);
			const float Along = dot(ToParticle, EventLocalDirection);
			const float WakeLength = ShapeRadius * lerp(10.0, 14.0, SpeedScale);
			const float BackAlong = clamp(-Along, 0.0, WakeLength);
			const float3 TrailClosest = EventLocalPosition - EventLocalDirection * BackAlong;
			const float3 TrailDelta = LocalPosition - TrailClosest;
			const float TrailDistance = length(TrailDelta);
			const float TrailTaper = 1.0 - smoothstep(ShapeRadius * 0.35, WakeLength, BackAlong);
			const float TrailWeight =
				(1.0 - smoothstep(ShapeRadius * 0.72, ShapeRadius * 2.35, TrailDistance)) *
				TrailTaper *
				saturate(-Along / max(ShapeRadius, 1.0));
			const float VortexWeight =
				(1.0 - smoothstep(ShapeRadius * 0.95, ShapeRadius * 3.0, TrailDistance)) *
				TrailTaper;
			const float3 TrailTangent = normalize(cross(EventLocalDirection, TrailDelta + Away * ShapeRadius * 0.1));
			const float VortexPair = sin(BackAlong * 0.034 + Event.TypeShapeAgeSeed.w * 0.019) >= 0.0 ? 1.0 : -1.0;
			const float MovingBoost = lerp(0.85, 1.25, SpeedScale);
			Velocity += Away * PushWeight * 105.0 * Strength * MovingBoost * SafeDeltaSeconds;
			Velocity += EventLocalDirection * TrailWeight * 680.0 * Strength * MovingBoost * SafeDeltaSeconds;
			Velocity += TrailTangent * VortexPair * VortexWeight * 310.0 * Strength * MovingBoost * SafeDeltaSeconds;
		}
	}

	[loop]
	for (int OtherIndex = 0; OtherIndex < min(CarrierParticleCount, 128); ++OtherIndex)
	{
		if (OtherIndex == (int)ParticleIndex)
		{
			continue;
		}

		const FTimeThiefSmokeCarrierParticleShaderData Other = CarrierParticlesIn[OtherIndex];
		const float3 Delta = LocalPosition - Other.LocalPositionRadius.xyz;
		const float MinDistance = max(max(Radius, Other.LocalPositionRadius.w) * 0.75, 1.0);
		const float DistanceSq = dot(Delta, Delta);
		if (DistanceSq > 0.000001 && DistanceSq < MinDistance * MinDistance)
		{
			const float Distance = sqrt(DistanceSq);
			const float RepulsionWeight = 1.0 - saturate(Distance / MinDistance);
			Velocity += (Delta / Distance) * RepulsionWeight * 85.0 * SafeDeltaSeconds;
		}
	}

	Velocity *= exp2(-2.668 * SafeDeltaSeconds);
	LocalPosition += Velocity * SafeDeltaSeconds;
	ResolveObstacleCollision(LocalPosition, Velocity, Radius, SafeDeltaSeconds);

	[unroll]
	for (int Axis = 0; Axis < 3; ++Axis)
	{
		const float Limit = max(ParticleBounds[Axis], 1.0);
		if (LocalPosition[Axis] < -Limit)
		{
			LocalPosition[Axis] = -Limit;
			Velocity[Axis] = abs(Velocity[Axis]) * 0.42;
		}
		else if (LocalPosition[Axis] > Limit)
		{
			LocalPosition[Axis] = Limit;
			Velocity[Axis] = -abs(Velocity[Axis]) * 0.42;
		}
	}

	const float3 Ellipsoid = LocalPosition / max(ParticleBounds, 1.0);
	const float EllipsoidLengthSq = dot(Ellipsoid, Ellipsoid);
	if (EllipsoidLengthSq > 1.0)
	{
		const float3 Normal = normalize(Ellipsoid);
		LocalPosition = Normal * ParticleBounds;
		Velocity -= Normal * dot(Velocity, Normal) * 1.35;
	}
	ResolveObstacleCollision(LocalPosition, Velocity, Radius, SafeDeltaSeconds);

	FTimeThiefSmokeCarrierParticleShaderData OutParticle;
	OutParticle.LocalPositionRadius = float4(LocalPosition, Radius);
	OutParticle.VelocityPhase = float4(Velocity, Phase);
	OutCarrierParticles[ParticleIndex] = OutParticle;
}
