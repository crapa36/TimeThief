#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_CARRIER_UPDATE_PARAMETERS

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint ParticleIndex = DispatchThreadId.x;
	if (ParticleIndex >= (uint)CarrierParticleCount)
	{
		return;
	}

	const float SafeDeltaSeconds = min(max(DeltaSeconds, 0.0), 1.0 / 15.0);
	const float SafeSelfWobbleTimeScale = max(SelfWobbleTimeScale, 0.0);
	const float SafeSelfWobbleVelocityScale = max(SelfWobbleVelocityScale, 0.0);
	FTimeThiefSmokeCarrierParticleShaderData Particle = CarrierParticlesIn[ParticleIndex];
	float3 LocalPosition = Particle.LocalPositionRadius.xyz;
	float3 Velocity = Particle.VelocityPhase.xyz;
	float Radius = max(Particle.LocalPositionRadius.w, 1.0);
	float Phase = Particle.VelocityPhase.w + SafeDeltaSeconds * 0.9 * SafeSelfWobbleTimeScale;
	const float3 ParticleBounds = max(NaturalBoundsExtent * float3(0.84, 0.84, 0.82), 1.0);

	const float3 Wander = normalize(float3(
		sin(Phase + LocalPosition.y * 0.006),
		cos(Phase * 0.73 + LocalPosition.x * 0.005),
		sin(Phase * 0.41 + LocalPosition.z * 0.004) * 0.38) + 0.0001);
	Velocity += Wander * max(DriftSpeed, 0.0) * SafeDeltaSeconds * SafeSelfWobbleVelocityScale;

	const int SafeEventCount = min(EventCount, 128);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const float3 EventLocalPosition = mul(float4(Event.PositionRadius.xyz, 1.0), WorldToLocal).xyz;
		const float3 EventLocalDirection = normalize(mul(float4(Event.DirectionLength.xyz, 0.0), WorldToLocal).xyz + 0.0001);
		const float3 ToParticle = LocalPosition - EventLocalPosition;
		const float ShapeRadius = max(max(Event.PositionRadius.w, max(max(abs(Event.ExtentsStrength.x), abs(Event.ExtentsStrength.y)), abs(Event.ExtentsStrength.z))), 1.0);
		const float Strength = max(Event.ExtentsStrength.w, 0.0) * max(InteractionStrength, 0.0);
		const float Type = Event.TypeShapeAgeSeed.x;

		if (Type < 0.5)
		{
			const float HalfLength = max(Event.DirectionLength.w * 0.5, 1.0);
			const float Along = clamp(dot(ToParticle, EventLocalDirection), -HalfLength, HalfLength);
			const float3 Closest = EventLocalPosition + EventLocalDirection * Along;
			const float3 Away = normalize(LocalPosition - Closest + float3(0.0, 0.0, 0.0001));
			const float Distance = length(LocalPosition - Closest);
			const float Weight = 1.0 - smoothstep(ShapeRadius, ShapeRadius * 3.0, Distance);
			Velocity += (EventLocalDirection * 780.0 + Away * 920.0) * Weight * Strength * SafeDeltaSeconds;
		}
		else if (Type < 1.5)
		{
			const float ShockRadius = max(Event.PositionRadius.w, 1.0);
			const float Distance = length(ToParticle);
			const float Weight = 1.0 - smoothstep(ShockRadius * 0.1, ShockRadius, Distance);
			const float3 Radial = normalize(ToParticle + EventLocalDirection * 0.0001);
			Velocity += Radial * max(Event.ExtentsStrength.x, 1.0) * 0.92 * Weight * Strength * SafeDeltaSeconds;
		}
		else
		{
			const float Distance = length(ToParticle);
			const float PushWeight = 1.0 - smoothstep(ShapeRadius * 0.45, ShapeRadius * 1.65, Distance);
			const float3 Away = normalize(ToParticle - EventLocalDirection * 0.0001);
			const float Along = dot(ToParticle, EventLocalDirection);
			const float BackAlong = clamp(-Along, 0.0, ShapeRadius * 5.0);
			const float3 TrailClosest = EventLocalPosition - EventLocalDirection * BackAlong;
			const float TrailDistance = length(LocalPosition - TrailClosest);
			const float TrailWeight =
				(1.0 - smoothstep(ShapeRadius * 0.8, ShapeRadius * 2.0, TrailDistance)) *
				(1.0 - smoothstep(ShapeRadius * 0.35, ShapeRadius * 5.0, BackAlong));
			Velocity += Away * PushWeight * 150.0 * Strength * SafeDeltaSeconds;
			Velocity += EventLocalDirection * TrailWeight * 520.0 * Strength * SafeDeltaSeconds;
		}
	}

	[loop]
	for (int OtherIndex = 0; OtherIndex < min(CarrierParticleCount, 128); ++OtherIndex)
	{
		if (OtherIndex == (int)ParticleIndex)
		{
			continue;
		}

		const FTimeThiefSmokeCarrierParticleShaderData Other = CarrierParticlesIn[OtherIndex];
		const float3 Delta = LocalPosition - Other.LocalPositionRadius.xyz;
		const float MinDistance = max(max(Radius, Other.LocalPositionRadius.w) * 0.75, 1.0);
		const float DistanceSq = dot(Delta, Delta);
		if (DistanceSq > 0.000001 && DistanceSq < MinDistance * MinDistance)
		{
			const float Distance = sqrt(DistanceSq);
			const float RepulsionWeight = 1.0 - saturate(Distance / MinDistance);
			Velocity += (Delta / Distance) * RepulsionWeight * 85.0 * SafeDeltaSeconds;
		}
	}

	Velocity *= exp2(-2.668 * SafeDeltaSeconds);
	LocalPosition += Velocity * SafeDeltaSeconds;

	[unroll]
	for (int Axis = 0; Axis < 3; ++Axis)
	{
		const float Limit = max(ParticleBounds[Axis], 1.0);
		if (LocalPosition[Axis] < -Limit)
		{
			LocalPosition[Axis] = -Limit;
			Velocity[Axis] = abs(Velocity[Axis]) * 0.42;
		}
		else if (LocalPosition[Axis] > Limit)
		{
			LocalPosition[Axis] = Limit;
			Velocity[Axis] = -abs(Velocity[Axis]) * 0.42;
		}
	}

	const float3 Ellipsoid = LocalPosition / max(ParticleBounds, 1.0);
	const float EllipsoidLengthSq = dot(Ellipsoid, Ellipsoid);
	if (EllipsoidLengthSq > 1.0)
	{
		const float3 Normal = normalize(Ellipsoid);
		LocalPosition = Normal * ParticleBounds;
		Velocity -= Normal * dot(Velocity, Normal) * 1.35;
	}

	FTimeThiefSmokeCarrierParticleShaderData OutParticle;
	OutParticle.LocalPositionRadius = float4(LocalPosition, Radius);
	OutParticle.VelocityPhase = float4(Velocity, Phase);
	OutCarrierParticles[ParticleIndex] = OutParticle;
}
