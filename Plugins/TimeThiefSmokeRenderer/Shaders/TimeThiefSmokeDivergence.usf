#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_DIVERGENCE_PARAMETERS

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float3 LoadVelocity(int3 Coord)
{
	return VelocityIn.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

float LoadOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), ObstacleSdfSurfaceFeatherCm);
}

float3 LoadOpenVelocity(int3 Coord)
{
	return LoadOpen(Coord) > 0.01 ? LoadVelocity(Coord) : float3(0.0, 0.0, 0.0);
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const int3 Coord = int3(DispatchThreadId);
	const float3 UVW = TimeThiefSmokeVoxelUVW(DispatchThreadId, GridResolution);
	if (TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, UVW, ObstacleSdfSurfaceFeatherCm) <= 0.01)
	{
		OutDivergence[DispatchThreadId] = 0.0;
		OutPressure[DispatchThreadId] = 0.0;
		return;
	}

	const float3 InvCellSize = 1.0 / max(CellSize, 1.0);
	const float3 VelX0 = LoadOpenVelocity(Coord - int3(1, 0, 0));
	const float3 VelX1 = LoadOpenVelocity(Coord + int3(1, 0, 0));
	const float3 VelY0 = LoadOpenVelocity(Coord - int3(0, 1, 0));
	const float3 VelY1 = LoadOpenVelocity(Coord + int3(0, 1, 0));
	const float3 VelZ0 = LoadOpenVelocity(Coord - int3(0, 0, 1));
	const float3 VelZ1 = LoadOpenVelocity(Coord + int3(0, 0, 1));

	const float Divergence =
		(VelX1.x - VelX0.x) * 0.5 * InvCellSize.x +
		(VelY1.y - VelY0.y) * 0.5 * InvCellSize.y +
		(VelZ1.z - VelZ0.z) * 0.5 * InvCellSize.z;

	OutDivergence[DispatchThreadId] = Divergence;
	OutPressure[DispatchThreadId] = 0.0;
}
