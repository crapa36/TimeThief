#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_SIMULATE_PARAMETERS

bool IsSparseSimulationCellActive(uint3 CellCoord)
{
	if (bUseSparseSimulationMask == 0u)
	{
		return true;
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return BrickOccupancyTexture.Load(int4(BrickCoord, 0)) != 0u;
}

uint FlattenBrickCoordForEventBins(int3 BrickCoord)
{
	const int3 SafeCoord = clamp(BrickCoord, int3(0, 0, 0), BrickGridResolution - 1);
	return (uint)(SafeCoord.x + SafeCoord.y * BrickGridResolution.x + SafeCoord.z * BrickGridResolution.x * BrickGridResolution.y);
}

uint4 GetEventBrickMask(uint3 CellCoord)
{
	if (bUseEventBrickBins == 0u)
	{
		return uint4(0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu);
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return EventBrickMasks[FlattenBrickCoordForEventBins(BrickCoord)];
}

bool IsEventEnabledByBrickMask(uint4 Mask, int EventIndex)
{
	const uint WordIndex = (uint)EventIndex >> 5u;
	const uint Bit = 1u << ((uint)EventIndex & 31u);
	const uint Word = WordIndex == 0u ? Mask.x : (WordIndex == 1u ? Mask.y : (WordIndex == 2u ? Mask.z : Mask.w));
	return (Word & Bit) != 0u;
}

void ComputeAdvectionLimiterBounds(float3 UVW, out float DensityMin, out float DensityMax, out float3 VelocityMin, out float3 VelocityMax)
{
	const float3 Texel = 1.0 / max(float3(GridResolution), 1.0);
	DensityMin = 999999.0;
	DensityMax = -999999.0;
	VelocityMin = float3(999999.0, 999999.0, 999999.0);
	VelocityMax = float3(-999999.0, -999999.0, -999999.0);

	[unroll]
	for (int Z = -1; Z <= 1; ++Z)
	{
		[unroll]
		for (int Y = -1; Y <= 1; ++Y)
		{
			[unroll]
			for (int X = -1; X <= 1; ++X)
			{
				const float3 SampleUVW = saturate(UVW + float3(X, Y, Z) * Texel);
				const float SampleDensity = DensityIn.SampleLevel(VolumeSampler, SampleUVW, 0.0);
				const float3 SampleVelocity = VelocityIn.SampleLevel(VolumeSampler, SampleUVW, 0.0).xyz;
				DensityMin = min(DensityMin, SampleDensity);
				DensityMax = max(DensityMax, SampleDensity);
				VelocityMin = min(VelocityMin, SampleVelocity);
				VelocityMax = max(VelocityMax, SampleVelocity);
			}
		}
	}
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	if (!IsSparseSimulationCellActive(DispatchThreadId))
	{
		const float FadeOutAlpha = saturate(max(AgeSeconds - DurationSeconds, 0.0) / max(SmokeFadeOutDuration, 0.001));
		const float EffectiveDissipation = DensityDissipation + FadeOutAlpha * (1.0 + DensityDissipation);
		const float DensityDecay = exp2(-max(EffectiveDissipation, 0.0) * DeltaSeconds);
		const float VelocityDecay = exp2(-max(VelocityDamping, 0.0) * DeltaSeconds);
		const int3 Coord = int3(DispatchThreadId);
		const float Cutout = BulletCutoutTexture.Load(int4(Coord, 0));
		const float Sink = BulletSinkTexture.Load(int4(Coord, 0));
		OutDensity[DispatchThreadId] = max(DensityIn.Load(int4(Coord, 0)) * DensityDecay, 0.0);
		OutVelocity[DispatchThreadId] = float4(VelocityIn.Load(int4(Coord, 0)).xyz * VelocityDecay, 0.0);
		OutCutout[DispatchThreadId] = Cutout > 1.0
			? max(1.0, Cutout - DeltaSeconds / max(BulletWakeCutoutLife, 0.001))
			: max(0.0, Cutout - DeltaSeconds / max(BulletWakeReleaseDuration, 0.001));
		OutSink[DispatchThreadId] = max(Sink * exp2(-DeltaSeconds / max(BulletWakeSinkLife, 0.001)), 0.0);
		return;
	}

	const float3 UVW = TimeThiefSmokeVoxelUVW(DispatchThreadId, GridResolution);
	const float OpenMask = TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, UVW);
	const float3 WorldPosition = TimeThiefSmokeVoxelWorld(DispatchThreadId, GridResolution, BoundsExtent, LocalToWorld);
	const float3 LocalPosition = TimeThiefSmokeVoxelLocal(DispatchThreadId, GridResolution, BoundsExtent);
	const float3 SmokeOrigin = mul(float4(0.0, 0.0, 0.0, 1.0), LocalToWorld).xyz;
	const float3 SmokeUp = normalize(mul(float4(0.0, 0.0, 1.0, 0.0), LocalToWorld).xyz + 0.0001);
	const float3 Velocity = VelocityIn.SampleLevel(VolumeSampler, UVW, 0.0).xyz;
	const float3 PreviousWorld = WorldPosition - Velocity * DeltaSeconds;
	const float3 PreviousLocal = mul(float4(PreviousWorld, 1.0), WorldToLocal).xyz;
	const float3 PreviousUVW = PreviousLocal / max(BoundsExtent, 1.0) * 0.5 + 0.5;
	float BulletCutout = max(BulletCutoutTexture.SampleLevel(VolumeSampler, UVW, 0.0), 0.0);
	float BulletSink = TimeThiefSmokeInsideUVW(PreviousUVW) ? max(BulletSinkTexture.SampleLevel(VolumeSampler, PreviousUVW, 0.0), 0.0) : 0.0;
	BulletCutout = BulletCutout > 1.0
		? max(1.0, BulletCutout - DeltaSeconds / max(BulletWakeCutoutLife, 0.001))
		: max(0.0, BulletCutout - DeltaSeconds / max(BulletWakeReleaseDuration, 0.001));
	BulletSink *= exp2(-DeltaSeconds / max(BulletWakeSinkLife, 0.001));

	float3 BulletImpulse = float3(0.0, 0.0, 0.0);
	const int SafeEventCount = min(EventCount, 128);
	const uint4 EventBrickMask = GetEventBrickMask(DispatchThreadId);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		if (!IsEventEnabledByBrickMask(EventBrickMask, EventIndex))
		{
			continue;
		}

		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		if ((uint)round(Event.TypeShapeAgeSeed.x) != 0u)
		{
			continue;
		}

		const float3 EventPosition = Event.PositionRadius.xyz;
		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float3 Direction = normalize(Event.DirectionLength.xyz + 0.0001);
		const float Length = max(Event.DirectionLength.w, Radius * 2.0);
		const float Strength = saturate(Event.ExtentsStrength.w);
		const float Age = saturate(Event.TypeShapeAgeSeed.z);
		const float Seed = Event.TypeShapeAgeSeed.w;
		const float3 ToCell = WorldPosition - EventPosition;
		const float AlongRaw = dot(ToCell, Direction);
		const float FeatherScale = max(BulletWakeCutoutFeather, 0.2);
		if (abs(AlongRaw) > Length * 0.5 + Radius * 2.0 * FeatherScale)
		{
			continue;
		}

		const float Along = clamp(AlongRaw, -Length * 0.5, Length * 0.5);
		const float3 Closest = EventPosition + Direction * Along;
		const float3 WakeDelta = WorldPosition - Closest;
		const float MaxWakeDistance = Radius * 2.0 * FeatherScale * 1.2;
		const float WakeDistanceSq = dot(WakeDelta, WakeDelta);
		if (WakeDistanceSq > MaxWakeDistance * MaxWakeDistance)
		{
			continue;
		}

		const float WakeDistance = sqrt(WakeDistanceSq);
		const float Axial = 1.0 - smoothstep(Length * 0.47, Length * 0.5 + Radius, abs(AlongRaw));
		const float Breakup = lerp(0.82, 1.18, TimeThiefSmokeRidgedFBM(WorldPosition * 0.022 + Seed * 0.013));
		const float HoldCore = 1.0 - smoothstep(Radius * 0.28, Radius * 1.05 * Breakup, WakeDistance);
		const float Core = 1.0 - smoothstep(Radius * 0.45, Radius * FeatherScale * Breakup, WakeDistance);
		const float Feather = 1.0 - smoothstep(Radius * 0.55, Radius * 2.0 * FeatherScale * Breakup, WakeDistance);
		const float AgeFade = 1.0 - smoothstep(0.15, 1.0, Age);
		const float HoldWeight = saturate(HoldCore * Axial * Strength * AgeFade);
		const float CutoutWeight = max(saturate(Core * Axial * Strength * AgeFade), HoldWeight > 0.001 ? 2.0 : 0.0);
		const float SinkWeight = saturate(Feather * Axial * Strength * AgeFade * max(BulletWakeSinkStrength, 0.0));

		BulletCutout = max(BulletCutout, CutoutWeight);
		BulletSink = max(BulletSink, SinkWeight);
		BulletImpulse += Direction * SinkWeight * BulletWakeImpulseStrength;
	}
	BulletCutout = clamp(BulletCutout, 0.0, 2.0);
	BulletSink = saturate(BulletSink);
	const FTimeThiefSmokeBulletOpenMasks BulletMasks = TimeThiefSmokeBulletOpenMasksFromValues(BulletCutout, BulletSink);
	const bool bBulletInfluence = BulletCutout > 0.001 || BulletSink > 0.001 || dot(BulletImpulse, BulletImpulse) > 0.001;

	float Density = 0.0;
	float3 AdvectedVelocity = float3(0.0, 0.0, 0.0);
	const float PreviousOpenMask = TimeThiefSmokeInsideUVW(PreviousUVW)
		? TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, PreviousUVW)
		: 0.0;
	if (PreviousOpenMask > 0.01)
	{
		Density = DensityIn.SampleLevel(VolumeSampler, PreviousUVW, 0.0);
		AdvectedVelocity = VelocityIn.SampleLevel(VolumeSampler, PreviousUVW, 0.0).xyz;
	}

	const float CurrentDensity = DensityIn.SampleLevel(VolumeSampler, UVW, 0.0);
	const float SourceInfluenceRadius = max(PlumeSourceRadius * 1.1, 1.0);
	const bool bSourceInfluence = AgeSeconds < max(PlumeEmissionDuration + 0.25, 0.01) && dot(WorldPosition - SmokeOrigin, WorldPosition - SmokeOrigin) < SourceInfluenceRadius * SourceInfluenceRadius;
	const bool bUseLimiterForCell = bUseAdaptiveMacCormack == 0 ||
		CurrentDensity > 0.001 ||
		Density > 0.001 ||
		dot(Velocity, Velocity) > 1.0 ||
		bBulletInfluence ||
		bSourceInfluence;
	if (bUseMacCormackAdvection != 0 && bUseLimiterForCell && PreviousOpenMask > 0.01)
	{
		const float3 ForwardWorld = PreviousWorld + AdvectedVelocity * DeltaSeconds;
		const float3 ForwardLocal = mul(float4(ForwardWorld, 1.0), WorldToLocal).xyz;
		const float3 ForwardUVW = ForwardLocal / max(BoundsExtent, 1.0) * 0.5 + 0.5;
		if (TimeThiefSmokeInsideUVW(ForwardUVW) && TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, ForwardUVW) > 0.01)
		{
			const float BackDensity = DensityIn.SampleLevel(VolumeSampler, ForwardUVW, 0.0);
			const float CorrectedDensity = Density + 0.5 * (CurrentDensity - BackDensity);
			const float3 CorrectedVelocity = AdvectedVelocity + 0.5 * (Velocity - VelocityIn.SampleLevel(VolumeSampler, ForwardUVW, 0.0).xyz);
			float DensityMin = 0.0;
			float DensityMax = 0.0;
			float3 VelocityMin = float3(0.0, 0.0, 0.0);
			float3 VelocityMax = float3(0.0, 0.0, 0.0);
			ComputeAdvectionLimiterBounds(PreviousUVW, DensityMin, DensityMax, VelocityMin, VelocityMax);
			Density = clamp(CorrectedDensity, max(DensityMin, 0.0), min(DensityMax, 3.2));
			AdvectedVelocity = clamp(CorrectedVelocity, VelocityMin, VelocityMax);
		}
	}

	float NeighborDensity = 0.0;
	if (BulletMasks.Sink > 0.001)
	{
		const float3 Texel = 1.0 / max(float3(GridResolution), 1.0);
		NeighborDensity =
			(DensityIn.SampleLevel(VolumeSampler, saturate(UVW + float3(Texel.x, 0.0, 0.0)), 0.0) +
			DensityIn.SampleLevel(VolumeSampler, saturate(UVW - float3(Texel.x, 0.0, 0.0)), 0.0) +
			DensityIn.SampleLevel(VolumeSampler, saturate(UVW + float3(0.0, Texel.y, 0.0)), 0.0) +
			DensityIn.SampleLevel(VolumeSampler, saturate(UVW - float3(0.0, Texel.y, 0.0)), 0.0) +
			DensityIn.SampleLevel(VolumeSampler, saturate(UVW + float3(0.0, 0.0, Texel.z)), 0.0) +
			DensityIn.SampleLevel(VolumeSampler, saturate(UVW - float3(0.0, 0.0, Texel.z)), 0.0)) / 6.0;
	}

	const float FadeOutAlpha = saturate(max(AgeSeconds - DurationSeconds, 0.0) / max(SmokeFadeOutDuration, 0.001));
	const float EffectiveDissipation = DensityDissipation + FadeOutAlpha * (1.0 + DensityDissipation);
	Density *= exp2(-max(EffectiveDissipation, 0.0) * DeltaSeconds);
	const float ReentryDensity = NeighborDensity * BulletMasks.Sink;
	Density = lerp(Density, max(Density, ReentryDensity * 0.97), saturate(DeltaSeconds * 1.35));
	Density = lerp(Density, ReentryDensity, saturate(DeltaSeconds * 0.025));

	const float SafeEmissionDuration = min(max(DurationSeconds, 0.01), max(PlumeEmissionDuration, 0.01));
	const float EmissionRamp = saturate((AgeSeconds + DeltaSeconds) / 0.35);
	const float EmissionFade = 1.0 - smoothstep(SafeEmissionDuration, SafeEmissionDuration + 0.25, AgeSeconds);
	const float Emission = EmissionRamp * EmissionFade;
	const float SourceDistance = length(WorldPosition - SmokeOrigin);
	const float SafeSourceRadius = max(PlumeSourceRadius, 1.0);
	float SourceWeight = 1.0 - smoothstep(SafeSourceRadius * 0.96, SafeSourceRadius * 1.04, SourceDistance);
	const float SourceNoise = lerp(0.86, 1.14, TimeThiefSmokeHash13(WorldPosition * 0.021));
	SourceWeight = saturate(SourceWeight * SourceNoise) * OpenMask;

	const float BoundaryNoise = (TimeThiefSmokeHash13(WorldPosition * 0.007) - 0.5) * 0.04;
	const float3 SimulationLocalForBoundary = LocalPosition / max(BoundsExtent, 1.0);
	const float BoundaryDamping = TimeThiefSmokeRenderBoundaryMask(SimulationLocalForBoundary, BoundsExtent, NaturalBoundsExtent, BoundaryNoise);
	Density += SourceWeight * Emission * InitialDensity * DeltaSeconds * 1.95 * BulletMasks.Source;
	const float CloudBillow = 0.5 + 0.5 * sin(
		dot(WorldPosition, float3(0.021, 0.017, 0.013)) +
		sin(dot(WorldPosition, float3(0.011, 0.026, 0.019))) * 1.7);
	const float ChunkNoise = TimeThiefSmokeValueNoise(WorldPosition * 0.018);
	const float CloudCohesion = lerp(0.72, 1.38, saturate(CloudBillow * 0.58 + ChunkNoise * 0.42));
	Density *= lerp(1.0, CloudCohesion, saturate(Density * 0.58));
	Density *= BulletMasks.Hard;
	Density *= BoundaryDamping;

	const float NoiseA = TimeThiefSmokeHash13(WorldPosition * 0.006 + DeltaSeconds);
	const float NoiseB = TimeThiefSmokeHash13(WorldPosition * 0.009 + 17.0);
	const float SafeSelfWobbleTimeScale = max(SelfWobbleTimeScale, 0.0);
	const float SafeSelfWobbleVelocityScale = max(SelfWobbleVelocityScale, 0.0);
	const float3 CurlNoise = TimeThiefSmokeCurlNoise(WorldPosition * 0.012, AgeSeconds * 0.16 * SafeSelfWobbleTimeScale);
	const float3 Swirl = CurlNoise * VorticityStrength * Density * 18.0 * SafeSelfWobbleVelocityScale;
	const float Damping = exp2(-max(VelocityDamping, 0.0) * DeltaSeconds);
	AdvectedVelocity = AdvectedVelocity * Damping + Swirl + BulletImpulse * BulletMasks.Detail;
	const float3 SourceRadial = normalize(WorldPosition - SmokeOrigin + SmokeUp * 18.0);
	const float3 SourceVelocity = SourceRadial * PlumeExpansionVelocity + SmokeUp * PlumeRiseVelocity;
	AdvectedVelocity += SourceVelocity * SourceWeight * Emission * DeltaSeconds * 2.0;
	AdvectedVelocity += (NoiseA - NoiseB) * CurlNoise * VorticityStrength * Density * 4.0 * SafeSelfWobbleVelocityScale;
	AdvectedVelocity *= lerp(0.35, 1.0, BoundaryDamping);

	OutDensity[DispatchThreadId] = clamp(Density * OpenMask, 0.0, 2.8);
	OutVelocity[DispatchThreadId] = float4(AdvectedVelocity * OpenMask, 0.0);
	OutCutout[DispatchThreadId] = BulletCutout;
	OutSink[DispatchThreadId] = BulletSink;
}
