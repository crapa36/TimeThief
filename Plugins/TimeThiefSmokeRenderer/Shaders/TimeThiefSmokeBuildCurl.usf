#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_BUILD_CURL_PARAMETERS

bool IsSparseSimulationCellActive(uint3 CellCoord)
{
	if (bUseSparseSimulationMask == 0u)
	{
		return true;
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return BrickOccupancyTexture.Load(int4(BrickCoord, 0)) != 0u;
}

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float LoadOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), ObstacleSdfSurfaceFeatherCm);
}

float3 LoadOpenVelocity(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return LoadOpen(SafeCoord) > 0.01 ? VelocityIn.Load(int4(SafeCoord, 0)).xyz : float3(0.0, 0.0, 0.0);
}

bool IsNeighborOpen(uint NeighborMask, uint BitIndex)
{
	return (NeighborMask & (1u << BitIndex)) != 0u;
}

float3 LoadMaskedVelocity(int3 Coord, bool bOpen)
{
	return bOpen ? VelocityIn.Load(int4(ClampSmokeCoord(Coord), 0)).xyz : float3(0.0, 0.0, 0.0);
}

float3 ComputeCurl(int3 Coord)
{
	const float3 InvCellSize = 1.0 / max(CellSize, 1.0);
	float3 VX0;
	float3 VX1;
	float3 VY0;
	float3 VY1;
	float3 VZ0;
	float3 VZ1;
	if (bUseFaceOpenStencils != 0u)
	{
		const uint NeighborMask = ObstacleNeighborMaskTexture.Load(int4(ClampSmokeCoord(Coord), 0));
		VX0 = LoadMaskedVelocity(Coord - int3(1, 0, 0), IsNeighborOpen(NeighborMask, 0u));
		VX1 = LoadMaskedVelocity(Coord + int3(1, 0, 0), IsNeighborOpen(NeighborMask, 1u));
		VY0 = LoadMaskedVelocity(Coord - int3(0, 1, 0), IsNeighborOpen(NeighborMask, 2u));
		VY1 = LoadMaskedVelocity(Coord + int3(0, 1, 0), IsNeighborOpen(NeighborMask, 3u));
		VZ0 = LoadMaskedVelocity(Coord - int3(0, 0, 1), IsNeighborOpen(NeighborMask, 4u));
		VZ1 = LoadMaskedVelocity(Coord + int3(0, 0, 1), IsNeighborOpen(NeighborMask, 5u));
	}
	else
	{
		VX0 = LoadOpenVelocity(Coord - int3(1, 0, 0));
		VX1 = LoadOpenVelocity(Coord + int3(1, 0, 0));
		VY0 = LoadOpenVelocity(Coord - int3(0, 1, 0));
		VY1 = LoadOpenVelocity(Coord + int3(0, 1, 0));
		VZ0 = LoadOpenVelocity(Coord - int3(0, 0, 1));
		VZ1 = LoadOpenVelocity(Coord + int3(0, 0, 1));
	}
	const float3 DVX = (VX1 - VX0) * 0.5 * InvCellSize.x;
	const float3 DVY = (VY1 - VY0) * 0.5 * InvCellSize.y;
	const float3 DVZ = (VZ1 - VZ0) * 0.5 * InvCellSize.z;
	return float3(DVY.z - DVZ.y, DVZ.x - DVX.z, DVX.y - DVY.x);
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	if (!IsSparseSimulationCellActive(DispatchThreadId))
	{
		OutCurl[DispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	const int3 Coord = int3(DispatchThreadId);
	const float3 Curl = ComputeCurl(Coord);
	OutCurl[DispatchThreadId] = float4(Curl, length(Curl));
}
