#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_BUILD_CARRIER_FIELD_PARAMETERS

float2 ComputeCarrierFieldValue(float3 LocalPosition)
{
	float VoidWeight = 0.0;
	float ShellWeight = 0.0;
	const int SafeParticleCount = min(CarrierParticleCount, 128);

	[loop]
	for (int ParticleIndex = 0; ParticleIndex < SafeParticleCount; ++ParticleIndex)
	{
		const FTimeThiefSmokeCarrierParticleShaderData Particle = CarrierParticles[ParticleIndex];
		const float3 ParticlePosition = Particle.LocalPositionRadius.xyz;
		const float Radius = max(Particle.LocalPositionRadius.w, 1.0);
		const float3 Delta = LocalPosition - ParticlePosition;
		const float MaxInfluenceRadius = Radius * 1.7;
		if (dot(Delta, Delta) > MaxInfluenceRadius * MaxInfluenceRadius)
		{
			continue;
		}

		const float SpeedStretch = saturate(length(Particle.VelocityPhase.xyz) / 280.0);
		const float Distance = length(Delta);
		const float Void = 1.0 - smoothstep(Radius * 0.18, Radius * lerp(0.68, 0.92, SpeedStretch), Distance);
		const float ShellDistance = abs(Distance - Radius * lerp(0.82, 1.12, SpeedStretch));
		const float Shell = 1.0 - smoothstep(Radius * 0.18, Radius * 0.58, ShellDistance);
		VoidWeight = max(VoidWeight, Void);
		ShellWeight = max(ShellWeight, Shell);
	}

	return float2(saturate(VoidWeight), saturate(ShellWeight * (1.0 - VoidWeight * 0.72)));
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= CarrierFieldResolution))
	{
		return;
	}

	const float3 UVW = (float3(DispatchThreadId) + 0.5) / max(float3(CarrierFieldResolution), 1.0);
	const float3 LocalPosition = (UVW * 2.0 - 1.0) * BoundsExtent;
	OutCarrierField[DispatchThreadId] = ComputeCarrierFieldValue(LocalPosition);
}
