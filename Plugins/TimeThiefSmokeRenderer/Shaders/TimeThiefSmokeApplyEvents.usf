#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_APPLY_EVENTS_PARAMETERS

bool IsSparseSimulationCellActive(uint3 CellCoord)
{
	if (bUseSparseSimulationMask == 0u)
	{
		return true;
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return BrickOccupancyTexture.Load(int4(BrickCoord, 0)) != 0u;
}

bool ResolveSmokeCellCoord(uint3 DispatchThreadId, uint3 GroupId, uint3 GroupThreadId, out uint3 OutCellCoord)
{
	if (bUseActiveBrickDispatch == 0u)
	{
		OutCellCoord = DispatchThreadId;
		return all(OutCellCoord < uint3(GridResolution));
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const uint ActiveBrickCount = min(ActiveBrickCountBuffer[0], (uint)max(MaxActiveSmokeBricks, 1));
	const uint GroupsPerBrickAxis = (uint)((SafeBrickSize + 3) / 4);
	const uint GroupsPerBrick = max(GroupsPerBrickAxis * GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const uint LocalGroupIndex = GroupId.x;
	const uint ActiveBrickIndex = GroupId.y;
	if (ActiveBrickIndex >= ActiveBrickCount || LocalGroupIndex >= GroupsPerBrick)
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint LocalGroupX = LocalGroupIndex % GroupsPerBrickAxis;
	const uint LocalGroupY = (LocalGroupIndex / max(GroupsPerBrickAxis, 1u)) % GroupsPerBrickAxis;
	const uint LocalGroupZ = LocalGroupIndex / max(GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const int3 LocalCellCoord = int3(LocalGroupX, LocalGroupY, LocalGroupZ) * 4 + int3(GroupThreadId);
	if (any(LocalCellCoord >= int3(SafeBrickSize, SafeBrickSize, SafeBrickSize)))
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint4 ActiveBrick = ActiveBricks[ActiveBrickIndex];
	const int3 BrickCoord = clamp(int3(ActiveBrick.xyz), int3(0, 0, 0), BrickGridResolution - 1);
	const int3 CellCoord = BrickCoord * SafeBrickSize + LocalCellCoord;
	OutCellCoord = uint3(CellCoord);
	return all(CellCoord >= int3(0, 0, 0)) && all(CellCoord < GridResolution);
}

uint FlattenBrickCoordForEventBins(int3 BrickCoord)
{
	const int3 SafeCoord = clamp(BrickCoord, int3(0, 0, 0), BrickGridResolution - 1);
	return (uint)(SafeCoord.x + SafeCoord.y * BrickGridResolution.x + SafeCoord.z * BrickGridResolution.x * BrickGridResolution.y);
}

uint4 GetEventBrickMask(uint3 CellCoord)
{
	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return EventBrickMasks[FlattenBrickCoordForEventBins(BrickCoord)];
}

float ResolveExplosionWallBlock(float3 UVW, float OpenMask, float3 RadialWorld)
{
	const float3 RadialLocal = mul(float4(RadialWorld, 0.0), WorldToLocal).xyz;
	const float3 RadialUvDirection = normalize(
		RadialLocal / max(BoundsExtent, float3(1.0, 1.0, 1.0)) +
		float3(0.0001, 0.0001, 0.0001));
	const float3 VoxelUv = 1.0 / max(float3(GridResolution), float3(1.0, 1.0, 1.0));
	const float3 OutwardUvStep = RadialUvDirection * VoxelUv;
	const float NearOpen = TimeThiefSmokeObstacleOpen(
		ObstacleTexture,
		VolumeSampler,
		UVW + OutwardUvStep * 1.25,
		ObstacleSdfSurfaceFeatherCm);
	const float FarOpen = TimeThiefSmokeObstacleOpen(
		ObstacleTexture,
		VolumeSampler,
		UVW + OutwardUvStep * 2.5,
		ObstacleSdfSurfaceFeatherCm);
	const float AheadOpen = min(NearOpen, FarOpen);
	return saturate((OpenMask - AheadOpen) * 2.5 + (0.55 - AheadOpen) * 1.5);
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID)
{
	uint3 CellCoord = uint3(0, 0, 0);
	if (!ResolveSmokeCellCoord(DispatchThreadId, GroupId, GroupThreadId, CellCoord))
	{
		return;
	}

	if (bUseActiveBrickDispatch == 0u && !IsSparseSimulationCellActive(CellCoord))
	{
		const int3 Coord = int3(CellCoord);
		OutDensity[CellCoord] = DensityIn.Load(int4(Coord, 0));
		OutDisplacedDensity[CellCoord] = DisplacedDensityIn.Load(int4(Coord, 0));
		OutVelocity[CellCoord] = VelocityIn.Load(int4(Coord, 0));
		return;
	}

	const float3 UVW = TimeThiefSmokeVoxelUVW(CellCoord, GridResolution);
	const float OpenMask = TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, UVW, ObstacleSdfSurfaceFeatherCm);
	const float3 WorldPosition = TimeThiefSmokeVoxelWorld(CellCoord, GridResolution, BoundsExtent, LocalToWorld);
	float NaturalDensity = DensityIn.SampleLevel(VolumeSampler, UVW, 0.0);
	float DisplacedDensity = DisplacedDensityIn.SampleLevel(VolumeSampler, UVW, 0.0);
	float3 Velocity = VelocityIn.SampleLevel(VolumeSampler, UVW, 0.0).xyz;
	if (OpenMask <= 0.01)
	{
		OutDensity[CellCoord] = 0.0;
		OutDisplacedDensity[CellCoord] = 0.0;
		OutVelocity[CellCoord] = float4(0.0, 0.0, 0.0, 0.0);
		return;
	}

	const int SafeEventCount = min(EventCount, MaxShaderEventCount);
	const uint4 EventBrickMask = GetEventBrickMask(CellCoord);
	uint4 RemainingEventMask = EventBrickMask & TimeThiefSmokeValidEventMask(SafeEventCount);
	uint EventWordIndex = 0u;
	[loop]
	for (int CandidateIndex = 0; CandidateIndex < SafeEventCount; ++CandidateIndex)
	{
		const int EventIndex = TimeThiefSmokePopLowestEventIndex(RemainingEventMask, EventWordIndex);
		if (EventIndex < 0 || EventIndex >= SafeEventCount)
		{
			break;
		}
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		if ((uint)round(Event.TypeShapeAgeSeed.x) != 1u)
		{
			continue;
		}

		const float Age = saturate(Event.TypeShapeAgeSeed.z);
		const float Seed = Event.TypeShapeAgeSeed.w;
		const float3 EventPosition = Event.PositionRadius.xyz;
		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float Strength = max(Event.ExtentsStrength.w, 0.0);
		const float3 ToCell = WorldPosition - EventPosition;
		const float MaxInfluenceRadius = TimeThiefSmokeExplosionInfluenceRadius(Event);
		if (dot(ToCell, ToCell) > MaxInfluenceRadius * MaxInfluenceRadius)
		{
			continue;
		}

		const float Distance = length(ToCell);
		const float SafeDeltaSeconds = min(max(DeltaSeconds, 0.0), SimulationEventDeltaSecondsMax);
		const float3 Radial = normalize(float3(ToCell.xy, ToCell.z * 0.35) + float3(0.0001, 0.0001, 0.0001));
		const float3 Curl = TimeThiefSmokeCurlNoise(WorldPosition * 0.014 + Seed * 0.01, Age * 0.35);
		const float OutwardStrength = max(Event.ExtentsStrength.x, 1.0);
		const float WallBlock = ResolveExplosionWallBlock(UVW, OpenMask, Radial);
		const float RadialImpulseScale = lerp(1.0, 0.06, WallBlock);

		// The inner blast front reaches smoke progressively, pushes it first, then dissipates it over time.
		const float CoreMask = 1.0 - smoothstep(Radius * 0.88, Radius * 1.02, Distance);
		const float CoreFrontProgress = smoothstep(0.0, 0.72, Age);
		const float CoreFrontRadius = Radius * lerp(0.12, 1.05, CoreFrontProgress);
		const float CoreFrontThickness = max(Radius * 0.18, 1.0);
		const float CoreShockShell = 1.0 - smoothstep(
			CoreFrontThickness * 0.2,
			CoreFrontThickness,
			abs(Distance - CoreFrontRadius));
		const float CoreReached = 1.0 - smoothstep(
			max(CoreFrontRadius - CoreFrontThickness * 0.35, 0.0),
			CoreFrontRadius + CoreFrontThickness * 0.35,
			Distance);
		const float CorePushFade = 1.0 - smoothstep(0.64, 0.96, Age);
		const float CorePressure = saturate(
			(CoreShockShell + CoreReached * 0.42) * CoreMask * CorePushFade);

		// Outside the gameplay radius, an expanding air-pressure front pushes surrounding smoke without deleting it.
		const float OutsideBlastMask = smoothstep(Radius * 0.94, Radius * 1.04, Distance);
		const float AirFieldFalloff = 1.0 - smoothstep(Radius, MaxInfluenceRadius, Distance);
		const float SurroundingAir = saturate(OutsideBlastMask * AirFieldFalloff);
		const float FrontRadius = lerp(Radius * 1.02, MaxInfluenceRadius, Age);
		const float FrontThickness = max((MaxInfluenceRadius - Radius) * 0.32, Radius * 0.08);
		const float ShockShell = 1.0 - smoothstep(FrontThickness * 0.2, FrontThickness, abs(Distance - FrontRadius));
		const float ShockFade = 1.0 - smoothstep(0.82, 1.0, Age);
		const float AirFieldFade = 1.0 - smoothstep(0.48, 0.92, Age);
		const float OuterPressure = saturate((ShockShell + SurroundingAir * 0.72 * AirFieldFade) * OutsideBlastMask);
		const float PressureWeight = saturate(CorePressure + OuterPressure);

		Velocity *= 1.0 - WallBlock * PressureWeight * ShockFade * 0.65;
		Velocity += Radial * (CorePressure * 1.18 + OuterPressure) * Strength * ShockFade * OutwardStrength * SafeDeltaSeconds * 4.5 * RadialImpulseScale;
		Velocity += Curl * (CoreShockShell * 0.18 + ShockShell * 0.36 + SurroundingAir * 0.12) * Strength * ShockFade * SafeDeltaSeconds * 110.0 * (1.0 - WallBlock);

		// Move affected smoke into the displaced channel before its inner portion gradually fades out.
		const float DisplacementWeight = saturate(
			(CorePressure * 0.68 + SurroundingAir * 0.82 + ShockShell * 0.32) *
			Strength * ShockFade * SafeDeltaSeconds * 2.2);
		const float ShiftedDensity = min(NaturalDensity * DisplacementWeight, max(SmokeDensityMax - DisplacedDensity, 0.0));
		NaturalDensity -= ShiftedDensity;
		DisplacedDensity += ShiftedDensity;

		const float DissolveRamp = smoothstep(0.08, 0.68, Age);
		const float DissolveRate = lerp(1.4, 7.0, DissolveRamp);
		const float CoreDissipation = saturate(
			CoreMask * CoreReached * Strength * SafeDeltaSeconds * DissolveRate);
		NaturalDensity *= 1.0 - CoreDissipation;
		DisplacedDensity *= 1.0 - CoreDissipation;
	}

	NaturalDensity *= OpenMask;
	DisplacedDensity *= OpenMask;
	TimeThiefSmokeClampDensityChannels(NaturalDensity, DisplacedDensity, SmokeDensityMax);
	OutDensity[CellCoord] = NaturalDensity;
	OutDisplacedDensity[CellCoord] = DisplacedDensity;
	OutVelocity[CellCoord] = float4(Velocity * OpenMask, 0.0);
}
