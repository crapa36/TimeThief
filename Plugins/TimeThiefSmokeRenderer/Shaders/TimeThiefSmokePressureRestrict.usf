#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_PRESSURE_RESTRICT_PARAMETERS

float LoadFineDivergence(int3 Coord)
{
	const int3 SafeCoord = clamp(Coord, int3(0, 0, 0), FineGridResolution - 1);
	return DivergenceIn.Load(int4(SafeCoord, 0));
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId >= GridResolution))
	{
		return;
	}

	const int3 FineBase = int3(DispatchThreadId) * 2;
	float Sum = 0.0;

	[unroll]
	for (int Z = 0; Z < 2; ++Z)
	{
		[unroll]
		for (int Y = 0; Y < 2; ++Y)
		{
			[unroll]
			for (int X = 0; X < 2; ++X)
			{
				Sum += LoadFineDivergence(FineBase + int3(X, Y, Z));
			}
		}
	}

	OutDivergence[DispatchThreadId] = Sum * 0.125;
}
