float SampleInterpolatedLightOpticalDepth(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 UVW)
{
	return lerp(SamplePreviousLightOpticalDepthTexture(Slot, UVW), SampleLightOpticalDepthTexture(Slot, UVW), saturate(Desc.BoundaryNoiseControls.w));
}

float SampleDensityField(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	const float4 Fields = SampleFieldSet(Slot, Desc, VolumeUVW);
	return Fields.x + Fields.y;
}

float3 SmokeColorFromDescriptor(FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 WorldRayDirection)
{
	const float ScatteringAnisotropy = Desc.ScatterNoise.y;
	const float PhaseBoost = TimeThiefSmokeDirectionalPhase(WorldRayDirection, Desc.SelfShadowLightDirection_StepCount.xyz, ScatteringAnisotropy);
	return float3(1.0, 1.0, 1.0) * PhaseBoost;
}

float ComputeRenderBoundaryFadeStart(float3 BoundsExtent, float3 NaturalBoundsExtent)
{
	const float3 NaturalCoverage = saturate(max(NaturalBoundsExtent, 1.0) / max(BoundsExtent, 1.0));
	const float NaturalCoverageMax = max(max(NaturalCoverage.x, NaturalCoverage.y), NaturalCoverage.z);
	return clamp(max(0.90, NaturalCoverageMax + 0.04), 0.82, 0.96);
}

float CompositeFBM(float3 P, inout uint EvaluatedOctaveCount)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Normalizer = 0.0;
	[unroll]
	for (int Octave = 0; Octave < 4; ++Octave)
	{
		Sum += TimeThiefSmokeValueNoise(P) * Amplitude;
		Normalizer += Amplitude;
		P = P * 2.03 + float3(17.1, 31.7, 11.3);
		Amplitude *= 0.5;
		++EvaluatedOctaveCount;
	}
	return Sum / max(Normalizer, 0.0001);
}

float CompositeRidgedFBM(float3 P, inout uint EvaluatedOctaveCount)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Normalizer = 0.0;
	[unroll]
	for (int Octave = 0; Octave < 4; ++Octave)
	{
		const float Ridge = 1.0 - abs(TimeThiefSmokeValueNoise(P) * 2.0 - 1.0);
		Sum += Ridge * Ridge * Amplitude;
		Normalizer += Amplitude;
		P = P * 2.07 + float3(29.3, 5.7, 43.1);
		Amplitude *= 0.5;
		++EvaluatedOctaveCount;
	}
	return Sum / max(Normalizer, 0.0001);
}

float CompositeRidgedFBM2(float3 P, inout uint EvaluatedOctaveCount)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Normalizer = 0.0;
	[unroll]
	for (int Octave = 0; Octave < 2; ++Octave)
	{
		const float Ridge = 1.0 - abs(TimeThiefSmokeValueNoise(P) * 2.0 - 1.0);
		Sum += Ridge * Ridge * Amplitude;
		Normalizer += Amplitude;
		P = P * 2.07 + float3(29.3, 5.7, 43.1);
		Amplitude *= 0.5;
		++EvaluatedOctaveCount;
	}
	return Sum / max(Normalizer, 0.0001);
}

float CompositeFBM3(float3 P, inout uint EvaluatedOctaveCount)
{
	float Sum = 0.0;
	float Amplitude = 0.5;
	float Normalizer = 0.0;
	[unroll]
	for (int Octave = 0; Octave < 3; ++Octave)
	{
		Sum += TimeThiefSmokeValueNoise(P) * Amplitude;
		Normalizer += Amplitude;
		P = P * 2.03 + float3(17.1, 31.7, 11.3);
		Amplitude *= 0.5;
		++EvaluatedOctaveCount;
	}
	return Sum / max(Normalizer, 0.0001);
}

float3 CompositeDomainWarp(float3 P, float Time, inout uint EvaluatedOctaveCount)
{
	return (float3(
		CompositeFBM(P + float3(13.1, 7.7, 3.3) + Time, EvaluatedOctaveCount),
		CompositeFBM(P + float3(2.5, 19.3, 11.9) - Time * 0.73, EvaluatedOctaveCount),
		CompositeFBM(P + float3(23.7, 5.1, 17.4) + Time * 0.41, EvaluatedOctaveCount)) - 0.5) * 2.0;
}

float CompositeFilamentMask(
	float3 P,
	float3 SharedWarpBase,
	float Time,
	out float RidgeA,
	out float RidgeB,
	inout uint EvaluatedOctaveCount)
{
	const float3 TimeOffsetA = float3(Time * 0.23, -Time * 0.17, Time * 0.31);
	const float3 TimeOffsetB = float3(-Time * 0.29, Time * 0.19, -Time * 0.11);
	const float3 MaskWarp = float3(SharedWarpBase.y, -SharedWarpBase.z, SharedWarpBase.x);
	RidgeA = CompositeRidgedFBM(
		P + MaskWarp * 1.43 + TimeOffsetA,
		EvaluatedOctaveCount);
	RidgeB = CompositeRidgedFBM(
		P * 1.73 - MaskWarp * 0.82 + TimeOffsetB,
		EvaluatedOctaveCount);
	const float Threads = saturate(RidgeA * 0.58 + RidgeB * 0.52 - 0.12);
	return smoothstep(0.08, 0.82, Threads);
}

float CompositeDensityNoise(
	float3 P,
	float Time,
	float Strength,
	float FineMultiplier,
	inout uint EvaluatedOctaveCount)
{
	const float S = saturate(Strength);
	if (S <= 0.001)
	{
		return 1.0;
	}

	const float3 Q = P;
	const float Base = CompositeFBM(Q, EvaluatedOctaveCount);
	const float BaseShape = smoothstep(0.22, 0.82, Base);
	const float Detail = CompositeRidgedFBM(
		Q * max(FineMultiplier, 1.0) + BaseShape * 0.37 - Time * 0.29,
		EvaluatedOctaveCount);
	const float MacroDetail = lerp(0.78, 1.28, BaseShape);
	const float FiberDetail = lerp(0.62, 1.48, Detail);
	return max(lerp(1.0, MacroDetail * FiberDetail, S), 0.05);
}

float ComputeCompositeBoundaryNoise(
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SampleWorld,
	inout uint EvaluatedOctaveCount)
{
	const float NoiseScale = max(Desc.BoundaryNoiseControls.x, 0.0);
	const float NoiseStrength = max(Desc.BoundaryNoiseControls.y, 0.0);
	if (NoiseScale <= 0.0 || NoiseStrength <= 0.0)
	{
		return 0.0;
	}

	const float AgeSeconds = Desc.FilamentAge.y;
	const float3 NoisePosition = SampleWorld * NoiseScale + float3(AgeSeconds * 0.011, -AgeSeconds * 0.007, AgeSeconds * 0.013);
	return (CompositeFBM(NoisePosition, EvaluatedOctaveCount) - 0.5) * NoiseStrength;
}

float ComputeCompositeFineBoundaryNoise(
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SampleWorld,
	inout uint EvaluatedOctaveCount)
{
	const float NoiseScale = max(Desc.BoundaryNoiseControls.x * 2.03, 0.0);
	const float NoiseStrength = max(Desc.BoundaryNoiseControls.y * 0.5, 0.0);
	if (NoiseScale <= 0.0 || NoiseStrength <= 0.0)
	{
		return 0.0;
	}

	const float AgeSeconds = Desc.FilamentAge.y;
	const float3 NoisePosition = SampleWorld * NoiseScale + float3(-AgeSeconds * 0.017, AgeSeconds * 0.013, AgeSeconds * 0.019);
	return (CompositeRidgedFBM(NoisePosition, EvaluatedOctaveCount) - 0.5) * NoiseStrength;
}

float EvaluateBoundaryMaskLazy(
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SampleWorld,
	float EllipsoidDistance,
	float BoundaryFadeStart,
	inout uint EvaluatedNoiseOctaveCount,
	inout uint BoundaryEvaluationCount,
	inout uint BoundaryCoarseNoiseEvaluationCount,
	inout uint BoundaryFineNoiseEvaluationCount,
	inout uint BoundaryInteriorSkipCount,
	inout uint BoundaryExteriorRejectCount)
{
	++BoundaryEvaluationCount;
	const float CoarseMaxOffset = abs(Desc.BoundaryNoiseControls.y) * 0.5;
	const float FineMaxOffset = abs(Desc.BoundaryNoiseControls.y) * 0.25;
	if (EllipsoidDistance <= BoundaryFadeStart - CoarseMaxOffset)
	{
		++BoundaryInteriorSkipCount;
		return 1.0;
	}

	if (EllipsoidDistance >= max(1.0 + CoarseMaxOffset, 1.04 + FineMaxOffset))
	{
		++BoundaryExteriorRejectCount;
		return 0.0;
	}

	++BoundaryCoarseNoiseEvaluationCount;
	const float BoundaryNoise = ComputeCompositeBoundaryNoise(Desc, SampleWorld, EvaluatedNoiseOctaveCount);
	const float CoarseBoundary = 1.0 - smoothstep(BoundaryFadeStart, 1.0, EllipsoidDistance + BoundaryNoise);
	if (CoarseBoundary >= 1.0)
	{
		return 1.0;
	}

	float FiberBoundary = 0.0;
	if (EllipsoidDistance <= 0.96 - FineMaxOffset)
	{
		FiberBoundary = 1.0;
	}
	else if (EllipsoidDistance < 1.04 + FineMaxOffset)
	{
		++BoundaryFineNoiseEvaluationCount;
		const float FineBoundaryNoise = ComputeCompositeFineBoundaryNoise(Desc, SampleWorld, EvaluatedNoiseOctaveCount);
		FiberBoundary = 1.0 - smoothstep(0.96, 1.04, EllipsoidDistance + FineBoundaryNoise);
	}

	return saturate(CoarseBoundary + FiberBoundary * 0.35);
}

struct FTimeThiefSmokeMediumSample
{
	float ExtinctionCoefficient;
	float3 ScatteringSource;
	float Density;
};

FTimeThiefSmokeMediumSample MakeEmptySmokeMediumSample()
{
	FTimeThiefSmokeMediumSample Sample;
	Sample.ExtinctionCoefficient = 0.0;
	Sample.ScatteringSource = float3(0.0, 0.0, 0.0);
	Sample.Density = 0.0;
	return Sample;
}

FTimeThiefSmokeMediumSample EvaluateSmokeMedium(
	int Slot,
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SampleWorld,
	float3 BoundsExtent,
	float3 SimulationLocal,
	float3 VolumeUVW,
	float3 SmokeColor,
	float SimulationDistanceScale,
	float BoundaryFadeStart,
	float LifetimeAlpha,
	inout uint EvaluatedNoiseOctaveCount,
	inout uint EvaluatedBoundaryNoiseOctaveCount,
	inout uint EvaluatedDensityNoiseOctaveCount,
	inout uint EvaluatedFilamentNoiseOctaveCount,
	inout uint BoundaryEvaluationCount,
	inout uint BoundaryCoarseNoiseEvaluationCount,
	inout uint BoundaryFineNoiseEvaluationCount,
	inout uint BoundaryInteriorSkipCount,
	inout uint BoundaryExteriorRejectCount)
{
	FTimeThiefSmokeMediumSample Sample = MakeEmptySmokeMediumSample();
	const float4 RawFields = SampleFieldSet(Slot, Desc, VolumeUVW);
	const float RawDensity = max(RawFields.x + RawFields.y, 0.0);
	if (RawDensity <= 0.0001)
	{
		return Sample;
	}

#if TIME_THIEF_COMPOSITE_COST_MODE == 4
	Sample.ExtinctionCoefficient = max(RawDensity * Desc.RenderBoundsExtent_Extinction.w * SimulationDistanceScale, 0.0);
	Sample.ScatteringSource = SmokeColor;
	Sample.Density = RawDensity;
	return Sample;
#endif

	const float Obstacle = SampleObstacleTexture(Slot, VolumeUVW);
	const FTimeThiefSmokeBulletOpenMasks BulletMasks = TimeThiefSmokeBulletOpenMasksFromValues(RawFields.z, RawFields.w);
	const float ObstacleOpen = TimeThiefSmokeObstacleOpenFromSdf(Obstacle, Desc.NaturalBoundsExtent_ObstacleFeather.w);
	const float BaseVisibility = ObstacleOpen * BulletMasks.Hard * LifetimeAlpha;
	if (BaseVisibility <= 0.0001)
	{
		return Sample;
	}

	const float EllipsoidDistance = length(SimulationLocal / float3(1.0, 1.0, 0.86));
	const uint BoundaryNoiseOctaveStart = EvaluatedNoiseOctaveCount;
	const float BoundaryMask = EvaluateBoundaryMaskLazy(
		Desc,
		SampleWorld,
		EllipsoidDistance,
		BoundaryFadeStart,
		EvaluatedNoiseOctaveCount,
		BoundaryEvaluationCount,
		BoundaryCoarseNoiseEvaluationCount,
		BoundaryFineNoiseEvaluationCount,
		BoundaryInteriorSkipCount,
		BoundaryExteriorRejectCount);
	EvaluatedBoundaryNoiseOctaveCount += EvaluatedNoiseOctaveCount - BoundaryNoiseOctaveStart;
	if (BoundaryMask <= 0.0001)
	{
		return Sample;
	}

	const float AgeSeconds = Desc.FilamentAge.y;
	const float DensityVisibility = BaseVisibility * BoundaryMask;
	float Density = RawDensity * DensityVisibility;
	if (Density <= 0.0001)
	{
		return Sample;
	}

	const float RenderNoiseScale = Desc.ScatterNoise.z;
	const float RenderNoiseStrength = Desc.ScatterNoise.w;
	const float RenderNoiseTimeScale = Desc.NoiseFilamentA.x;
	const float RenderFilamentScale = Desc.NoiseFilamentA.y;
	const float RenderFilamentStrength = Desc.NoiseFilamentA.z;
	const float RenderFilamentWarpStrength = Desc.FilamentAge.x;
	const float StableRenderNoiseScale = max(RenderNoiseScale, 0.0);
	const float StableRenderFilamentScale = max(RenderFilamentScale, 0.0);
	const float FineNoiseMultiplier = 2.0;
	const float FineFilamentMultiplier = 2.0;
	const float DisplacedDominance = saturate(RawFields.y / max(RawDensity, 0.0001));
	const float TimeNoise = AgeSeconds * RenderNoiseTimeScale;
	const float3 NoisePosition = SimulationLocal * BoundsExtent * StableRenderNoiseScale;
	const uint DensityNoiseOctaveStart = EvaluatedNoiseOctaveCount;
	const float DensityNoise =
#if TIME_THIEF_COMPOSITE_COST_MODE == 2
		1.0;
#else
		CompositeDensityNoise(
		NoisePosition,
		TimeNoise,
		RenderNoiseStrength * lerp(1.0, 1.15, DisplacedDominance),
		FineNoiseMultiplier,
		EvaluatedNoiseOctaveCount);
#endif
	EvaluatedDensityNoiseOctaveCount += EvaluatedNoiseOctaveCount - DensityNoiseOctaveStart;

	float FilamentGain = 1.0;
	if (RenderFilamentStrength > 0.001
#if TIME_THIEF_COMPOSITE_COST_MODE == 2
		&& false
#endif
	)
	{
		const uint FilamentNoiseOctaveStart = EvaluatedNoiseOctaveCount;
		const float3 FilamentPosition = SimulationLocal * BoundsExtent * StableRenderFilamentScale;
		const float3 SharedWarpBase = CompositeDomainWarp(
			FilamentPosition * 0.43,
			TimeNoise * 0.72,
			EvaluatedNoiseOctaveCount);
		const float3 FilamentWarp = SharedWarpBase * RenderFilamentWarpStrength;
		float RidgeA = 0.0;
		float RidgeB = 0.0;
		const float FilamentMask = CompositeFilamentMask(
			FilamentPosition + FilamentWarp,
			SharedWarpBase,
			TimeNoise,
			RidgeA,
			RidgeB,
			EvaluatedNoiseOctaveCount);
		const float FineRidge = CompositeRidgedFBM2(
			FilamentPosition * FineFilamentMultiplier - FilamentWarp * 0.36 + TimeNoise * 0.91,
			EvaluatedNoiseOctaveCount);
		const float CombinedFilamentMask = saturate(FilamentMask * 0.68 + FineRidge * 0.42);
		const float AirPocket = CompositeFBM3(
			FilamentPosition * 0.37 - FilamentWarp * 0.42 + TimeNoise * 0.37,
			EvaluatedNoiseOctaveCount);
		const float FilamentLow = max(0.25, 1.0 - RenderFilamentStrength * (0.20 + AirPocket * 0.30));
		const float FilamentHigh = 1.0 + RenderFilamentStrength * 0.55;
		FilamentGain = lerp(FilamentLow, FilamentHigh, CombinedFilamentMask);
		EvaluatedFilamentNoiseOctaveCount += EvaluatedNoiseOctaveCount - FilamentNoiseOctaveStart;
	}

	const float BulletEdgeDensityGain = lerp(1.0, 1.16, BulletMasks.Edge);
	Density *= DensityNoise * FilamentGain * BulletEdgeDensityGain;
	Sample.ExtinctionCoefficient = max(Density * Desc.RenderBoundsExtent_Extinction.w * SimulationDistanceScale, 0.0);
	Sample.ScatteringSource = SmokeColor * saturate(0.82 + Density * 0.85);
	Sample.Density = Density;
	return Sample;
}

float AlignStableRaySample(float SegmentStart, float StepLength, float PixelPhase)
{
	return (ceil(SegmentStart / StepLength - PixelPhase) + PixelPhase) * StepLength;
}

float3 CompositeDebugHeatColor(float Value)
{
	const float T = saturate(Value);
	return saturate(float3(T * 2.0, 1.0 - abs(T * 2.0 - 1.0), (1.0 - T) * 2.0));
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const int2 PixelCoord = int2(SvPosition.xy) - TileRectMin;
	const int2 TileCoord = clamp(PixelCoord / max(CompositeTileSize, 1), int2(0, 0), TileGridSize - 1);
	const int TileIndex = TileCoord.y * TileGridSize.x + TileCoord.x;
	const FTimeThiefSmokeCompositeTileRangeShaderData TileRange = TileSmokeRanges[TileIndex];
	const int TileOffset = (int)round(TileRange.OffsetCount.x);
	const int TileSmokeCount = min((int)round(TileRange.OffsetCount.y), TIME_THIEF_MAX_COMPOSITE_SMOKES);
	const float3 NearWorld = ReconstructWorldPosition(SvPosition.xy, 1.0);
	const float3 FarWorld = ReconstructWorldPosition(SvPosition.xy, 0.0);
	const float3 WorldRayDirection = normalize(FarWorld - NearWorld);
	if (TileSmokeCount <= 0)
	{
		OutColor = float4(0.0, 0.0, 0.0, 1.0);
		return;
	}
	const float SceneDeviceZ = LoadSceneDeviceZ(SvPosition.xy);
	const bool bHasOpaqueSceneDepth = SceneDeviceZ > 0.000001;
	const float3 SceneWorld = bHasOpaqueSceneDepth ? ReconstructWorldPosition(SvPosition.xy, SceneDeviceZ) : FarWorld;
	const float3 WorldLightDirection = normalize(CombinedShadowLightDirection + float3(0.0, 0.0, 0.0001));
	const float SceneT = max(dot(SceneWorld - NearWorld, WorldRayDirection), 0.0);

	float SmokeTMin[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeTMax[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeColors[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalOrigins[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalRayDirections[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeBoundsExtents[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeSimulationStepScales[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeBoundaryFadeStarts[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeLifetimeAlphas[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalLightDirections[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	int SmokeSlots[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	int ActiveSmokeCount = 0;
	float RayStart = SceneT;
	float RayEnd = 0.0;
	float TransmittanceEarlyOut = 0.0;

	[loop]
	for (int TileSmokeIndex = 0; TileSmokeIndex < TileSmokeCount; ++TileSmokeIndex)
	{
		const int Slot = (int)TileSmokeIndices[TileOffset + TileSmokeIndex];
		if (Slot < 0 || Slot >= SmokeSlotCount || ActiveSmokeCount >= TIME_THIEF_MAX_COMPOSITE_SMOKES)
		{
			continue;
		}

		const FTimeThiefSmokeCompositeDescriptorShaderData Desc = CompositeSmokeDescriptors[Slot];
		const float4x4 WorldToLocal = GetWorldToLocal(Desc);
		const float3 RenderBoundsExtent = max(Desc.RenderBoundsExtent_Extinction.xyz, 1.0);
		const float3 LocalNear = mul(float4(NearWorld, 1.0), WorldToLocal).xyz;
		const float3 LocalRayDirection = mul(float4(WorldRayDirection, 0.0), WorldToLocal).xyz;
		const float3 LocalOrigin = LocalNear / RenderBoundsExtent;
		const float3 LocalDirection = LocalRayDirection / RenderBoundsExtent;
		float TMin = 0.0;
		float TMax = 0.0;
		if (!IntersectUnitBox(LocalOrigin, LocalDirection, TMin, TMax))
		{
			continue;
		}

		TMin = max(TMin, 0.0);
		TMax = min(TMax, SceneT);
		if (TMax <= TMin)
		{
			continue;
		}

		const float3 BoundsExtent = max(Desc.BoundsExtent_RenderStepVoxelScale.xyz, 1.0);
		const float3 SimulationRayDirection = LocalRayDirection / BoundsExtent;
		const float BoundaryFadeStart = ComputeRenderBoundaryFadeStart(BoundsExtent, Desc.NaturalBoundsExtent_ObstacleFeather.xyz);
		const float LifetimeAlpha = 1.0 - smoothstep(Desc.FilamentAge.z, Desc.FilamentAge.z + max(Desc.FilamentAge.w, 0.001), Desc.FilamentAge.y);
		TransmittanceEarlyOut = max(TransmittanceEarlyOut, Desc.RaymarchControls.y);
		SmokeTMin[ActiveSmokeCount] = TMin;
		SmokeTMax[ActiveSmokeCount] = TMax;
		SmokeColors[ActiveSmokeCount] = SmokeColorFromDescriptor(Desc, WorldRayDirection);
		SmokeLocalOrigins[ActiveSmokeCount] = LocalNear;
		SmokeLocalRayDirections[ActiveSmokeCount] = LocalRayDirection;
		SmokeBoundsExtents[ActiveSmokeCount] = BoundsExtent;
		SmokeSimulationStepScales[ActiveSmokeCount] = length(SimulationRayDirection);
		SmokeBoundaryFadeStarts[ActiveSmokeCount] = BoundaryFadeStart;
		SmokeLifetimeAlphas[ActiveSmokeCount] = LifetimeAlpha;
		SmokeLocalLightDirections[ActiveSmokeCount] = mul(float4(WorldLightDirection, 0.0), WorldToLocal).xyz;
		SmokeSlots[ActiveSmokeCount] = Slot;
		++ActiveSmokeCount;
		RayStart = min(RayStart, TMin);
		RayEnd = max(RayEnd, TMax);
	}

	if (ActiveSmokeCount <= 0 || RayEnd <= RayStart)
	{
		OutColor = float4(0.0, 0.0, 0.0, 1.0);
		return;
	}

	float SegmentBoundaries[TIME_THIEF_MAX_SEGMENT_BOUNDARIES];
	int SegmentBoundaryCount = 0;
	SegmentBoundaries[SegmentBoundaryCount++] = RayStart;
	SegmentBoundaries[SegmentBoundaryCount++] = RayEnd;
	[loop]
	for (int SmokeIndex = 0; SmokeIndex < ActiveSmokeCount; ++SmokeIndex)
	{
		SegmentBoundaries[SegmentBoundaryCount++] = clamp(SmokeTMin[SmokeIndex], RayStart, RayEnd);
		SegmentBoundaries[SegmentBoundaryCount++] = clamp(SmokeTMax[SmokeIndex], RayStart, RayEnd);
	}
	[loop]
	for (int BoundaryIndex = 1; BoundaryIndex < SegmentBoundaryCount; ++BoundaryIndex)
	{
		const float Boundary = SegmentBoundaries[BoundaryIndex];
		int SortedIndex = BoundaryIndex - 1;
		[loop]
		while (SortedIndex >= 0 && SegmentBoundaries[SortedIndex] > Boundary)
		{
			SegmentBoundaries[SortedIndex + 1] = SegmentBoundaries[SortedIndex];
			--SortedIndex;
		}
		SegmentBoundaries[SortedIndex + 1] = Boundary;
	}

	const float StepSize = max(RenderWorldStepLength, 1.0);
	const float HalfStepSize = StepSize * 0.5;
	const float PixelPhase = 0.5;
	float Transmittance = 1.0;
	float3 SmokeColorAccum = float3(0.0, 0.0, 0.0);
	float DebugMaxCombinedExtinction = 0.0;
	float DebugMinCombinedShadow = 1.0;
	int ResolvedStableStepCount = 0;
	int StableSampleCount = 0;
	int SegmentCount = 0;
	int CombinedMediumSampleCount = 0;
	int CombinedShadowEvaluationCount = 0;
	uint FilteredNoiseOctaveCount = 0u;
	uint BoundaryNoiseOctaveCount = 0u;
	uint DensityNoiseOctaveCount = 0u;
	uint FilamentNoiseOctaveCount = 0u;
	uint ShadowNoiseOctaveCount = 0u;
	int CombinedShadowStepSampleCount = 0;
	int CombinedShadowMediumSampleCount = 0;
	uint BoundaryEvaluationCount = 0u;
	uint BoundaryCoarseNoiseEvaluationCount = 0u;
	uint BoundaryFineNoiseEvaluationCount = 0u;
	uint BoundaryInteriorSkipCount = 0u;
	uint BoundaryExteriorRejectCount = 0u;
	uint ShadowIntervalSkipCount = 0u;
	uint ShadowOpticalDepthEarlyOutCount = 0u;
	uint ShadowAdaptiveDoubleStepCount = 0u;
	uint ShadowEllipsoidRejectCount = 0u;
	int TotalLoopCount = 0;
	[loop]
	for (int SegmentIndex = 0; SegmentIndex < SegmentBoundaryCount - 1 && TotalLoopCount < TIME_THIEF_MAX_STABLE_STEPS; ++SegmentIndex)
	{
		const float SegmentStart = SegmentBoundaries[SegmentIndex];
		const float SegmentEnd = SegmentBoundaries[SegmentIndex + 1];
		if (SegmentEnd <= SegmentStart)
		{
			continue;
		}

		int SegmentSmokeIndices[TIME_THIEF_MAX_COMPOSITE_SMOKES];
		int SegmentSmokeCount = 0;
		[loop]
		for (int SmokeIndex = 0; SmokeIndex < ActiveSmokeCount; ++SmokeIndex)
		{
			if (SegmentStart < SmokeTMax[SmokeIndex] && SegmentEnd > SmokeTMin[SmokeIndex] && SegmentSmokeCount < TIME_THIEF_MAX_COMPOSITE_SMOKES)
			{
				SegmentSmokeIndices[SegmentSmokeCount++] = SmokeIndex;
			}
		}
		if (SegmentSmokeCount <= 0)
		{
			continue;
		}

		++SegmentCount;
		float CurrentT = AlignStableRaySample(SegmentStart - HalfStepSize, StepSize, PixelPhase);
		const float SegmentSampleEnd = SegmentEnd + HalfStepSize;
		if (CurrentT < SegmentSampleEnd)
		{
			ResolvedStableStepCount += (int)ceil((SegmentSampleEnd - CurrentT) / StepSize);
		}
		[loop]
		while (TotalLoopCount < TIME_THIEF_MAX_STABLE_STEPS && CurrentT < SegmentSampleEnd)
		{
			const float IntervalStart = max(CurrentT - HalfStepSize, SegmentStart);
			const float IntervalEnd = min(CurrentT + HalfStepSize, SegmentEnd);
			const float IntervalLength = max(IntervalEnd - IntervalStart, 0.0);
			const float IntervalMidT = (IntervalStart + IntervalEnd) * 0.5;
			if (IntervalLength <= 0.0)
			{
				CurrentT += StepSize;
				continue;
			}

			float TotalExtinctionCoefficient = 0.0;
			float3 TotalScatteringSource = float3(0.0, 0.0, 0.0);

			const float IntegrationSampleT = IntervalMidT;
				const float3 SampleWorld = NearWorld + WorldRayDirection * IntegrationSampleT;

				[loop]
				for (int SegmentSmokeIndex = 0; SegmentSmokeIndex < SegmentSmokeCount; ++SegmentSmokeIndex)
				{
					const int SmokeIndex = SegmentSmokeIndices[SegmentSmokeIndex];
					if (IntegrationSampleT < SmokeTMin[SmokeIndex] || IntegrationSampleT > SmokeTMax[SmokeIndex])
					{
						continue;
					}

					const int Slot = SmokeSlots[SmokeIndex];
					const FTimeThiefSmokeCompositeDescriptorShaderData Desc = CompositeSmokeDescriptors[Slot];
					const float3 BoundsExtent = SmokeBoundsExtents[SmokeIndex];
					const float3 SampleLocal = SmokeLocalOrigins[SmokeIndex] + SmokeLocalRayDirections[SmokeIndex] * IntegrationSampleT;
					const float3 SimulationLocal = SampleLocal / BoundsExtent;
					const float3 VolumeUVW = SimulationLocal * 0.5 + 0.5;
					if (!TimeThiefSmokeInsideUVW(VolumeUVW))
					{
						continue;
					}

					const FTimeThiefSmokeMediumSample MediumSample = EvaluateSmokeMedium(
						Slot,
						Desc,
						SampleWorld,
						BoundsExtent,
						SimulationLocal,
						VolumeUVW,
						SmokeColors[SmokeIndex],
						SmokeSimulationStepScales[SmokeIndex],
						SmokeBoundaryFadeStarts[SmokeIndex],
						SmokeLifetimeAlphas[SmokeIndex],
						FilteredNoiseOctaveCount,
						BoundaryNoiseOctaveCount,
						DensityNoiseOctaveCount,
						FilamentNoiseOctaveCount,
						BoundaryEvaluationCount,
						BoundaryCoarseNoiseEvaluationCount,
						BoundaryFineNoiseEvaluationCount,
						BoundaryInteriorSkipCount,
						BoundaryExteriorRejectCount);
					++CombinedMediumSampleCount;
					TotalExtinctionCoefficient += MediumSample.ExtinctionCoefficient;
					TotalScatteringSource += MediumSample.ExtinctionCoefficient * MediumSample.ScatteringSource;
				}

			++StableSampleCount;
			++TotalLoopCount;
			DebugMaxCombinedExtinction = max(DebugMaxCombinedExtinction, TotalExtinctionCoefficient);
			if (TotalExtinctionCoefficient > 0.000001)
			{
				const float StepOpticalDepth = TotalExtinctionCoefficient * IntervalLength;
				const float StepTransmittance = exp2(-StepOpticalDepth * 1.442695);
				const float SampleWeight = Transmittance * (1.0 - StepTransmittance);
				float CombinedShadow = 1.0;
				if (SampleWeight > SelfShadowMinSampleWeight && CombinedShadowStepCount > 0 && CombinedShadowStrength > 0.001 && CombinedShadowExtinction > 0.001
#if TIME_THIEF_COMPOSITE_COST_MODE == 3 || TIME_THIEF_COMPOSITE_COST_MODE == 4
					&& false
#endif
				)
				{
					float ShadowOpticalDepth = 0.0;
#if TIME_THIEF_COMPOSITE_SINGLE_SMOKE
					const int ShadowSlot = SmokeSlots[0];
					const float3 ShadowLocal = SmokeLocalOrigins[0] + SmokeLocalRayDirections[0] * IntervalMidT;
					const float3 ShadowUVW = saturate((ShadowLocal / SmokeBoundsExtents[0]) * 0.5 + 0.5);
					const FTimeThiefSmokeCompositeDescriptorShaderData ShadowDesc = CompositeSmokeDescriptors[ShadowSlot];
					ShadowOpticalDepth = SampleInterpolatedLightOpticalDepth(ShadowSlot, ShadowDesc, ShadowUVW);
					++CombinedShadowMediumSampleCount;
#else
					[loop]
					for (int ShadowSmokeIndex = 0; ShadowSmokeIndex < ActiveSmokeCount; ++ShadowSmokeIndex)
					{
						const int ShadowSlot = SmokeSlots[ShadowSmokeIndex];
						const float3 ShadowBoundsExtent = SmokeBoundsExtents[ShadowSmokeIndex];
						const float3 ShadowOrigin =
							(SmokeLocalOrigins[ShadowSmokeIndex] + SmokeLocalRayDirections[ShadowSmokeIndex] * IntervalMidT) /
							ShadowBoundsExtent;
						const float3 ShadowDirection = SmokeLocalLightDirections[ShadowSmokeIndex] / ShadowBoundsExtent;
						float ShadowTMin = 0.0;
						float ShadowTMax = 0.0;
						if (!IntersectUnitBox(ShadowOrigin, ShadowDirection, ShadowTMin, ShadowTMax))
						{
							continue;
						}

						const float ShadowEntryDistance = max(ShadowTMin, 0.0);
						if (ShadowTMax <= ShadowEntryDistance)
						{
							continue;
						}

						const float3 ShadowEntryLocal = ShadowOrigin + ShadowDirection * ShadowEntryDistance;
						const float3 ShadowUVW = saturate(ShadowEntryLocal * 0.5 + 0.5);
						const FTimeThiefSmokeCompositeDescriptorShaderData ShadowDesc = CompositeSmokeDescriptors[ShadowSlot];
						ShadowOpticalDepth += SampleInterpolatedLightOpticalDepth(ShadowSlot, ShadowDesc, ShadowUVW);
						++CombinedShadowMediumSampleCount;
					}
#endif

					ShadowOpticalDepth *= CombinedShadowExtinction;
					const float ShadowTransmittance = exp2(-ShadowOpticalDepth * 1.442695);
					const float PowderDepth = 1.0 - exp2(-ShadowOpticalDepth * 0.75 * 1.442695);
					const float PowderLighting = lerp(0.9, 1.06, saturate(PowderDepth));
					CombinedShadow = saturate(lerp(1.0, ShadowTransmittance * PowderLighting, CombinedShadowStrength));
					++CombinedShadowEvaluationCount;
				}

				DebugMinCombinedShadow = min(DebugMinCombinedShadow, CombinedShadow);
				const float3 CombinedScatteringSource = TotalScatteringSource / TotalExtinctionCoefficient;
				SmokeColorAccum += SampleWeight * CombinedScatteringSource * CombinedShadow;
				Transmittance *= StepTransmittance;
			}

			if (Transmittance < TransmittanceEarlyOut)
			{
				break;
			}

			CurrentT += StepSize;
		}

		if (Transmittance < TransmittanceEarlyOut)
		{
			break;
		}
	}

#if TIME_THIEF_COMPOSITE_STEP_STATS
	InterlockedMax(CompositeStepStats[0], (uint)max(TIME_THIEF_MAX_STABLE_STEPS - ResolvedStableStepCount, 0));
	InterlockedMax(CompositeStepStats[1], (uint)ResolvedStableStepCount);
	InterlockedAdd(CompositeStepStats[2], (uint)ResolvedStableStepCount);
	InterlockedAdd(CompositeStepStats[3], 1u);
	InterlockedMax(CompositeStepStats[4], (uint)max(TIME_THIEF_MAX_STABLE_STEPS - StableSampleCount, 0));
	InterlockedMax(CompositeStepStats[5], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[6], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[7], 1u);
	InterlockedAdd(CompositeStepStats[8], (uint)SegmentCount);
	InterlockedAdd(CompositeStepStats[9], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[10], 0u);
	InterlockedAdd(CompositeStepStats[11], (uint)CombinedMediumSampleCount);
	InterlockedAdd(CompositeStepStats[12], (uint)CombinedShadowEvaluationCount);
	InterlockedXor(CompositeStepStats[13], 0u);
	InterlockedMax(CompositeStepStats[14], (uint)ActiveSmokeCount);
	InterlockedMax(CompositeStepStats[15], 1u);
	InterlockedAdd(CompositeStepStats[16], FilteredNoiseOctaveCount);
	InterlockedAdd(CompositeStepStats[17], BoundaryNoiseOctaveCount);
	InterlockedAdd(CompositeStepStats[18], DensityNoiseOctaveCount);
	InterlockedAdd(CompositeStepStats[19], FilamentNoiseOctaveCount);
	InterlockedAdd(CompositeStepStats[20], ShadowNoiseOctaveCount);
	InterlockedAdd(CompositeStepStats[21], (uint)CombinedShadowStepSampleCount);
	InterlockedAdd(CompositeStepStats[22], (uint)CombinedShadowMediumSampleCount);
	InterlockedAdd(CompositeStepStats[23], BoundaryEvaluationCount);
	InterlockedAdd(CompositeStepStats[24], BoundaryCoarseNoiseEvaluationCount);
	InterlockedAdd(CompositeStepStats[25], BoundaryFineNoiseEvaluationCount);
	InterlockedAdd(CompositeStepStats[26], BoundaryInteriorSkipCount);
	InterlockedAdd(CompositeStepStats[27], BoundaryExteriorRejectCount);
	InterlockedAdd(CompositeStepStats[28], ShadowIntervalSkipCount);
	InterlockedAdd(CompositeStepStats[29], ShadowOpticalDepthEarlyOutCount);
	InterlockedAdd(CompositeStepStats[30], ShadowAdaptiveDoubleStepCount);
	InterlockedAdd(CompositeStepStats[31], ShadowEllipsoidRejectCount);
#endif

	if (CompositeDebugMode > 0)
	{
		float3 DebugColor = float3(0.0, 0.0, 0.0);
		if (CompositeDebugMode == 1)
		{
			DebugColor = CompositeDebugHeatColor((float)ActiveSmokeCount / (float)TIME_THIEF_MAX_COMPOSITE_SMOKES);
		}
		else if (CompositeDebugMode == 2)
		{
			DebugColor = 0.5;
		}
		else if (CompositeDebugMode == 3)
		{
			DebugColor = CompositeDebugHeatColor(saturate(DebugMaxCombinedExtinction * StepSize));
		}
		else if (CompositeDebugMode == 4)
		{
			DebugColor = DebugMinCombinedShadow.xxx;
		}
		else
		{
			const float SmokeIdColor = frac(abs(CompositeSmokeDescriptors[SmokeSlots[0]].BoundaryNoiseControls.z) * 0.61803398875);
			DebugColor = float3(SmokeIdColor, frac(SmokeIdColor + 0.3333), frac(SmokeIdColor + 0.6667));
		}
		OutColor = float4(DebugColor, 0.0);
		return;
	}

	const float3 SmokeContribution = SmokeColorAccum;
	OutColor = float4(SmokeContribution, Transmittance);
}
