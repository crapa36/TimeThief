int3 ComputeBrickCoord(FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	const int3 GridResolution = GetGridResolution(Desc);
	const int3 BrickGridResolution = GetBrickGridResolution(Desc);
	const int3 CellCoord = clamp((int3)floor(saturate(VolumeUVW) * float3(GridResolution)), int3(0, 0, 0), GridResolution - 1);
	return clamp(CellCoord / GetSmokeBrickSize(Desc), int3(0, 0, 0), BrickGridResolution - 1);
}

bool IsActiveBrick(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	if (UsesSparseAtlas(Desc) == 0u)
	{
		return true;
	}
	return LoadBrickOccupancyTexture(Slot, ComputeBrickCoord(Desc, VolumeUVW)) != 0u;
}

float4 LoadCompositeAtlasCell(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, uint BrickIndirection, int3 BrickCoord, int3 SafeCellCoord)
{
	const int SafeBrickSize = GetSmokeBrickSize(Desc);
	const int3 AtlasBrickCoord = TimeThiefSmokeAtlasBrickCoord(BrickIndirection, GetSparseAtlasBrickGridResolution(Desc));
	const int3 LocalCellCoord = SafeCellCoord - BrickCoord * SafeBrickSize;
	const int3 AtlasCoord = AtlasBrickCoord * SafeBrickSize + LocalCellCoord;
	return LoadSparseFieldAtlasTexture(Slot, AtlasCoord);
}

float4 LoadCompositeFieldCell(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, int3 CellCoord)
{
	const int3 GridResolution = GetGridResolution(Desc);
	const int3 BrickGridResolution = GetBrickGridResolution(Desc);
	const int SafeBrickSize = GetSmokeBrickSize(Desc);
	const int3 SafeCellCoord = clamp(CellCoord, int3(0, 0, 0), GridResolution - 1);
	const int3 BrickCoord = clamp(SafeCellCoord / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	const uint BrickIndirection = LoadBrickOccupancyTexture(Slot, BrickCoord);
	if (BrickIndirection == 0u)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	if (BrickIndirection > (uint)GetMaxActiveSmokeBricks(Desc))
	{
		return float4(
			LoadDensityTexture(Slot, SafeCellCoord) + LoadDisplacedDensityTexture(Slot, SafeCellCoord),
			0.0,
			HasBulletFields(Desc) ? LoadBulletCutoutTexture(Slot, SafeCellCoord) : 0.0,
			HasBulletFields(Desc) ? LoadBulletSinkTexture(Slot, SafeCellCoord) : 0.0);
	}
	return LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, BrickCoord, SafeCellCoord);
}

float4 SampleCompositeSparseFields(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	const int SafeBrickSize = GetSmokeBrickSize(Desc);
	const int3 GridResolution = GetGridResolution(Desc);
	const int3 BrickGridResolution = GetBrickGridResolution(Desc);
	const float3 GridPosition = saturate(VolumeUVW) * max(float3(GridResolution), 1.0) - 0.5;
	const int3 Cell0 = (int3)floor(GridPosition);
	const float3 CellAlpha = saturate(GridPosition - float3(Cell0));
	const int3 Cell1 = Cell0 + int3(1, 1, 1);
	const int3 SafeCell0 = clamp(Cell0, int3(0, 0, 0), GridResolution - 1);
	const int3 SafeCell1 = clamp(Cell1, int3(0, 0, 0), GridResolution - 1);
	const int3 Brick0 = clamp(SafeCell0 / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	const int3 Brick1 = clamp(SafeCell1 / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);

	if (Brick0.x == Brick1.x && Brick0.y == Brick1.y && Brick0.z == Brick1.z)
	{
		const uint BrickIndirection = LoadBrickOccupancyTexture(Slot, Brick0);
		if (BrickIndirection == 0u)
		{
			return float4(0.0, 0.0, 0.0, 0.0);
		}
		if (BrickIndirection > (uint)GetMaxActiveSmokeBricks(Desc))
		{
			return float4(
				SampleDensityTexture(Slot, saturate(VolumeUVW)) + SampleDisplacedDensityTexture(Slot, saturate(VolumeUVW)),
				0.0,
				HasBulletFields(Desc) ? SampleBulletCutoutTexture(Slot, saturate(VolumeUVW)) : 0.0,
				HasBulletFields(Desc) ? SampleBulletSinkTexture(Slot, saturate(VolumeUVW)) : 0.0);
		}

		const float4 V000 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell0.y, SafeCell0.z));
		const float4 V100 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell0.y, SafeCell0.z));
		const float4 V010 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell1.y, SafeCell0.z));
		const float4 V110 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell1.y, SafeCell0.z));
		const float4 V001 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell0.y, SafeCell1.z));
		const float4 V101 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell0.y, SafeCell1.z));
		const float4 V011 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell1.y, SafeCell1.z));
		const float4 V111 = LoadCompositeAtlasCell(Slot, Desc, BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell1.y, SafeCell1.z));
		const float4 X00 = lerp(V000, V100, CellAlpha.x);
		const float4 X10 = lerp(V010, V110, CellAlpha.x);
		const float4 X01 = lerp(V001, V101, CellAlpha.x);
		const float4 X11 = lerp(V011, V111, CellAlpha.x);
		const float4 Y0 = lerp(X00, X10, CellAlpha.y);
		const float4 Y1 = lerp(X01, X11, CellAlpha.y);
		return lerp(Y0, Y1, CellAlpha.z);
	}

	const float4 V000 = LoadCompositeFieldCell(Slot, Desc, int3(Cell0.x, Cell0.y, Cell0.z));
	const float4 V100 = LoadCompositeFieldCell(Slot, Desc, int3(Cell1.x, Cell0.y, Cell0.z));
	const float4 V010 = LoadCompositeFieldCell(Slot, Desc, int3(Cell0.x, Cell1.y, Cell0.z));
	const float4 V110 = LoadCompositeFieldCell(Slot, Desc, int3(Cell1.x, Cell1.y, Cell0.z));
	const float4 V001 = LoadCompositeFieldCell(Slot, Desc, int3(Cell0.x, Cell0.y, Cell1.z));
	const float4 V101 = LoadCompositeFieldCell(Slot, Desc, int3(Cell1.x, Cell0.y, Cell1.z));
	const float4 V011 = LoadCompositeFieldCell(Slot, Desc, int3(Cell0.x, Cell1.y, Cell1.z));
	const float4 V111 = LoadCompositeFieldCell(Slot, Desc, int3(Cell1.x, Cell1.y, Cell1.z));
	const float4 X00 = lerp(V000, V100, CellAlpha.x);
	const float4 X10 = lerp(V010, V110, CellAlpha.x);
	const float4 X01 = lerp(V001, V101, CellAlpha.x);
	const float4 X11 = lerp(V011, V111, CellAlpha.x);
	const float4 Y0 = lerp(X00, X10, CellAlpha.y);
	const float4 Y1 = lerp(X01, X11, CellAlpha.y);
	return lerp(Y0, Y1, CellAlpha.z);
}

float4 SampleFieldSet(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	const float3 SafeUVW = saturate(VolumeUVW);
	if (UsesSparseAtlas(Desc) != 0u)
	{
		return SampleCompositeSparseFields(Slot, Desc, VolumeUVW);
	}
	if (UsesPackedDenseField(Desc) != 0u)
	{
		return SamplePackedDenseFieldTexture(Slot, SafeUVW);
	}
	return float4(
			SampleDensityTexture(Slot, SafeUVW) + SampleDisplacedDensityTexture(Slot, SafeUVW),
			0.0,
			HasBulletFields(Desc) ? SampleBulletCutoutTexture(Slot, SafeUVW) : 0.0,
			HasBulletFields(Desc) ? SampleBulletSinkTexture(Slot, SafeUVW) : 0.0);
}

float SampleDensityField(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	if (UsesSparseAtlas(Desc) != 0u)
	{
		return SampleCompositeSparseFields(Slot, Desc, VolumeUVW).x;
	}
	if (UsesPackedDenseField(Desc) != 0u)
	{
		return SamplePackedDenseFieldTexture(Slot, saturate(VolumeUVW)).x;
	}

	const float3 SafeUVW = saturate(VolumeUVW);
	return SampleDensityTexture(Slot, SafeUVW) + SampleDisplacedDensityTexture(Slot, SafeUVW);
}

float ComputeBrickExitDelta(FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW, float3 RayUVWDirection)
{
	const int3 BrickCoord = ComputeBrickCoord(Desc, VolumeUVW);
	const float3 SafeGridResolution = max(float3(GetGridResolution(Desc)), 1.0);
	const float SafeBrickSize = max((float)GetSmokeBrickSize(Desc), 1.0);
	const float3 BrickMin = (float3(BrickCoord) * SafeBrickSize) / SafeGridResolution;
	const float3 BrickMax = min((float3(BrickCoord + int3(1, 1, 1)) * SafeBrickSize) / SafeGridResolution, 1.0);
	float DeltaT = 1000000.0;
	if (abs(RayUVWDirection.x) > 0.000001)
	{
		const float Boundary = RayUVWDirection.x > 0.0 ? BrickMax.x : BrickMin.x;
		const float AxisDelta = (Boundary - VolumeUVW.x) / RayUVWDirection.x;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}
	if (abs(RayUVWDirection.y) > 0.000001)
	{
		const float Boundary = RayUVWDirection.y > 0.0 ? BrickMax.y : BrickMin.y;
		const float AxisDelta = (Boundary - VolumeUVW.y) / RayUVWDirection.y;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}
	if (abs(RayUVWDirection.z) > 0.000001)
	{
		const float Boundary = RayUVWDirection.z > 0.0 ? BrickMax.z : BrickMin.z;
		const float AxisDelta = (Boundary - VolumeUVW.z) / RayUVWDirection.z;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}
	return DeltaT;
}

float ComputeInactiveBrickSkip(FTimeThiefSmokeCompositeDescriptorShaderData Desc, int Slot, float3 VolumeUVW, float3 RayUVWDirection, float StepSize)
{
	const float MaxSkip = StepSize * Desc.RaymarchControls.x;
	const int MaxTraversalBricks = max((int)round(Desc.RaymarchControls.x), 1);
	float AccumulatedSkip = 0.0;
	[loop]
	for (int TraversalIndex = 0; TraversalIndex < MaxTraversalBricks; ++TraversalIndex)
	{
		const float3 ProbeUVW = VolumeUVW + RayUVWDirection * AccumulatedSkip;
		if (!TimeThiefSmokeInsideUVW(ProbeUVW) || IsActiveBrick(Slot, Desc, ProbeUVW))
		{
			break;
		}

		const float BrickExitDelta = ComputeBrickExitDelta(Desc, ProbeUVW, RayUVWDirection);
		if (BrickExitDelta >= 999999.0)
		{
			break;
		}

		AccumulatedSkip += BrickExitDelta + 0.0001;
		if (AccumulatedSkip >= MaxSkip)
		{
			break;
		}
	}
	return clamp(max(StepSize, AccumulatedSkip), StepSize, MaxSkip);
}

float3 SmokeColorFromDescriptor(FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 WorldRayDirection)
{
	const float ScatteringAnisotropy = Desc.ScatterNoise.y;
	const float PhaseBoost = TimeThiefSmokeDirectionalPhase(WorldRayDirection, Desc.SelfShadowLightDirection_StepCount.xyz, ScatteringAnisotropy);
	return float3(1.0, 1.0, 1.0) * PhaseBoost * saturate(Desc.ScatterNoise.x);
}

float ComputeRenderBoundaryFadeStart(float3 BoundsExtent, float3 NaturalBoundsExtent)
{
	const float3 NaturalCoverage = saturate(max(NaturalBoundsExtent, 1.0) / max(BoundsExtent, 1.0));
	const float NaturalCoverageMax = max(max(NaturalCoverage.x, NaturalCoverage.y), NaturalCoverage.z);
	return clamp(max(0.90, NaturalCoverageMax + 0.04), 0.82, 0.96);
}

float ComputeCompositeBoundaryNoise(FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 SampleWorld)
{
	const float NoiseScale = max(Desc.BoundaryNoiseControls.x, 0.0);
	const float NoiseStrength = max(Desc.BoundaryNoiseControls.y, 0.0);
	if (NoiseScale <= 0.0 || NoiseStrength <= 0.0)
	{
		return 0.0;
	}

	const float AgeSeconds = Desc.FilamentAge.y;
	const float3 NoisePosition = SampleWorld * NoiseScale + float3(AgeSeconds * 0.011, -AgeSeconds * 0.007, AgeSeconds * 0.013);
	return (TimeThiefSmokeFBM(NoisePosition) - 0.5) * NoiseStrength;
}

struct FTimeThiefSmokeMediumSample
{
	float ExtinctionCoefficient;
	float3 ScatteringSource;
	float Density;
};

FTimeThiefSmokeMediumSample MakeEmptySmokeMediumSample()
{
	FTimeThiefSmokeMediumSample Sample;
	Sample.ExtinctionCoefficient = 0.0;
	Sample.ScatteringSource = float3(0.0, 0.0, 0.0);
	Sample.Density = 0.0;
	return Sample;
}

float EvaluateLowFrequencyShadowExtinction(
	int Slot,
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SimulationLocal,
	float3 VolumeUVW,
	float LightDistanceScale)
{
	const float3 BoundsExtent = max(Desc.BoundsExtent_RenderStepVoxelScale.xyz, 1.0);
	if (!TimeThiefSmokeInsideUVW(VolumeUVW) || !IsActiveBrick(Slot, Desc, VolumeUVW))
	{
		return 0.0;
	}

	const float4 RawFields = SampleFieldSet(Slot, Desc, VolumeUVW);
	const float RawDensity = max(RawFields.x, 0.0);
	if (RawDensity <= 0.0001)
	{
		return 0.0;
	}

	const FTimeThiefSmokeBulletOpenMasks BulletMasks = TimeThiefSmokeBulletOpenMasksFromValues(RawFields.z, RawFields.w);
	const float Obstacle = SampleObstacleTexture(Slot, VolumeUVW);
	const float ObstacleOpen = TimeThiefSmokeObstacleOpenFromSdf(Obstacle, Desc.NaturalBoundsExtent_ObstacleFeather.w);
	const float BoundaryFadeStart = ComputeRenderBoundaryFadeStart(BoundsExtent, Desc.NaturalBoundsExtent_ObstacleFeather.xyz);
	const float EllipsoidDistance = length(SimulationLocal / float3(1.0, 1.0, 0.86));
	const float BoundaryMask = 1.0 - smoothstep(BoundaryFadeStart, 1.0, EllipsoidDistance);
	const float LifetimeAlpha = 1.0 - smoothstep(Desc.FilamentAge.z, Desc.FilamentAge.z + max(Desc.FilamentAge.w, 0.001), Desc.FilamentAge.y);
	const float LowFrequencyDensity = RawDensity * ObstacleOpen * BulletMasks.Hard * BoundaryMask * LifetimeAlpha;
	return max(LowFrequencyDensity, 0.0) * LightDistanceScale;
}

FTimeThiefSmokeMediumSample EvaluateSmokeMedium(
	int Slot,
	FTimeThiefSmokeCompositeDescriptorShaderData Desc,
	float3 SampleWorld,
	float3 BoundsExtent,
	float3 SimulationLocal,
	float3 VolumeUVW,
	float3 SmokeColor,
	float SimulationDistanceScale,
	float MaxGridCellSize,
	float BoundaryFadeStart,
	float LifetimeAlpha)
{
	FTimeThiefSmokeMediumSample Sample = MakeEmptySmokeMediumSample();
	const float4 RawFields = SampleFieldSet(Slot, Desc, VolumeUVW);
	const float RawDensity = max(RawFields.x, 0.0);
	if (RawDensity <= 0.0001)
	{
		return Sample;
	}

	const float Obstacle = SampleObstacleTexture(Slot, VolumeUVW);
	const FTimeThiefSmokeBulletOpenMasks BulletMasks = TimeThiefSmokeBulletOpenMasksFromValues(RawFields.z, RawFields.w);
	const float ObstacleOpen = TimeThiefSmokeObstacleOpenFromSdf(Obstacle, Desc.NaturalBoundsExtent_ObstacleFeather.w);
	const float EllipsoidDistance = length(SimulationLocal / float3(1.0, 1.0, 0.86));
	float BoundaryNoise = 0.0;
#if TIME_THIEF_COMPOSITE_BOUNDARY_SHELL_GATE
	const float MaximumBoundaryOffset = abs(Desc.BoundaryNoiseControls.y) * 0.5;
	if (EllipsoidDistance >= BoundaryFadeStart - MaximumBoundaryOffset - 0.02)
	{
		BoundaryNoise = ComputeCompositeBoundaryNoise(Desc, SampleWorld);
	}
#else
	BoundaryNoise = ComputeCompositeBoundaryNoise(Desc, SampleWorld);
#endif
	const float BoundaryMask = 1.0 - smoothstep(BoundaryFadeStart, 1.0, EllipsoidDistance + BoundaryNoise);
	const float AgeSeconds = Desc.FilamentAge.y;
	const float DensityVisibility = ObstacleOpen * BulletMasks.Hard * BoundaryMask * LifetimeAlpha;
	float Density = RawDensity * DensityVisibility;
	if (Density <= 0.0001)
	{
		return Sample;
	}

	const float RenderNoiseScale = Desc.ScatterNoise.z;
	const float RenderNoiseStrength = Desc.ScatterNoise.w;
	const float RenderNoiseTimeScale = Desc.NoiseFilamentA.x;
	const float RenderFilamentScale = Desc.NoiseFilamentA.y;
	const float RenderFilamentStrength = Desc.NoiseFilamentA.z;
	const float RenderFilamentContrast = Desc.NoiseFilamentA.w;
	const float RenderFilamentWarpStrength = Desc.FilamentAge.x;
	const float MaxResolvedBaseNoiseScale = 0.9 / MaxGridCellSize;
	const float MaxResolvedFineNoiseScale = 1.15 / MaxGridCellSize;
	const float StableRenderNoiseScale = min(max(RenderNoiseScale, 0.0), MaxResolvedBaseNoiseScale);
	const float StableRenderFilamentScale = min(max(RenderFilamentScale, 0.0), MaxResolvedBaseNoiseScale);
	const float FineNoiseMultiplier = min(1.86, MaxResolvedFineNoiseScale / max(StableRenderNoiseScale, 0.0001));
	const float FineFilamentMultiplier = min(1.9, MaxResolvedFineNoiseScale / max(StableRenderFilamentScale, 0.0001));
	const float TimeNoise = AgeSeconds * RenderNoiseTimeScale;
	const float3 NoisePosition = SimulationLocal * BoundsExtent * StableRenderNoiseScale;
	const float DensityNoise = TimeThiefSmokeRenderDensityNoise(
		NoisePosition,
		TimeNoise,
		RawDensity,
		BoundaryMask,
		RenderNoiseStrength,
		FineNoiseMultiplier);

	float FilamentGain = 1.0;
	const float EdgeFilamentGate = smoothstep(0.38, 0.98, EllipsoidDistance);
	const float FilamentDensityGate = smoothstep(0.025, 0.16, RawDensity) * (1.0 - smoothstep(0.92, 1.85, RawDensity));
	const float FilamentInfluence = saturate(EdgeFilamentGate * FilamentDensityGate);
	if (RenderFilamentStrength > 0.001 && FilamentInfluence > 0.015)
	{
		const float3 FilamentPosition = SimulationLocal * BoundsExtent * StableRenderFilamentScale;
		const float3 FilamentWarpBase = TimeThiefSmokeDomainWarp(FilamentPosition * 0.43, TimeNoise * 0.72) * RenderFilamentWarpStrength;
		float3 FilamentWarp = FilamentWarpBase;
		float FilamentMask = 0.0;
#if TIME_THIEF_COMPOSITE_FAST_FILAMENT
		FilamentMask = TimeThiefSmokeFastFilamentMask(FilamentPosition + FilamentWarp, TimeNoise, RenderFilamentContrast);
#else
		FilamentMask = TimeThiefSmokeFilamentMask(FilamentPosition + FilamentWarp, TimeNoise, RenderFilamentContrast);
#endif
		float CombinedFilamentMask = FilamentMask;
		float AirPocket = 0.5;
#if !TIME_THIEF_COMPOSITE_FAST_FILAMENT
		if (Desc.RenderSteps_Quality.z > 0.5 && FilamentInfluence > 0.24 && RenderFilamentStrength > 1.05)
		{
			const float FineRidge = TimeThiefSmokeRidgedFBM(FilamentPosition * FineFilamentMultiplier - FilamentWarp * 0.36 + TimeNoise * 0.91);
			CombinedFilamentMask = saturate(FilamentMask * 0.78 + pow(saturate(FineRidge), max(RenderFilamentContrast * 0.92, 0.1)) * 0.28);
			AirPocket = TimeThiefSmokeFBM(FilamentPosition * 0.37 - FilamentWarp * 0.42 + TimeNoise * 0.37);
		}
#endif
		const float FilamentLow = max(0.38, 1.0 - RenderFilamentStrength * (0.18 + AirPocket * 0.28));
		const float FilamentHigh = 1.0 + RenderFilamentStrength * 0.48;
		FilamentGain = lerp(FilamentLow, FilamentHigh, CombinedFilamentMask);
	}

	const float BulletEdgeDensityGain = lerp(1.0, 1.16, BulletMasks.Edge);
	const float DetailGain = clamp(
		DensityNoise * lerp(1.0, FilamentGain, FilamentInfluence),
		RenderDetailGainMin,
		RenderDetailGainMax);
	Density = Density * DetailGain * BulletEdgeDensityGain;
	Sample.ExtinctionCoefficient = max(Density * Desc.RenderBoundsExtent_Extinction.w * SimulationDistanceScale, 0.0);
	Sample.ScatteringSource = SmokeColor * saturate(0.82 + Density * 0.85);
	Sample.Density = Density;
	return Sample;
}

float AlignStableRaySample(float SegmentStart, float StepLength, float PixelPhase)
{
	return (ceil(SegmentStart / StepLength - PixelPhase) + PixelPhase) * StepLength;
}

float3 CompositeDebugHeatColor(float Value)
{
	const float T = saturate(Value);
	return saturate(float3(T * 2.0, 1.0 - abs(T * 2.0 - 1.0), (1.0 - T) * 2.0));
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const int2 PixelCoord = int2(SvPosition.xy) - TileRectMin;
	const int2 TileCoord = clamp(PixelCoord / max(CompositeTileSize, 1), int2(0, 0), TileGridSize - 1);
	const int TileIndex = TileCoord.y * TileGridSize.x + TileCoord.x;
	const FTimeThiefSmokeCompositeTileRangeShaderData TileRange = TileSmokeRanges[TileIndex];
	const int TileOffset = (int)round(TileRange.OffsetCount.x);
	const int TileSmokeCount = min((int)round(TileRange.OffsetCount.y), TIME_THIEF_MAX_COMPOSITE_SMOKES);
	if (TileSmokeCount <= 0)
	{
#if TIME_THIEF_COMPOSITE_HALF_RESOLUTION
		OutColor = float4(0.0, 0.0, 0.0, 1.0);
#else
		const float2 EmptySceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
		OutColor = SceneColorTexture.SampleLevel(SceneColorSampler, EmptySceneUV, 0.0);
#endif
		return;
	}
#if TIME_THIEF_COMPOSITE_HALF_RESOLUTION
	const float4 SceneColor = float4(0.0, 0.0, 0.0, 1.0);
#else
	const float2 SceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, SceneUV, 0.0);
#endif

	const float SceneDeviceZ = LoadSceneDeviceZ(SvPosition.xy);
	const float3 NearWorld = ReconstructWorldPosition(SvPosition.xy, 1.0);
	const float3 FarWorld = ReconstructWorldPosition(SvPosition.xy, 0.0);
	const bool bHasOpaqueSceneDepth = SceneDeviceZ > 0.000001;
	const float3 SceneWorld = bHasOpaqueSceneDepth ? ReconstructWorldPosition(SvPosition.xy, SceneDeviceZ) : FarWorld;
	const float3 WorldRayDirection = normalize(FarWorld - NearWorld);
	const float3 WorldLightDirection = normalize(CombinedShadowLightDirection + float3(0.0, 0.0, 0.0001));
	const float SceneT = max(dot(SceneWorld - NearWorld, WorldRayDirection), 0.0);

	float SmokeTMin[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeTMax[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeColors[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalOrigins[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalRayDirections[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeBoundsExtents[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeRayUVWDirections[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeSimulationStepScales[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeMaxGridCellSizes[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeBoundaryFadeStarts[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeLifetimeAlphas[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float3 SmokeLocalLightDirections[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	float SmokeLightDistanceScales[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	int SmokeSlots[TIME_THIEF_MAX_COMPOSITE_SMOKES];
	int ActiveSmokeCount = 0;
	float RayStart = SceneT;
	float RayEnd = 0.0;
	float RaymarchMaxSkipScale = 1.0;
	float TransmittanceEarlyOut = 0.0;

	[loop]
	for (int TileSmokeIndex = 0; TileSmokeIndex < TileSmokeCount; ++TileSmokeIndex)
	{
		const int Slot = (int)TileSmokeIndices[TileOffset + TileSmokeIndex];
		if (Slot < 0 || Slot >= SmokeSlotCount || ActiveSmokeCount >= TIME_THIEF_MAX_COMPOSITE_SMOKES)
		{
			continue;
		}

		const FTimeThiefSmokeCompositeDescriptorShaderData Desc = CompositeSmokeDescriptors[Slot];
		const float4x4 WorldToLocal = GetWorldToLocal(Desc);
		const float3 RenderBoundsExtent = max(Desc.RenderBoundsExtent_Extinction.xyz, 1.0);
		const float3 LocalNear = mul(float4(NearWorld, 1.0), WorldToLocal).xyz;
		const float3 LocalRayDirection = mul(float4(WorldRayDirection, 0.0), WorldToLocal).xyz;
		const float3 LocalOrigin = LocalNear / RenderBoundsExtent;
		const float3 LocalDirection = LocalRayDirection / RenderBoundsExtent;
		float TMin = 0.0;
		float TMax = 0.0;
		if (!IntersectUnitBox(LocalOrigin, LocalDirection, TMin, TMax))
		{
			continue;
		}

		TMin = max(TMin, 0.0);
		TMax = min(TMax, SceneT);
		if (TMax <= TMin)
		{
			continue;
		}

		const float3 BoundsExtent = max(Desc.BoundsExtent_RenderStepVoxelScale.xyz, 1.0);
		const float3 SimulationRayDirection = LocalRayDirection / BoundsExtent;
		const int3 GridResolution = GetGridResolution(Desc);
		const float3 GridCellSize = max((BoundsExtent * 2.0) / max(float3(GridResolution), 1.0), 1.0);
		const float MaxGridCellSize = max(max(GridCellSize.x, GridCellSize.y), GridCellSize.z);
		const float BoundaryFadeStart = ComputeRenderBoundaryFadeStart(BoundsExtent, Desc.NaturalBoundsExtent_ObstacleFeather.xyz);
		const float LifetimeAlpha = 1.0 - smoothstep(Desc.FilamentAge.z, Desc.FilamentAge.z + max(Desc.FilamentAge.w, 0.001), Desc.FilamentAge.y);
		RaymarchMaxSkipScale = max(RaymarchMaxSkipScale, Desc.RaymarchControls.x);
		TransmittanceEarlyOut = max(TransmittanceEarlyOut, Desc.RaymarchControls.y);
		SmokeTMin[ActiveSmokeCount] = TMin;
		SmokeTMax[ActiveSmokeCount] = TMax;
		SmokeColors[ActiveSmokeCount] = SmokeColorFromDescriptor(Desc, WorldRayDirection);
		SmokeLocalOrigins[ActiveSmokeCount] = LocalNear;
		SmokeLocalRayDirections[ActiveSmokeCount] = LocalRayDirection;
		SmokeBoundsExtents[ActiveSmokeCount] = BoundsExtent;
		SmokeRayUVWDirections[ActiveSmokeCount] = SimulationRayDirection * 0.5;
		SmokeSimulationStepScales[ActiveSmokeCount] = length(SimulationRayDirection);
		SmokeMaxGridCellSizes[ActiveSmokeCount] = MaxGridCellSize;
		SmokeBoundaryFadeStarts[ActiveSmokeCount] = BoundaryFadeStart;
		SmokeLifetimeAlphas[ActiveSmokeCount] = LifetimeAlpha;
		SmokeLocalLightDirections[ActiveSmokeCount] = mul(float4(WorldLightDirection, 0.0), WorldToLocal).xyz;
		SmokeLightDistanceScales[ActiveSmokeCount] = length(SmokeLocalLightDirections[ActiveSmokeCount] / BoundsExtent);
		SmokeSlots[ActiveSmokeCount] = Slot;
		++ActiveSmokeCount;
		RayStart = min(RayStart, TMin);
		RayEnd = max(RayEnd, TMax);
	}

	if (ActiveSmokeCount <= 0 || RayEnd <= RayStart)
	{
#if TIME_THIEF_COMPOSITE_HALF_RESOLUTION
		OutColor = float4(0.0, 0.0, 0.0, 1.0);
#else
		OutColor = SceneColor;
#endif
		return;
	}

	float SegmentBoundaries[TIME_THIEF_MAX_SEGMENT_BOUNDARIES];
	int SegmentBoundaryCount = 0;
	SegmentBoundaries[SegmentBoundaryCount++] = RayStart;
	SegmentBoundaries[SegmentBoundaryCount++] = RayEnd;
	[loop]
	for (int SmokeIndex = 0; SmokeIndex < ActiveSmokeCount; ++SmokeIndex)
	{
		SegmentBoundaries[SegmentBoundaryCount++] = clamp(SmokeTMin[SmokeIndex], RayStart, RayEnd);
		SegmentBoundaries[SegmentBoundaryCount++] = clamp(SmokeTMax[SmokeIndex], RayStart, RayEnd);
	}
	[loop]
	for (int BoundaryIndex = 1; BoundaryIndex < SegmentBoundaryCount; ++BoundaryIndex)
	{
		const float Boundary = SegmentBoundaries[BoundaryIndex];
		int SortedIndex = BoundaryIndex - 1;
		[loop]
		while (SortedIndex >= 0 && SegmentBoundaries[SortedIndex] > Boundary)
		{
			SegmentBoundaries[SortedIndex + 1] = SegmentBoundaries[SortedIndex];
			--SortedIndex;
		}
		SegmentBoundaries[SortedIndex + 1] = Boundary;
	}

	const float StepSize = max(RenderWorldStepLength, 1.0);
	const float PixelPhase = BlueNoiseScalar(uint2(SvPosition.xy), BlueNoiseFrameIndex);
	float Transmittance = 1.0;
	float3 SmokeColorAccum = float3(0.0, 0.0, 0.0);
	float DebugMaxCombinedExtinction = 0.0;
	float DebugMinCombinedShadow = 1.0;
	int ResolvedStableStepCount = 0;
	int StableSampleCount = 0;
	int SegmentCount = 0;
	int SparseSkippedStepCount = 0;
	int CombinedMediumSampleCount = 0;
	int CombinedShadowEvaluationCount = 0;
	int TotalLoopCount = 0;
	[loop]
	for (int SegmentIndex = 0; SegmentIndex < SegmentBoundaryCount - 1 && TotalLoopCount < TIME_THIEF_MAX_STABLE_STEPS; ++SegmentIndex)
	{
		const float SegmentStart = SegmentBoundaries[SegmentIndex];
		const float SegmentEnd = SegmentBoundaries[SegmentIndex + 1];
		if (SegmentEnd <= SegmentStart)
		{
			continue;
		}

		int SegmentSmokeIndices[TIME_THIEF_MAX_COMPOSITE_SMOKES];
		int SegmentSmokeCount = 0;
		[loop]
		for (int SmokeIndex = 0; SmokeIndex < ActiveSmokeCount; ++SmokeIndex)
		{
			if (SegmentStart < SmokeTMax[SmokeIndex] && SegmentEnd > SmokeTMin[SmokeIndex] && SegmentSmokeCount < TIME_THIEF_MAX_COMPOSITE_SMOKES)
			{
				SegmentSmokeIndices[SegmentSmokeCount++] = SmokeIndex;
			}
		}
		if (SegmentSmokeCount <= 0)
		{
			continue;
		}

		++SegmentCount;
		float CurrentT = AlignStableRaySample(SegmentStart, StepSize, PixelPhase);
		if (CurrentT < SegmentEnd)
		{
			ResolvedStableStepCount += (int)ceil((SegmentEnd - CurrentT) / StepSize);
		}
		[loop]
		while (TotalLoopCount < TIME_THIEF_MAX_STABLE_STEPS && CurrentT < SegmentEnd)
		{
			const float3 SampleWorld = NearWorld + WorldRayDirection * CurrentT;
			bool bSawInactiveCandidate = false;
			bool bSawActiveCandidate = false;
			float InactiveSkip = StepSize * RaymarchMaxSkipScale;
			float TotalExtinctionCoefficient = 0.0;
			float3 TotalScatteringSource = float3(0.0, 0.0, 0.0);

			[loop]
			for (int SegmentSmokeIndex = 0; SegmentSmokeIndex < SegmentSmokeCount; ++SegmentSmokeIndex)
			{
				const int SmokeIndex = SegmentSmokeIndices[SegmentSmokeIndex];
				if (CurrentT < SmokeTMin[SmokeIndex] || CurrentT > SmokeTMax[SmokeIndex])
				{
					continue;
				}

				const int Slot = SmokeSlots[SmokeIndex];
				const FTimeThiefSmokeCompositeDescriptorShaderData Desc = CompositeSmokeDescriptors[Slot];
				const float3 BoundsExtent = SmokeBoundsExtents[SmokeIndex];
				const float3 SampleLocal = SmokeLocalOrigins[SmokeIndex] + SmokeLocalRayDirections[SmokeIndex] * CurrentT;
				const float3 SimulationLocal = SampleLocal / BoundsExtent;
				const float3 VolumeUVW = SimulationLocal * 0.5 + 0.5;
				if (!TimeThiefSmokeInsideUVW(VolumeUVW))
				{
					continue;
				}

				if (!IsActiveBrick(Slot, Desc, VolumeUVW))
				{
					InactiveSkip = min(InactiveSkip, ComputeInactiveBrickSkip(Desc, Slot, VolumeUVW, SmokeRayUVWDirections[SmokeIndex], StepSize));
					bSawInactiveCandidate = true;
					continue;
				}

				bSawActiveCandidate = true;
				const FTimeThiefSmokeMediumSample MediumSample = EvaluateSmokeMedium(
					Slot,
					Desc,
					SampleWorld,
					BoundsExtent,
					SimulationLocal,
					VolumeUVW,
					SmokeColors[SmokeIndex],
					SmokeSimulationStepScales[SmokeIndex],
					SmokeMaxGridCellSizes[SmokeIndex],
					SmokeBoundaryFadeStarts[SmokeIndex],
					SmokeLifetimeAlphas[SmokeIndex]);
				++CombinedMediumSampleCount;
				TotalExtinctionCoefficient += MediumSample.ExtinctionCoefficient;
				TotalScatteringSource += MediumSample.ExtinctionCoefficient * MediumSample.ScatteringSource;
			}

			++StableSampleCount;
			++TotalLoopCount;
			DebugMaxCombinedExtinction = max(DebugMaxCombinedExtinction, TotalExtinctionCoefficient);
			if (TotalExtinctionCoefficient > 0.000001)
			{
				const float StepOpticalDepth = TotalExtinctionCoefficient * StepSize;
				const float StepTransmittance = exp2(-StepOpticalDepth * 1.442695);
				const float SampleWeight = Transmittance * (1.0 - StepTransmittance);
				float CombinedShadow = 1.0;
				if (SampleWeight > SelfShadowMinSampleWeight && CombinedShadowStepCount > 0 && CombinedShadowStrength > 0.001 && CombinedShadowExtinction > 0.001)
				{
					float ShadowOpticalDepth = 0.0;
					[loop]
					for (int ShadowStepIndex = 1; ShadowStepIndex <= CombinedShadowStepCount; ++ShadowStepIndex)
					{
						float ShadowStepExtinction = 0.0;
						[loop]
						for (int ShadowSmokeIndex = 0; ShadowSmokeIndex < ActiveSmokeCount; ++ShadowSmokeIndex)
						{
							const int ShadowSlot = SmokeSlots[ShadowSmokeIndex];
							const float3 ShadowBoundsExtent = SmokeBoundsExtents[ShadowSmokeIndex];
							const float3 ShadowLocal =
								SmokeLocalOrigins[ShadowSmokeIndex] +
								SmokeLocalRayDirections[ShadowSmokeIndex] * CurrentT +
								SmokeLocalLightDirections[ShadowSmokeIndex] * (CombinedShadowStepLength * (float)ShadowStepIndex);
							const float3 ShadowSimulationLocal = ShadowLocal / ShadowBoundsExtent;
							ShadowStepExtinction += EvaluateLowFrequencyShadowExtinction(
								ShadowSlot,
								CompositeSmokeDescriptors[ShadowSlot],
								ShadowSimulationLocal,
								ShadowSimulationLocal * 0.5 + 0.5,
								SmokeLightDistanceScales[ShadowSmokeIndex]);
						}
						ShadowOpticalDepth += ShadowStepExtinction * CombinedShadowStepLength;
					}

					ShadowOpticalDepth *= CombinedShadowExtinction;
					const float ShadowTransmittance = exp2(-ShadowOpticalDepth * 1.442695);
					CombinedShadow = saturate(lerp(1.0, ShadowTransmittance, CombinedShadowStrength));
					++CombinedShadowEvaluationCount;
				}

				DebugMinCombinedShadow = min(DebugMinCombinedShadow, CombinedShadow);
				const float3 CombinedScatteringSource = TotalScatteringSource / TotalExtinctionCoefficient;
				const float3 DirectLighting = CombinedScatteringSource * CombinedShadow;
				const float3 MultipleScattering = lerp(DirectLighting, sqrt(saturate(DirectLighting)), saturate(MultipleScatteringStrength));
				const float PowderDepth = 1.0 - StepTransmittance;
				const float3 LocalFill = CombinedScatteringSource * (
					saturate(PowderDepth) * max(PowderEffectStrength, 0.0) +
					max(AmbientFillStrength, 0.0));
				SmokeColorAccum += SampleWeight * (MultipleScattering + LocalFill);
				Transmittance *= StepTransmittance;
			}

			if (Transmittance < TransmittanceEarlyOut)
			{
				break;
			}

			int AdvanceStepCount = 1;
			if (!bSawActiveCandidate && bSawInactiveCandidate)
			{
				AdvanceStepCount = max(1, (int)ceil(InactiveSkip / StepSize));
				SparseSkippedStepCount += AdvanceStepCount - 1;
			}
			CurrentT += (float)AdvanceStepCount * StepSize;
		}

		if (Transmittance < TransmittanceEarlyOut)
		{
			break;
		}
	}

#if TIME_THIEF_COMPOSITE_STEP_STATS
	InterlockedMax(CompositeStepStats[0], (uint)max(TIME_THIEF_MAX_STABLE_STEPS - ResolvedStableStepCount, 0));
	InterlockedMax(CompositeStepStats[1], (uint)ResolvedStableStepCount);
	InterlockedAdd(CompositeStepStats[2], (uint)ResolvedStableStepCount);
	InterlockedAdd(CompositeStepStats[3], 1u);
	InterlockedMax(CompositeStepStats[4], (uint)max(TIME_THIEF_MAX_STABLE_STEPS - StableSampleCount, 0));
	InterlockedMax(CompositeStepStats[5], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[6], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[7], 1u);
	InterlockedAdd(CompositeStepStats[8], (uint)SegmentCount);
	InterlockedAdd(CompositeStepStats[9], (uint)StableSampleCount);
	InterlockedAdd(CompositeStepStats[10], (uint)SparseSkippedStepCount);
	InterlockedAdd(CompositeStepStats[11], (uint)CombinedMediumSampleCount);
	InterlockedAdd(CompositeStepStats[12], (uint)CombinedShadowEvaluationCount);
	const uint SamplePhaseHash = asuint(PixelPhase) ^ ((uint)PixelCoord.x * 73856093u) ^ ((uint)PixelCoord.y * 19349663u);
	InterlockedXor(CompositeStepStats[13], SamplePhaseHash);
	InterlockedMax(CompositeStepStats[14], (uint)ActiveSmokeCount);
	InterlockedMax(CompositeStepStats[15], 1u);
#endif

	if (CompositeDebugMode > 0)
	{
		float3 DebugColor = float3(0.0, 0.0, 0.0);
		if (CompositeDebugMode == 1)
		{
			DebugColor = CompositeDebugHeatColor((float)ActiveSmokeCount / (float)TIME_THIEF_MAX_COMPOSITE_SMOKES);
		}
		else if (CompositeDebugMode == 2)
		{
			DebugColor = PixelPhase.xxx;
		}
		else if (CompositeDebugMode == 3)
		{
			DebugColor = CompositeDebugHeatColor(saturate(DebugMaxCombinedExtinction * StepSize));
		}
		else if (CompositeDebugMode == 4)
		{
			DebugColor = DebugMinCombinedShadow.xxx;
		}
		else
		{
			const float SmokeIdColor = frac(abs(CompositeSmokeDescriptors[SmokeSlots[0]].BoundaryNoiseControls.z) * 0.61803398875);
			DebugColor = float3(SmokeIdColor, frac(SmokeIdColor + 0.3333), frac(SmokeIdColor + 0.6667));
		}
#if TIME_THIEF_COMPOSITE_HALF_RESOLUTION
		OutColor = float4(DebugColor, 0.0);
#else
		OutColor = float4(DebugColor, 1.0);
#endif
		return;
	}

	const float3 SmokeContribution = SmokeColorAccum;
#if TIME_THIEF_COMPOSITE_HALF_RESOLUTION
	OutColor = float4(SmokeContribution, Transmittance);
#else
	const float3 Composited = SceneColor.rgb * Transmittance + SmokeContribution;
	OutColor = float4(Composited, SceneColor.a);
#endif
}

void BilateralUpsampleMainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 SceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, SceneUV, 0.0);
	const float SceneDeviceZ = LoadSceneDeviceZ(SvPosition.xy);

	const float2 ScreenUV = (SvPosition.xy - float2(ViewRect.xy)) / max(float2(ViewRect.zw - ViewRect.xy), 1.0);

	const float2 HalfResTexel = ScreenUV * HalfResSize - 0.5;
	const int2 CenterCoord = clamp(int2(round(HalfResTexel)), int2(0, 0), int2(HalfResSize) - 1);
	const float CenterTransmittance = HalfResSmokeTexture.Load(int3(CenterCoord, 0)).a;
	float4 SmokeSum = 0.0;
	float WeightSum = 0.0;
	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			const int2 SampleCoord = clamp(CenterCoord + int2(X, Y), int2(0, 0), int2(HalfResSize) - 1);
			const float4 SmokeSample = HalfResSmokeTexture.Load(int3(SampleCoord, 0));
			const float2 SamplePosition = float2(ViewRect.xy) + (float2(SampleCoord) + 0.5) * 2.0;
			const float SampleDepth = LoadSceneDeviceZ(SamplePosition);
			const float DepthDifference = SceneDeviceZ - SampleDepth;
			const float DepthWeight = 1.0 / (1.0 + DepthDifference * DepthDifference * BilateralDepthSensitivity);
			const float TransmittanceWeight = exp2(-abs(CenterTransmittance - SmokeSample.a) * BilateralTransmittanceSensitivity);
			const float2 SpatialOffset = HalfResTexel - float2(SampleCoord);
			const float SpatialWeight = exp2(-dot(SpatialOffset, SpatialOffset));
			const float Weight = SpatialWeight * DepthWeight * TransmittanceWeight;
			SmokeSum += SmokeSample * Weight;
			WeightSum += Weight;
		}
	}

	const float4 UpsampledSmoke = WeightSum > 0.00001
		? SmokeSum / WeightSum
		: HalfResSmokeTexture.Load(int3(CenterCoord, 0));

	const float3 SmokeColor = UpsampledSmoke.rgb;
	const float Transmittance = UpsampledSmoke.a;

	const float3 Composited = SceneColor.rgb * Transmittance + SmokeColor;
	OutColor = float4(Composited, SceneColor.a);
}

struct FTimeThiefSmokeTemporalOutput
{
	float4 Smoke : SV_Target0;
	float Depth : SV_Target1;
};

FTimeThiefSmokeTemporalOutput TemporalMainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION)
{
	FTimeThiefSmokeTemporalOutput Output;
	const int2 MaxCoord = max(SmokeTextureSize - 1, int2(0, 0));
	const int2 CurrentCoord = clamp(int2(SvPosition.xy), int2(0, 0), MaxCoord);
	const float4 CurrentSmoke = CurrentSmokeTexture.Load(int3(CurrentCoord, 0));
	const float2 FullResPixel = float2(ViewRect.xy) + (float2(CurrentCoord) + 0.5) * SmokeToViewScale;
	const float CurrentDepth = LoadSceneDeviceZ(FullResPixel);
	float4 FilteredSmoke = CurrentSmoke;

	if (TemporalHistoryValid != 0 && TemporalHistoryWeight > 0.001)
	{
		const float3 WorldPosition = ReconstructWorldPosition(FullResPixel, CurrentDepth);
		const float4 PreviousClip = mul(float4(WorldPosition, 1.0), PrevViewProjection);
		const float SafeW = abs(PreviousClip.w) > 0.000001 ? PreviousClip.w : 0.000001;
		const float2 PreviousNdc = PreviousClip.xy / SafeW;
		const float2 PreviousUV = float2(PreviousNdc.x * 0.5 + 0.5, 0.5 - PreviousNdc.y * 0.5);
		const bool bInsideHistory = PreviousClip.w > 0.0 && all(PreviousUV >= 0.0) && all(PreviousUV <= 1.0);
		if (bInsideHistory)
		{
			const int2 HistoryCoord = clamp(int2(PreviousUV * float2(SmokeTextureSize)), int2(0, 0), MaxCoord);
			const float4 RawHistorySmoke = HistorySmokeTexture.SampleLevel(SceneColorSampler, PreviousUV, 0.0);
			const float HistoryDepth = HistoryDepthTexture.Load(int3(HistoryCoord, 0));
			float4 NeighborhoodMin = CurrentSmoke;
			float4 NeighborhoodMax = CurrentSmoke;
			[unroll]
			for (int Y = -1; Y <= 1; ++Y)
			{
				[unroll]
				for (int X = -1; X <= 1; ++X)
				{
					const int2 NeighborCoord = clamp(CurrentCoord + int2(X, Y), int2(0, 0), MaxCoord);
					const float4 NeighborSmoke = CurrentSmokeTexture.Load(int3(NeighborCoord, 0));
					NeighborhoodMin = min(NeighborhoodMin, NeighborSmoke);
					NeighborhoodMax = max(NeighborhoodMax, NeighborSmoke);
				}
			}

			const bool bDepthValid = abs(CurrentDepth - HistoryDepth) <= TemporalDepthThreshold;
			const bool bExtinctionValid = abs(CurrentSmoke.a - RawHistorySmoke.a) <= TemporalTransmittanceThreshold;
			if (bDepthValid && bExtinctionValid)
			{
				const float4 ClampedHistorySmoke = clamp(RawHistorySmoke, NeighborhoodMin, NeighborhoodMax);
				FilteredSmoke = lerp(CurrentSmoke, ClampedHistorySmoke, saturate(TemporalHistoryWeight));
			}
		}
	}

	Output.Smoke = FilteredSmoke;
	Output.Depth = CurrentDepth;
	return Output;
}
