float3 ReconstructWorldPosition(float2 PixelPosition, float DeviceZ)
{
	const float2 ViewSize = max(float2(ViewRect.zw - ViewRect.xy), 1.0);
	const float2 UV = (PixelPosition - float2(ViewRect.xy)) / ViewSize;
	const float2 NDC = float2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
	float4 World = mul(float4(NDC, DeviceZ, 1.0), InvViewProjection);
	const float SafeW = abs(World.w) > 0.000001 ? World.w : (World.w < 0.0 ? -0.000001 : 0.000001);
	return World.xyz / SafeW;
}

float LoadSceneDeviceZ(float2 PixelPosition)
{
	const float2 DepthPixelPosition = PixelPosition * SceneDepthPixelScaleBias.xy + SceneDepthPixelScaleBias.zw;
	const int2 DepthMin = SceneDepthViewRect.xy;
	const int2 DepthMax = max(SceneDepthViewRect.xy, SceneDepthViewRect.zw - 1);
	const int2 DepthPixel = clamp((int2)floor(DepthPixelPosition), DepthMin, DepthMax);
	return SceneDepthTexture.Load(int3(DepthPixel, 0)).r;
}

bool IntersectUnitBox(float3 Origin, float3 Direction, out float TMin, out float TMax)
{
	const float3 DirectionSign = lerp(float3(-1.0, -1.0, -1.0), float3(1.0, 1.0, 1.0), step(float3(0.0, 0.0, 0.0), Direction));
	const float3 InvDirection = 1.0 / (Direction + DirectionSign * 0.000001);
	const float3 T0 = (-1.0 - Origin) * InvDirection;
	const float3 T1 = (1.0 - Origin) * InvDirection;
	const float3 TSmall = min(T0, T1);
	const float3 TBig = max(T0, T1);
	TMin = max(max(TSmall.x, TSmall.y), TSmall.z);
	TMax = min(min(TBig.x, TBig.y), TBig.z);
	return TMax >= max(TMin, 0.0);
}

float4x4 MakeMatrix(float4 Row0, float4 Row1, float4 Row2, float4 Row3)
{
	return float4x4(
		Row0.x, Row0.y, Row0.z, Row0.w,
		Row1.x, Row1.y, Row1.z, Row1.w,
		Row2.x, Row2.y, Row2.z, Row2.w,
		Row3.x, Row3.y, Row3.z, Row3.w);
}

float4x4 GetWorldToLocal(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return MakeMatrix(Desc.WorldToLocal0, Desc.WorldToLocal1, Desc.WorldToLocal2, Desc.WorldToLocal3);
}

float SampleObstacleTexture(int Slot, float3 UVW)
{
	switch (Slot)
	{
	case 0: return ObstacleTexture0.SampleLevel(VolumeSampler, UVW, 0.0);
	case 1: return ObstacleTexture1.SampleLevel(VolumeSampler, UVW, 0.0);
	case 2: return ObstacleTexture2.SampleLevel(VolumeSampler, UVW, 0.0);
	case 3: return ObstacleTexture3.SampleLevel(VolumeSampler, UVW, 0.0);
	case 4: return ObstacleTexture4.SampleLevel(VolumeSampler, UVW, 0.0);
	case 5: return ObstacleTexture5.SampleLevel(VolumeSampler, UVW, 0.0);
	case 6: return ObstacleTexture6.SampleLevel(VolumeSampler, UVW, 0.0);
	case 7: return ObstacleTexture7.SampleLevel(VolumeSampler, UVW, 0.0);
	}
	return 0.0;
}

float4 SamplePackedDenseFieldTexture(int Slot, float3 UVW)
{
	switch (Slot)
	{
	case 0: return PackedDenseFieldTexture0.SampleLevel(VolumeSampler, UVW, 0.0);
	case 1: return PackedDenseFieldTexture1.SampleLevel(VolumeSampler, UVW, 0.0);
	case 2: return PackedDenseFieldTexture2.SampleLevel(VolumeSampler, UVW, 0.0);
	case 3: return PackedDenseFieldTexture3.SampleLevel(VolumeSampler, UVW, 0.0);
	case 4: return PackedDenseFieldTexture4.SampleLevel(VolumeSampler, UVW, 0.0);
	case 5: return PackedDenseFieldTexture5.SampleLevel(VolumeSampler, UVW, 0.0);
	case 6: return PackedDenseFieldTexture6.SampleLevel(VolumeSampler, UVW, 0.0);
	case 7: return PackedDenseFieldTexture7.SampleLevel(VolumeSampler, UVW, 0.0);
	}
	return float4(0.0, 0.0, 0.0, 0.0);
}

float4 SamplePreviousPackedDenseFieldTexture(int Slot, float3 UVW)
{
	switch (Slot)
	{
	case 0: return PreviousPackedDenseFieldTexture0.SampleLevel(VolumeSampler, UVW, 0.0);
	case 1: return PreviousPackedDenseFieldTexture1.SampleLevel(VolumeSampler, UVW, 0.0);
	case 2: return PreviousPackedDenseFieldTexture2.SampleLevel(VolumeSampler, UVW, 0.0);
	case 3: return PreviousPackedDenseFieldTexture3.SampleLevel(VolumeSampler, UVW, 0.0);
	case 4: return PreviousPackedDenseFieldTexture4.SampleLevel(VolumeSampler, UVW, 0.0);
	case 5: return PreviousPackedDenseFieldTexture5.SampleLevel(VolumeSampler, UVW, 0.0);
	case 6: return PreviousPackedDenseFieldTexture6.SampleLevel(VolumeSampler, UVW, 0.0);
	case 7: return PreviousPackedDenseFieldTexture7.SampleLevel(VolumeSampler, UVW, 0.0);
	}
	return 0.0;
}

float4 SampleFieldSet(int Slot, FTimeThiefSmokeCompositeDescriptorShaderData Desc, float3 VolumeUVW)
{
	const float3 UVW = saturate(VolumeUVW);
#if TIME_THIEF_COMPOSITE_COST_MODE == 1
	return SamplePackedDenseFieldTexture(Slot, UVW);
#else
	return lerp(SamplePreviousPackedDenseFieldTexture(Slot, UVW), SamplePackedDenseFieldTexture(Slot, UVW), saturate(Desc.BoundaryNoiseControls.w));
#endif
}

