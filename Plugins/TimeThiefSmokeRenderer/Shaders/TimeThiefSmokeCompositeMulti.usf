float3 ReconstructWorldPosition(float2 PixelPosition, float DeviceZ)
{
	const float2 ViewSize = max(float2(ViewRect.zw - ViewRect.xy), 1.0);
	const float2 UV = (PixelPosition - float2(ViewRect.xy)) / ViewSize;
	const float2 NDC = float2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
	float4 World = mul(float4(NDC, DeviceZ, 1.0), InvViewProjection);
	const float SafeW = abs(World.w) > 0.000001 ? World.w : (World.w < 0.0 ? -0.000001 : 0.000001);
	return World.xyz / SafeW;
}

bool IntersectUnitBox(float3 Origin, float3 Direction, out float TMin, out float TMax)
{
	const float3 DirectionSign = lerp(float3(-1.0, -1.0, -1.0), float3(1.0, 1.0, 1.0), step(float3(0.0, 0.0, 0.0), Direction));
	const float3 InvDirection = 1.0 / (Direction + DirectionSign * 0.000001);
	const float3 T0 = (-1.0 - Origin) * InvDirection;
	const float3 T1 = (1.0 - Origin) * InvDirection;
	const float3 TSmall = min(T0, T1);
	const float3 TBig = max(T0, T1);
	TMin = max(max(TSmall.x, TSmall.y), TSmall.z);
	TMax = min(min(TBig.x, TBig.y), TBig.z);
	return TMax >= max(TMin, 0.0);
}

float4x4 MakeMatrix(float4 Row0, float4 Row1, float4 Row2, float4 Row3)
{
	return float4x4(
		Row0.x, Row0.y, Row0.z, Row0.w,
		Row1.x, Row1.y, Row1.z, Row1.w,
		Row2.x, Row2.y, Row2.z, Row2.w,
		Row3.x, Row3.y, Row3.z, Row3.w);
}

float4x4 GetLocalToWorld(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return MakeMatrix(Desc.LocalToWorld0, Desc.LocalToWorld1, Desc.LocalToWorld2, Desc.LocalToWorld3);
}

float4x4 GetWorldToLocal(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return MakeMatrix(Desc.WorldToLocal0, Desc.WorldToLocal1, Desc.WorldToLocal2, Desc.WorldToLocal3);
}

int3 GetGridResolution(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return max((int3)round(Desc.GridResolution_UseSparse.xyz), int3(1, 1, 1));
}

int3 GetBrickGridResolution(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return max((int3)round(Desc.BrickGridResolution_SmokeBrickSize.xyz), int3(1, 1, 1));
}

int3 GetSparseAtlasBrickGridResolution(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return max((int3)round(Desc.SparseAtlasBrickGridResolution_MaxActive.xyz), int3(1, 1, 1));
}

int GetSmokeBrickSize(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return max((int)round(Desc.BrickGridResolution_SmokeBrickSize.w), 1);
}

int GetMaxActiveSmokeBricks(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return max((int)round(Desc.SparseAtlasBrickGridResolution_MaxActive.w), 1);
}

uint UsesSparseAtlas(FTimeThiefSmokeCompositeDescriptorShaderData Desc)
{
	return round(Desc.GridResolution_UseSparse.w) > 0.5 ? 1u : 0u;
}

float SampleDensityTexture(int Slot, float3 UVW)
{
	switch (Slot)
	{
	case 0: return DensityTexture0.SampleLevel(VolumeSampler, UVW, 0.0);
	case 1: return DensityTexture1.SampleLevel(VolumeSampler, UVW, 0.0);
	case 2: return DensityTexture2.SampleLevel(VolumeSampler, UVW, 0.0);
	case 3: return DensityTexture3.SampleLevel(VolumeSampler, UVW, 0.0);
	case 4: return DensityTexture4.SampleLevel(VolumeSampler, UVW, 0.0);
	case 5: return DensityTexture5.SampleLevel(VolumeSampler, UVW, 0.0);
	case 6: return DensityTexture6.SampleLevel(VolumeSampler, UVW, 0.0);
	default: return DensityTexture6.SampleLevel(VolumeSampler, UVW, 0.0);
	}
}

