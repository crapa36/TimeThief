#include "/Engine/Public/Platform.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"

TIME_THIEF_SMOKE_BUILD_MAC_DIVERGENCE_PARAMETERS

bool IsSparseSimulationCellActive(uint3 CellCoord)
{
	if (bUseSparseSimulationMask == 0u)
	{
		return true;
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 BrickCoord = clamp(int3(CellCoord) / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	return BrickOccupancyTexture.Load(int4(BrickCoord, 0)) != 0u;
}

bool ResolveSmokeCellCoord(uint3 DispatchThreadId, uint3 GroupId, uint3 GroupThreadId, out uint3 OutCellCoord)
{
	if (bUseActiveBrickDispatch == 0u)
	{
		OutCellCoord = DispatchThreadId;
		return all(OutCellCoord < uint3(GridResolution));
	}

	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const uint ActiveBrickCount = min(ActiveBrickCountBuffer[0], (uint)max(MaxActiveSmokeBricks, 1));
	const uint GroupsPerBrickAxis = (uint)((SafeBrickSize + 3) / 4);
	const uint GroupsPerBrick = max(GroupsPerBrickAxis * GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const uint LocalGroupIndex = GroupId.x;
	const uint ActiveBrickIndex = GroupId.y;
	if (ActiveBrickIndex >= ActiveBrickCount || LocalGroupIndex >= GroupsPerBrick)
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint LocalGroupX = LocalGroupIndex % GroupsPerBrickAxis;
	const uint LocalGroupY = (LocalGroupIndex / GroupsPerBrickAxis) % GroupsPerBrickAxis;
	const uint LocalGroupZ = LocalGroupIndex / max(GroupsPerBrickAxis * GroupsPerBrickAxis, 1u);
	const int3 LocalCellCoord = int3(LocalGroupX, LocalGroupY, LocalGroupZ) * 4 + int3(GroupThreadId);
	if (any(LocalCellCoord >= int3(SafeBrickSize, SafeBrickSize, SafeBrickSize)))
	{
		OutCellCoord = uint3(0, 0, 0);
		return false;
	}

	const uint4 ActiveBrick = ActiveBricks[ActiveBrickIndex];
	const int3 BrickCoord = clamp(int3(ActiveBrick.xyz), int3(0, 0, 0), BrickGridResolution - 1);
	const int3 CellCoord = BrickCoord * SafeBrickSize + LocalCellCoord;
	OutCellCoord = uint3(CellCoord);
	return all(CellCoord >= int3(0, 0, 0)) && all(CellCoord < GridResolution);
}

int3 ClampSmokeCoord(int3 Coord)
{
	return clamp(Coord, int3(0, 0, 0), GridResolution - 1);
}

float3 LoadVelocity(int3 Coord)
{
	return VelocityIn.Load(int4(ClampSmokeCoord(Coord), 0)).xyz;
}

float LoadOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), ObstacleSdfSurfaceFeatherCm);
}

float3 LoadFaceOpen(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return ObstacleFaceOpenTexture.SampleLevel(VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), 0.0).xyz;
}

float3 LoadSolidVelocity(int3 Coord)
{
	const int3 SafeCoord = ClampSmokeCoord(Coord);
	return ObstacleVelocityTexture.SampleLevel(VolumeSampler, TimeThiefSmokeVoxelUVW(uint3(SafeCoord.x, SafeCoord.y, SafeCoord.z), GridResolution), 0.0).xyz;
}


float4 LoadPressureFaceOpen(int3 Coord)
{
	return ObstacleFaceOpenTexture.Load(int4(ClampSmokeCoord(Coord), 0));
}

float ComputeFirstJacobiPressure(int3 Coord, float Divergence)
{
	const float4 CenterFaces = LoadPressureFaceOpen(Coord);
	if (CenterFaces.w <= 0.01)
	{
		return 0.0;
	}
	const float3 InvCellSizeSq = 1.0 / max(CellSize * CellSize, 1.0);
	const float FaceX0 = Coord.x <= 0 ? 0.0 : CenterFaces.x;
	const float FaceY0 = Coord.y <= 0 ? 0.0 : CenterFaces.y;
	const float FaceZ0 = Coord.z <= 0 ? 0.0 : CenterFaces.z;
	const float FaceX1 = Coord.x >= GridResolution.x - 1 ? 0.0 : LoadPressureFaceOpen(Coord + int3(1, 0, 0)).x;
	const float FaceY1 = Coord.y >= GridResolution.y - 1 ? 0.0 : LoadPressureFaceOpen(Coord + int3(0, 1, 0)).y;
	const float FaceZ1 = Coord.z >= GridResolution.z - 1 ? 0.0 : LoadPressureFaceOpen(Coord + int3(0, 0, 1)).z;
	const float Denominator =
		(FaceX0 + FaceX1) * InvCellSizeSq.x +
		(FaceY0 + FaceY1) * InvCellSizeSq.y +
		(FaceZ0 + FaceZ1) * InvCellSizeSq.z;
	return Denominator > 0.000001 ? -Divergence / Denominator : 0.0;
}

float ComputeUFace(int3 Coord)
{
	if (Coord.x <= 0)
	{
		return 0.0;
	}

	const int3 LeftCoord = Coord - int3(1, 0, 0);
	const float FaceOpen = LoadFaceOpen(Coord).x;
	const float3 CenterVelocity = LoadVelocity(Coord);
	const float3 LeftVelocity = LoadVelocity(LeftCoord);
	const float3 CenterSolidVelocity = LoadSolidVelocity(Coord);
	const float3 LeftSolidVelocity = LoadSolidVelocity(LeftCoord);
	return lerp(0.5 * (CenterSolidVelocity.x + LeftSolidVelocity.x), 0.5 * (CenterVelocity.x + LeftVelocity.x), FaceOpen);
}

float ComputeVFace(int3 Coord)
{
	if (Coord.y <= 0)
	{
		return 0.0;
	}

	const int3 BackCoord = Coord - int3(0, 1, 0);
	const float FaceOpen = LoadFaceOpen(Coord).y;
	const float3 CenterVelocity = LoadVelocity(Coord);
	const float3 BackVelocity = LoadVelocity(BackCoord);
	const float3 CenterSolidVelocity = LoadSolidVelocity(Coord);
	const float3 BackSolidVelocity = LoadSolidVelocity(BackCoord);
	return lerp(0.5 * (CenterSolidVelocity.y + BackSolidVelocity.y), 0.5 * (CenterVelocity.y + BackVelocity.y), FaceOpen);
}

float ComputeWFace(int3 Coord)
{
	if (Coord.z <= 0)
	{
		return 0.0;
	}

	const int3 BottomCoord = Coord - int3(0, 0, 1);
	const float FaceOpen = LoadFaceOpen(Coord).z;
	const float3 CenterVelocity = LoadVelocity(Coord);
	const float3 BottomVelocity = LoadVelocity(BottomCoord);
	const float3 CenterSolidVelocity = LoadSolidVelocity(Coord);
	const float3 BottomSolidVelocity = LoadSolidVelocity(BottomCoord);
	return lerp(0.5 * (CenterSolidVelocity.z + BottomSolidVelocity.z), 0.5 * (CenterVelocity.z + BottomVelocity.z), FaceOpen);
}

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID)
{
	uint3 CellCoord = uint3(0, 0, 0);
	if (!ResolveSmokeCellCoord(DispatchThreadId, GroupId, GroupThreadId, CellCoord))
	{
		return;
	}

	const int3 Coord = int3(CellCoord);
	if (bUseActiveBrickDispatch == 0u && !IsSparseSimulationCellActive(CellCoord))
	{
		OutFaceVelocityU[CellCoord] = 0.0;
		OutFaceVelocityV[CellCoord] = 0.0;
		OutFaceVelocityW[CellCoord] = 0.0;
		OutDivergence[CellCoord] = 0.0;
		OutPressure[CellCoord] = 0.0;
		return;
	}

	const float U0 = ComputeUFace(Coord);
	const float V0 = ComputeVFace(Coord);
	const float W0 = ComputeWFace(Coord);
	OutFaceVelocityU[CellCoord] = U0;
	OutFaceVelocityV[CellCoord] = V0;
	OutFaceVelocityW[CellCoord] = W0;

	const float3 UVW = TimeThiefSmokeVoxelUVW(CellCoord, GridResolution);
	if (TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, UVW, ObstacleSdfSurfaceFeatherCm) <= 0.01)
	{
		OutDivergence[CellCoord] = 0.0;
		OutPressure[CellCoord] = 0.0;
		return;
	}

	const float3 InvCellSize = 1.0 / max(CellSize, 1.0);
	const float U1 = Coord.x >= GridResolution.x - 1 ? 0.0 : ComputeUFace(Coord + int3(1, 0, 0));
	const float V1 = Coord.y >= GridResolution.y - 1 ? 0.0 : ComputeVFace(Coord + int3(0, 1, 0));
	const float W1 = Coord.z >= GridResolution.z - 1 ? 0.0 : ComputeWFace(Coord + int3(0, 0, 1));
	const float Divergence =
		(U1 - U0) * InvCellSize.x +
		(V1 - V0) * InvCellSize.y +
		(W1 - W0) * InvCellSize.z;

	// Match the old R16F divergence round-trip before the first Jacobi update.
	const float StoredDivergence = f16tof32(f32tof16(Divergence));
	OutDivergence[CellCoord] = StoredDivergence;
	OutPressure[CellCoord] = ComputeFirstJacobiPressure(Coord, StoredDivergence);
}
