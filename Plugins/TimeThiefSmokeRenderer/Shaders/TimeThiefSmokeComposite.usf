#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeShaderParameters.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeSparse.ush"

TIME_THIEF_SMOKE_COMPOSITE_PARAMETERS

float3 ReconstructWorldPosition(float2 PixelPosition, float DeviceZ)
{
	const float2 ViewSize = max(float2(ViewRect.zw - ViewRect.xy), 1.0);
	const float2 UV = (PixelPosition - float2(ViewRect.xy)) / ViewSize;
	const float2 NDC = float2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
	float4 World = mul(float4(NDC, DeviceZ, 1.0), InvViewProjection);
	const float SafeW = abs(World.w) > 0.000001 ? World.w : (World.w < 0.0 ? -0.000001 : 0.000001);
	return World.xyz / SafeW;
}

bool IntersectUnitBox(float3 Origin, float3 Direction, out float TMin, out float TMax)
{
	const float3 DirectionSign = lerp(float3(-1.0, -1.0, -1.0), float3(1.0, 1.0, 1.0), step(float3(0.0, 0.0, 0.0), Direction));
	const float3 InvDirection = 1.0 / (Direction + DirectionSign * 0.000001);
	const float3 T0 = (-1.0 - Origin) * InvDirection;
	const float3 T1 = (1.0 - Origin) * InvDirection;
	const float3 TSmall = min(T0, T1);
	const float3 TBig = max(T0, T1);
	TMin = max(max(TSmall.x, TSmall.y), TSmall.z);
	TMax = min(min(TBig.x, TBig.y), TBig.z);
	return TMax >= max(TMin, 0.0);
}

float ComputeEventDebug(float3 SampleWorld)
{
	float Weight = 0.0;
	const int SafeEventCount = min(EventCount, 128);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const float3 EventPosition = Event.PositionRadius.xyz;
		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float3 EventDirection = normalize(Event.DirectionLength.xyz + 0.0001);
		const float Length = max(Event.DirectionLength.w, Radius * 2.0);
		const float Type = Event.TypeShapeAgeSeed.x;
		const float Shape = Event.TypeShapeAgeSeed.y;

		if (Type < 0.5 || Shape > 2.5)
		{
			const float3 Delta = SampleWorld - EventPosition;
			const float Along = clamp(dot(Delta, EventDirection), -Length * 0.5, Length * 0.5);
			const float3 Closest = EventPosition + EventDirection * Along;
			const float Distance = length(SampleWorld - Closest);
			const float Axial = 1.0 - smoothstep(Length * 0.45, Length * 0.55 + Radius, abs(Along));
			Weight = max(Weight, (1.0 - smoothstep(Radius * 0.35, Radius * 1.2, Distance)) * Axial);
		}
		else
		{
			const float Distance = length(SampleWorld - EventPosition);
			Weight = max(Weight, 1.0 - smoothstep(Radius * 0.45, Radius * 1.25, Distance));
		}
	}
	return saturate(Weight);
}

float ComputeAnalyticBulletOpen(float3 SampleWorld)
{
	float OpenMask = 1.0;
	const int SafeEventCount = min(AnalyticBulletEventCount, 128);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const float Type = Event.TypeShapeAgeSeed.x;
		if (Type >= 0.5)
		{
			continue;
		}

		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float Sdf = TimeThiefSmokeEventSweptSdf(Event, SampleWorld);
		const float AgeFade = 1.0 - saturate(Event.TypeShapeAgeSeed.z);
		const float Feather = max(Radius * 0.28, 1.0);
		const float Cutout = (1.0 - smoothstep(-Feather, Feather, Sdf)) * AgeFade;
		OpenMask = min(OpenMask, 1.0 - Cutout);
	}
	return saturate(OpenMask);
}

int3 ComputeBrickCoord(float3 VolumeUVW)
{
	const int3 CellCoord = clamp((int3)floor(saturate(VolumeUVW) * float3(GridResolution)), int3(0, 0, 0), GridResolution - 1);
	return clamp(CellCoord / max(SmokeBrickSize, 1), int3(0, 0, 0), BrickGridResolution - 1);
}

bool IsActiveBrick(float3 VolumeUVW)
{
	if (bUseSparseAtlas == 0u)
	{
		return true;
	}
	return BrickOccupancyTexture.Load(int4(ComputeBrickCoord(VolumeUVW), 0)) != 0u;
}

float4 LoadCompositeFieldCell(int3 CellCoord)
{
	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 SafeCellCoord = clamp(CellCoord, int3(0, 0, 0), GridResolution - 1);
	const int3 BrickCoord = clamp(SafeCellCoord / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	const uint BrickIndirection = BrickOccupancyTexture.Load(int4(BrickCoord, 0));
	if (BrickIndirection == 0u)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	if (BrickIndirection > (uint)max(MaxActiveSmokeBricks, 1))
	{
		return float4(
			DensityTexture.Load(int4(SafeCellCoord, 0)) + DisplacedDensityTexture.Load(int4(SafeCellCoord, 0)),
			WarpTexture.Load(int4(SafeCellCoord, 0)),
			BulletCutoutTexture.Load(int4(SafeCellCoord, 0)),
			BulletSinkTexture.Load(int4(SafeCellCoord, 0)));
	}

	const int3 AtlasBrickCoord = TimeThiefSmokeAtlasBrickCoord(BrickIndirection, SparseAtlasBrickGridResolution);
	const int3 LocalCellCoord = SafeCellCoord - BrickCoord * SafeBrickSize;
	const int3 AtlasCoord = AtlasBrickCoord * SafeBrickSize + LocalCellCoord;
	return SparseFieldAtlasTexture.Load(int4(AtlasCoord, 0));
}

float4 LoadCompositeAtlasCell(uint BrickIndirection, int3 BrickCoord, int3 SafeCellCoord)
{
	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const int3 AtlasBrickCoord = TimeThiefSmokeAtlasBrickCoord(BrickIndirection, SparseAtlasBrickGridResolution);
	const int3 LocalCellCoord = SafeCellCoord - BrickCoord * SafeBrickSize;
	const int3 AtlasCoord = AtlasBrickCoord * SafeBrickSize + LocalCellCoord;
	return SparseFieldAtlasTexture.Load(int4(AtlasCoord, 0));
}

float4 SampleCompositeSparseFields(float3 VolumeUVW)
{
	const int SafeBrickSize = max(SmokeBrickSize, 1);
	const float3 GridPosition = saturate(VolumeUVW) * max(float3(GridResolution), 1.0) - 0.5;
	const int3 Cell0 = (int3)floor(GridPosition);
	const float3 CellAlpha = saturate(GridPosition - float3(Cell0));
	const int3 Cell1 = Cell0 + int3(1, 1, 1);
	const int3 SafeCell0 = clamp(Cell0, int3(0, 0, 0), GridResolution - 1);
	const int3 SafeCell1 = clamp(Cell1, int3(0, 0, 0), GridResolution - 1);
	const int3 Brick0 = clamp(SafeCell0 / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);
	const int3 Brick1 = clamp(SafeCell1 / SafeBrickSize, int3(0, 0, 0), BrickGridResolution - 1);

	if (Brick0.x == Brick1.x && Brick0.y == Brick1.y && Brick0.z == Brick1.z)
	{
		const uint BrickIndirection = BrickOccupancyTexture.Load(int4(Brick0, 0));
		if (BrickIndirection == 0u)
		{
			return float4(0.0, 0.0, 0.0, 0.0);
		}
		if (BrickIndirection > (uint)max(MaxActiveSmokeBricks, 1))
		{
			return float4(
				DensityTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0) + DisplacedDensityTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
				WarpTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
				BulletCutoutTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
				BulletSinkTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0));
		}

		const float4 V000 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell0.y, SafeCell0.z));
		const float4 V100 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell0.y, SafeCell0.z));
		const float4 V010 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell1.y, SafeCell0.z));
		const float4 V110 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell1.y, SafeCell0.z));
		const float4 V001 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell0.y, SafeCell1.z));
		const float4 V101 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell0.y, SafeCell1.z));
		const float4 V011 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell0.x, SafeCell1.y, SafeCell1.z));
		const float4 V111 = LoadCompositeAtlasCell(BrickIndirection, Brick0, int3(SafeCell1.x, SafeCell1.y, SafeCell1.z));
		const float4 X00 = lerp(V000, V100, CellAlpha.x);
		const float4 X10 = lerp(V010, V110, CellAlpha.x);
		const float4 X01 = lerp(V001, V101, CellAlpha.x);
		const float4 X11 = lerp(V011, V111, CellAlpha.x);
		const float4 Y0 = lerp(X00, X10, CellAlpha.y);
		const float4 Y1 = lerp(X01, X11, CellAlpha.y);
		return lerp(Y0, Y1, CellAlpha.z);
	}

	const float4 V000 = LoadCompositeFieldCell(int3(Cell0.x, Cell0.y, Cell0.z));
	const float4 V100 = LoadCompositeFieldCell(int3(Cell1.x, Cell0.y, Cell0.z));
	const float4 V010 = LoadCompositeFieldCell(int3(Cell0.x, Cell1.y, Cell0.z));
	const float4 V110 = LoadCompositeFieldCell(int3(Cell1.x, Cell1.y, Cell0.z));
	const float4 V001 = LoadCompositeFieldCell(int3(Cell0.x, Cell0.y, Cell1.z));
	const float4 V101 = LoadCompositeFieldCell(int3(Cell1.x, Cell0.y, Cell1.z));
	const float4 V011 = LoadCompositeFieldCell(int3(Cell0.x, Cell1.y, Cell1.z));
	const float4 V111 = LoadCompositeFieldCell(int3(Cell1.x, Cell1.y, Cell1.z));

	const float4 X00 = lerp(V000, V100, CellAlpha.x);
	const float4 X10 = lerp(V010, V110, CellAlpha.x);
	const float4 X01 = lerp(V001, V101, CellAlpha.x);
	const float4 X11 = lerp(V011, V111, CellAlpha.x);
	const float4 Y0 = lerp(X00, X10, CellAlpha.y);
	const float4 Y1 = lerp(X01, X11, CellAlpha.y);
	return lerp(Y0, Y1, CellAlpha.z);
}

float4 SampleFieldSet(float3 VolumeUVW)
{
	return bUseSparseAtlas != 0u
		? SampleCompositeSparseFields(VolumeUVW)
		: float4(
			DensityTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0) + DisplacedDensityTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
			WarpTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
			BulletCutoutTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0),
			BulletSinkTexture.SampleLevel(VolumeSampler, saturate(VolumeUVW), 0.0));
}

float ComputeInactiveBrickSkip(float3 VolumeUVW, float3 RayUVWDirection, float StepSize)
{
	const int3 BrickCoord = ComputeBrickCoord(VolumeUVW);
	const float3 SafeGridResolution = max(float3(GridResolution), 1.0);
	const float3 BrickMin = (float3(BrickCoord) * max(SmokeBrickSize, 1)) / SafeGridResolution;
	const float3 BrickMax = min((float3(BrickCoord + 1) * max(SmokeBrickSize, 1)) / SafeGridResolution, 1.0);
	float DeltaT = 1000000.0;

	if (abs(RayUVWDirection.x) > 0.000001)
	{
		const float Boundary = RayUVWDirection.x > 0.0 ? BrickMax.x : BrickMin.x;
		const float AxisDelta = (Boundary - VolumeUVW.x) / RayUVWDirection.x;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}
	if (abs(RayUVWDirection.y) > 0.000001)
	{
		const float Boundary = RayUVWDirection.y > 0.0 ? BrickMax.y : BrickMin.y;
		const float AxisDelta = (Boundary - VolumeUVW.y) / RayUVWDirection.y;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}
	if (abs(RayUVWDirection.z) > 0.000001)
	{
		const float Boundary = RayUVWDirection.z > 0.0 ? BrickMax.z : BrickMin.z;
		const float AxisDelta = (Boundary - VolumeUVW.z) / RayUVWDirection.z;
		if (AxisDelta > 0.000001)
		{
			DeltaT = min(DeltaT, AxisDelta);
		}
	}

	return max(StepSize, DeltaT + 0.0001);
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 SceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, SceneUV, 0.0);
	const float SceneDeviceZ = SceneDepthTexture.Load(int3(uint2(SvPosition.xy), 0)).r;
	const float3 NearWorld = ReconstructWorldPosition(SvPosition.xy, 1.0);
	const float3 FarWorld = ReconstructWorldPosition(SvPosition.xy, 0.0);
	const bool bHasOpaqueSceneDepth = SceneDeviceZ > 0.000001;
	const float3 SceneWorld = bHasOpaqueSceneDepth ? ReconstructWorldPosition(SvPosition.xy, SceneDeviceZ) : FarWorld;
	const float3 LocalNear = mul(float4(NearWorld, 1.0), WorldToLocal).xyz / max(RenderBoundsExtent, 1.0);
	const float3 LocalFar = mul(float4(FarWorld, 1.0), WorldToLocal).xyz / max(RenderBoundsExtent, 1.0);
	const float3 LocalScene = mul(float4(SceneWorld, 1.0), WorldToLocal).xyz / max(RenderBoundsExtent, 1.0);
	const float3 RayDirection = normalize(LocalFar - LocalNear);

	float TMin = 0.0;
	float TMax = 0.0;
	if (!IntersectUnitBox(LocalNear, RayDirection, TMin, TMax))
	{
		OutColor = SceneColor;
		return;
	}

	TMin = max(TMin, 0.0);
	TMax = min(TMax, dot(LocalScene - LocalNear, RayDirection));
	if (TMax <= TMin)
	{
		OutColor = SceneColor;
		return;
	}

	const float LifetimeAlpha = 1.0 - smoothstep(DurationSeconds, DurationSeconds + max(SmokeFadeOutDuration, 0.001), AgeSeconds);
	const float3 GridCellSize = max((BoundsExtent * 2.0) / max(float3(GridResolution), 1.0), 1.0);
	const float MaxGridCellSize = max(max(GridCellSize.x, GridCellSize.y), GridCellSize.z);
	const float PhysicalRayLength = length(RayDirection * max(TMax - TMin, 0.0) * RenderBoundsExtent);
	const float TargetStepLength = max(MaxGridCellSize * max(RenderStepVoxelScale, 0.1), 1.0);
	const int AdaptiveSteps = (int)ceil(PhysicalRayLength / TargetStepLength);
	const int Steps = clamp(max(RenderStepCount, AdaptiveSteps), 8, max(RenderMaxStepCount, 8));
	const float StepSize = max((TMax - TMin) / Steps, 0.0001);
	const float3 LocalStep = RayDirection * StepSize * RenderBoundsExtent;
	const float3 RayUVWDirection = RayDirection * RenderBoundsExtent / max(BoundsExtent, 1.0) * 0.5;
	const float SimulationStepSize = length(LocalStep / max(BoundsExtent, 1.0));
	const float MaxResolvedBaseNoiseScale = 0.9 / MaxGridCellSize;
	const float MaxResolvedFineNoiseScale = 1.15 / MaxGridCellSize;
	const float StableRenderNoiseScale = min(max(RenderNoiseScale, 0.0), MaxResolvedBaseNoiseScale);
	const float StableRenderFilamentScale = min(max(RenderFilamentScale, 0.0), MaxResolvedBaseNoiseScale);
	const float FineNoiseMultiplier = min(1.86, MaxResolvedFineNoiseScale / max(StableRenderNoiseScale, 0.0001));
	const float FineFilamentMultiplier = min(1.9, MaxResolvedFineNoiseScale / max(StableRenderFilamentScale, 0.0001));
	float Transmittance = 1.0;
	float Scatter = 0.0;
	float WarpScatter = 0.0;
	float DebugValue = 0.0;
	const float RayJitter = TimeThiefSmokeHash13(float3(SvPosition.xy, AgeSeconds)) - 0.5;
	float CurrentT = max(TMin, TMin + (0.5 + RayJitter) * StepSize);

	[loop]
	for (int StepIndex = 0; StepIndex < Steps && CurrentT < TMax; ++StepIndex)
	{
		const float T = CurrentT;
		const float3 LocalPosition = LocalNear + RayDirection * T;
		const float3 SampleLocal = LocalPosition * RenderBoundsExtent;
		const float3 SimulationLocal = SampleLocal / max(BoundsExtent, 1.0);
		const float3 VolumeUVW = SimulationLocal * 0.5 + 0.5;
		if (!TimeThiefSmokeInsideUVW(VolumeUVW))
		{
			if (DebugMode == 9)
			{
				DebugValue = max(DebugValue, 0.08);
			}
			CurrentT += StepSize;
			continue;
		}

		if (!IsActiveBrick(VolumeUVW))
		{
			if (DebugMode == 7)
			{
				DebugValue = max(DebugValue, 0.05);
				CurrentT += StepSize;
				continue;
			}
			else
			{
				if (DebugMode != 8 && DebugMode != 9 && DebugMode != 10)
				{
					CurrentT += ComputeInactiveBrickSkip(VolumeUVW, RayUVWDirection, StepSize);
					continue;
				}
			}
		}

		const float4 RawFields = SampleFieldSet(VolumeUVW);
		const float RawDensity = max(RawFields.x, 0.0);
		const float RawWarp = max(RawFields.y, 0.0);
		if (DebugMode == 0 && RawDensity <= 0.0001 && RawWarp <= 0.0001)
		{
			CurrentT += StepSize;
			continue;
		}

		const float Obstacle = ObstacleTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0);
		const float BulletCutout = RawFields.z;
		const float BulletSink = RawFields.w;
		const FTimeThiefSmokeBulletOpenMasks BulletMasks = TimeThiefSmokeBulletOpenMasksFromValues(BulletCutout, BulletSink);
		const float3 SampleWorld = mul(float4(SampleLocal, 1.0), LocalToWorld).xyz;
		const float ObstacleOpen = TimeThiefSmokeObstacleOpenFromValue(Obstacle);
		const float BoundaryNoise = (TimeThiefSmokeHash13(SampleWorld * 0.007) - 0.5) * 0.04;
		const float EllipsoidDistance = length(SimulationLocal / float3(1.0, 1.0, 0.86));
		const float BoundaryMask = TimeThiefSmokeRenderBoundaryMask(SimulationLocal, BoundsExtent, NaturalBoundsExtent, BoundaryNoise);
		const float AnalyticBulletOpen = AnalyticBulletEventCount > 0 ? ComputeAnalyticBulletOpen(SampleWorld) : 1.0;
		const float DensityVisibility = ObstacleOpen * min(BulletMasks.Hard, AnalyticBulletOpen) * BoundaryMask * LifetimeAlpha;
		float Density = RawDensity * DensityVisibility;
		const float Warp = RawWarp * ObstacleOpen * BoundaryMask * LifetimeAlpha;
		if (DebugMode == 0 && Density <= 0.0001 && Warp <= 0.0001)
		{
			CurrentT += StepSize;
			continue;
		}

		const float TimeNoise = AgeSeconds * RenderNoiseTimeScale;
		float DensityNoise = 1.0;
		if (RenderNoiseStrength > 0.001)
		{
			const float3 NoisePosition = SimulationLocal * max(BoundsExtent, 1.0) * StableRenderNoiseScale;
			const float SmoothNoise = TimeThiefSmokeFBM(NoisePosition + TimeNoise);
			const float RidgeNoise = TimeThiefSmokeRidgedFBM(NoisePosition * 0.72 - TimeNoise * 0.65);
			const float FineRidgeNoise = TimeThiefSmokeRidgedFBM(NoisePosition * FineNoiseMultiplier + SmoothNoise * 0.37 + TimeNoise * 0.29);
			const float ClumpMask = smoothstep(0.34, 0.72, saturate(SmoothNoise * 0.16 + RidgeNoise * 0.50 + FineRidgeNoise * 0.42));
			DensityNoise = lerp(1.0 - RenderNoiseStrength * 0.64, 1.0 + RenderNoiseStrength * 1.72, ClumpMask);
		}

		float FilamentGain = 1.0;
		const float EdgeFilamentGate = smoothstep(0.38, 0.98, EllipsoidDistance);
		const float FilamentDensityGate = smoothstep(0.025, 0.16, RawDensity) * (1.0 - smoothstep(0.92, 1.85, RawDensity));
		const float FilamentInfluence = saturate(EdgeFilamentGate * FilamentDensityGate);
		if (RenderFilamentStrength > 0.001 && FilamentInfluence > 0.015)
		{
			const float3 FilamentPosition = SimulationLocal * max(BoundsExtent, 1.0) * StableRenderFilamentScale;
			const float3 FilamentWarp = TimeThiefSmokeDomainWarp(FilamentPosition * 0.43, TimeNoise * 0.72) * RenderFilamentWarpStrength;
			const float FilamentMask = TimeThiefSmokeFilamentMask(FilamentPosition + FilamentWarp, TimeNoise, RenderFilamentContrast);
			float CombinedFilamentMask = FilamentMask;
			float AirPocket = 0.5;
			if (bUseFastFilament == 0u && FilamentInfluence > 0.24 && RenderFilamentStrength > 1.05)
			{
				const float FineRidge = TimeThiefSmokeRidgedFBM(FilamentPosition * FineFilamentMultiplier - FilamentWarp * 0.36 + TimeNoise * 0.91);
				CombinedFilamentMask = saturate(FilamentMask * 0.78 + pow(saturate(FineRidge), max(RenderFilamentContrast * 0.92, 0.1)) * 0.28);
				AirPocket = TimeThiefSmokeFBM(FilamentPosition * 0.37 - FilamentWarp * 0.42 + TimeNoise * 0.37);
			}
			const float FilamentLow = max(0.38, 1.0 - RenderFilamentStrength * (0.18 + AirPocket * 0.28));
			const float FilamentHigh = 1.0 + RenderFilamentStrength * 0.48;
			FilamentGain = lerp(FilamentLow, FilamentHigh, CombinedFilamentMask);
		}
		const float BulletEdgeDensityGain = lerp(1.0, 1.16, BulletMasks.Edge);
		Density *= DensityNoise * lerp(1.0, FilamentGain, FilamentInfluence) * BulletEdgeDensityGain;

		if (DebugMode == 1)
		{
			DebugValue = max(DebugValue, saturate(RawDensity * 0.45));
		}
		else if (DebugMode == 2)
		{
			DebugValue = max(DebugValue, saturate(Obstacle));
		}
		else if (DebugMode == 3)
		{
			DebugValue = max(DebugValue, saturate(max(BulletCutout, BulletSink)));
		}
		else if (DebugMode == 5)
		{
			DebugValue = max(DebugValue, ComputeEventDebug(SampleWorld));
		}
		else if (DebugMode == 6)
		{
			DebugValue = max(DebugValue, saturate(RawWarp));
		}
		else if (DebugMode == 7)
		{
			DebugValue = 1.0;
		}
		else if (DebugMode == 8)
		{
			const float DivergenceMagnitude = abs(DivergenceTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0));
			DebugValue = max(DebugValue, saturate(log2(1.0 + DivergenceMagnitude * 16.0) * 0.25));
		}
		else if (DebugMode == 9)
		{
			const float BoundsEdge = max(max(abs(SimulationLocal.x), abs(SimulationLocal.y)), abs(SimulationLocal.z));
			DebugValue = max(DebugValue, smoothstep(0.86, 1.0, BoundsEdge));
		}
		else if (DebugMode == 10)
		{
			DebugValue = max(DebugValue, 1.0 - AnalyticBulletOpen);
		}

		const float Absorption = Density * Extinction * SimulationStepSize;
		const float StepTransmittance = exp2(-Absorption * 1.442695);
		Scatter += Transmittance * (1.0 - StepTransmittance) * Density;
		WarpScatter += Transmittance * Warp * SimulationStepSize * 0.85;
		Transmittance *= StepTransmittance;
		CurrentT += StepSize;

		if (Transmittance < 0.015)
		{
			break;
		}
	}

	if (DebugMode != 0)
	{
		float3 DebugColor = float3(0.85, 0.9, 1.0);
		if (DebugMode == 2)
		{
			DebugColor = float3(1.0, 0.18, 0.08);
		}
		else if (DebugMode == 3)
		{
			DebugColor = float3(1.0, 0.62, 0.08);
		}
		else if (DebugMode == 5)
		{
			DebugColor = float3(1.0, 0.05, 0.85);
		}
		else if (DebugMode == 6)
		{
			DebugColor = float3(0.45, 0.95, 1.0);
		}
		else if (DebugMode == 7)
		{
			DebugColor = float3(0.25, 1.0, 0.35);
		}
		else if (DebugMode == 8)
		{
			DebugColor = float3(0.15, 0.5, 1.0);
		}
		else if (DebugMode == 9)
		{
			DebugColor = float3(1.0, 0.95, 0.12);
		}
		else if (DebugMode == 10)
		{
			DebugColor = float3(0.95, 0.12, 0.35);
		}

		OutColor = float4(lerp(SceneColor.rgb, DebugColor, saturate(DebugValue * 0.88)), SceneColor.a);
		return;
	}

	const float Alpha = saturate(1.0 - Transmittance);
	const float PhaseBoost = lerp(0.75, 1.15, saturate(ScatteringAnisotropy * 0.5 + 0.5));
	const float3 SmokeColor = lerp(float3(0.6, 0.63, 0.65), float3(0.92, 0.93, 0.9), saturate(ScatteringAlbedo)) * PhaseBoost;
	const float3 Composited = SceneColor.rgb * Transmittance + SmokeColor * Alpha * saturate(0.82 + Scatter * 0.85);
	const float WarpAlpha = saturate(WarpScatter * 0.62);
	const float3 WarpColor = lerp(SmokeColor, float3(0.92, 0.96, 1.0), 0.55);
	OutColor = float4(lerp(Composited, WarpColor, WarpAlpha * 0.42), SceneColor.a);
}
