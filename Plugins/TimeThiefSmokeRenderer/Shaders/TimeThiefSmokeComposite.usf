#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/TimeThiefSmokeShaders/TimeThiefSmokeCommon.ush"

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
Texture2D<float> SceneDepthTexture;
Texture3D<float> DensityTexture;
Texture3D<float> ObstacleTexture;
Texture3D<float> BulletSuppressionTexture;
SamplerState VolumeSampler;
StructuredBuffer<FTimeThiefSmokeCarrierParticleShaderData> CarrierParticles;
StructuredBuffer<FTimeThiefSmokeEventShaderData> Events;

float4 SceneColorUVScaleBias;
int4 ViewRect;
float3 BoundsExtent;
float Extinction;
float ScatteringAlbedo;
float ScatteringAnisotropy;
float AgeSeconds;
float DurationSeconds;
float SmokeFadeOutDuration;
int RenderStepCount;
float RenderDensityScale;
float RenderDensityMax;
float RenderNoiseScale;
float RenderNoiseStrength;
float RenderFilamentScale;
float RenderFilamentStrength;
float RenderFilamentContrast;
float RenderFilamentWarpStrength;
float NoiseTimeScale;
float SmokeOpacityScale;
int LightSelfShadowStepCount;
float LightSelfShadowExtinctionScale;
float SmokeDirectionalLightStrength;
float SmokeSkyLightStrength;
int DebugMode;
int CarrierParticleCount;
int EventCount;
float4x4 InvViewProjection;
float4x4 LocalToWorld;
float4x4 WorldToLocal;

float TimeThiefSmokeLuminance(float3 Color)
{
	return dot(max(Color, 0.0), float3(0.2126, 0.7152, 0.0722));
}

float3 TimeThiefSmokeLimitLuminance(float3 Color, float MaxLuminance)
{
	const float Luminance = max(TimeThiefSmokeLuminance(Color), 0.0001);
	return Color * min(1.0, MaxLuminance / Luminance);
}

float3 TimeThiefSmokeNormalizeTint(float3 Color)
{
	const float Luminance = TimeThiefSmokeLuminance(Color);
	return Luminance > 0.001 ? saturate(Color / Luminance) : float3(1.0, 1.0, 1.0);
}

float3 ReconstructWorldPosition(float2 PixelPosition, float DeviceZ)
{
	const float2 ViewSize = max(float2(ViewRect.zw - ViewRect.xy), 1.0);
	const float2 UV = (PixelPosition - float2(ViewRect.xy)) / ViewSize;
	const float2 NDC = float2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
	float4 World = mul(float4(NDC, DeviceZ, 1.0), InvViewProjection);
	const float SafeW = abs(World.w) > 0.000001 ? World.w : (World.w < 0.0 ? -0.000001 : 0.000001);
	return World.xyz / SafeW;
}

float ComputeCarrierDebug(float3 SampleLocal)
{
	float Weight = 0.0;
	const int SafeParticleCount = min(CarrierParticleCount, 128);
	[loop]
	for (int ParticleIndex = 0; ParticleIndex < SafeParticleCount; ++ParticleIndex)
	{
		const FTimeThiefSmokeCarrierParticleShaderData Particle = CarrierParticles[ParticleIndex];
		const float Distance = length(SampleLocal - Particle.LocalPositionRadius.xyz);
		const float Radius = max(Particle.LocalPositionRadius.w, 1.0);
		Weight = max(Weight, 1.0 - smoothstep(Radius * 0.22, Radius * 0.72, Distance));
	}
	return saturate(Weight);
}

float ComputeEventDebug(float3 SampleWorld)
{
	float Weight = 0.0;
	const int SafeEventCount = min(EventCount, 128);
	[loop]
	for (int EventIndex = 0; EventIndex < SafeEventCount; ++EventIndex)
	{
		const FTimeThiefSmokeEventShaderData Event = Events[EventIndex];
		const float3 EventPosition = Event.PositionRadius.xyz;
		const float Radius = max(Event.PositionRadius.w, 1.0);
		const float3 EventDirection = normalize(Event.DirectionLength.xyz + 0.0001);
		const float Length = max(Event.DirectionLength.w, Radius * 2.0);
		const float Type = Event.TypeShapeAgeSeed.x;
		const float Shape = Event.TypeShapeAgeSeed.y;

		if (Type < 0.5 || Shape > 2.5)
		{
			const float3 Delta = SampleWorld - EventPosition;
			const float Along = clamp(dot(Delta, EventDirection), -Length * 0.5, Length * 0.5);
			const float3 Closest = EventPosition + EventDirection * Along;
			const float Distance = length(SampleWorld - Closest);
			const float Axial = 1.0 - smoothstep(Length * 0.45, Length * 0.55 + Radius, abs(Along));
			Weight = max(Weight, (1.0 - smoothstep(Radius * 0.35, Radius * 1.2, Distance)) * Axial);
		}
		else
		{
			const float Distance = length(SampleWorld - EventPosition);
			Weight = max(Weight, 1.0 - smoothstep(Radius * 0.45, Radius * 1.25, Distance));
		}
	}
	return saturate(Weight);
}

float ComputeSmokeRenderDensity(float3 LocalPosition, float3 VolumeUVW, float LifetimeAlpha)
{
	if (!TimeThiefSmokeInsideUVW(VolumeUVW))
	{
		return 0.0;
	}

	const float RawDensity = max(DensityTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0), 0.0);
	if (RawDensity <= 0.00001)
	{
		return 0.0;
	}

	const float BulletSuppression = saturate(BulletSuppressionTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0));
	const float ObstacleOpen = TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, VolumeUVW);
	const float BulletOpen = TimeThiefSmokeBulletDetailOpenFromValues(BulletSuppression, BulletSuppression);
	if (ObstacleOpen <= 0.0001 || BulletOpen <= 0.0001)
	{
		return 0.0;
	}

	const float TimeNoise = AgeSeconds * NoiseTimeScale;
	const float3 WorldScaleLocal = LocalPosition * max(BoundsExtent, 1.0);
	const float3 NoisePosition = WorldScaleLocal * RenderNoiseScale;
	const float SmoothNoise = TimeThiefSmokeFBM(NoisePosition + TimeNoise);
	const float RidgeNoise = TimeThiefSmokeRidgedFBM(NoisePosition * 1.73 - TimeNoise * 0.62);
	const float DensityNoise = lerp(1.0 - RenderNoiseStrength, 1.0 + RenderNoiseStrength, saturate(SmoothNoise * 0.58 + RidgeNoise * 0.42));
	const float3 FilamentPosition = WorldScaleLocal * RenderFilamentScale;
	const float3 FilamentWarp = TimeThiefSmokeDomainWarp(FilamentPosition * 0.54, TimeNoise) * RenderFilamentWarpStrength;
	const float FilamentMask = TimeThiefSmokeFilamentMask(FilamentPosition + FilamentWarp, TimeNoise, RenderFilamentContrast);
	const float AirPocket = TimeThiefSmokeAirPocketMask(FilamentPosition * 0.82 - FilamentWarp * 0.35, TimeNoise);
	const float EllipsoidDistance = length(LocalPosition / float3(1.0, 1.0, 0.86));
	const float RenderBoxDistance = max(max(abs(LocalPosition.x), abs(LocalPosition.y)), abs(LocalPosition.z));
	const float RenderBoundaryFade = 1.0 - smoothstep(0.94, 1.0, RenderBoxDistance);
	const float EdgeFilamentGate = smoothstep(0.48, 0.96, EllipsoidDistance);
	const float DenseCoreReject = 1.0 - smoothstep(0.78, 1.75, RawDensity);
	const float FilamentInfluence = saturate(EdgeFilamentGate * DenseCoreReject);
	const float TurbulenceEdge = saturate(EdgeFilamentGate * (0.45 + DenseCoreReject * 0.55));
	const float LargeBillow = TimeThiefSmokeRidgedFBM(NoisePosition * 0.46 + FilamentWarp * 0.18 + TimeNoise * 0.37);
	const float RollPhase = dot(WorldScaleLocal, normalize(float3(0.21, -0.13, 1.0))) * RenderNoiseScale * 5.8 + TimeNoise * 7.1;
	const float VortexRoll = 0.5 + 0.5 * sin(RollPhase + LargeBillow * 4.2);
	const float LumpyBillow = lerp(0.76, 1.34, saturate(LargeBillow * 0.7 + VortexRoll * 0.3));
	const float FilamentGain = lerp(1.0 - RenderFilamentStrength * (0.28 + AirPocket * 0.44), 1.0 + RenderFilamentStrength * 0.22, FilamentMask);
	const float AirPocketOpen = lerp(1.0, 0.82, AirPocket * TurbulenceEdge);
	const float TurbulenceGain = lerp(1.0, LumpyBillow, TurbulenceEdge * 0.65);
	const float BulletEdgeDensityGain = lerp(1.0, 1.12, TimeThiefSmokeBulletEdgeMaskFromValues(BulletSuppression, BulletSuppression));

	const float RenderDensityLimit = max(RenderDensityMax, 0.001);
	const float ModulatedDensity = RawDensity * ObstacleOpen * BulletOpen * BulletOpen * DensityNoise * lerp(1.0, FilamentGain, FilamentInfluence) * TurbulenceGain * AirPocketOpen * BulletEdgeDensityGain * RenderBoundaryFade * LifetimeAlpha * RenderDensityScale;
	return clamp(ModulatedDensity, 0.0, RenderDensityLimit);
}

float ComputeSmokeShadowDensity(float3 LocalPosition, float3 VolumeUVW, float LifetimeAlpha)
{
	if (!TimeThiefSmokeInsideUVW(VolumeUVW))
	{
		return 0.0;
	}

	const float RawDensity = max(DensityTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0), 0.0);
	const float BulletSuppression = saturate(BulletSuppressionTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0));
	const float BulletOpen = TimeThiefSmokeBulletDetailOpenFromValues(BulletSuppression, BulletSuppression);
	const float RenderBoxDistance = max(max(abs(LocalPosition.x), abs(LocalPosition.y)), abs(LocalPosition.z));
	const float RenderBoundaryFade = 1.0 - smoothstep(0.94, 1.0, RenderBoxDistance);

	const float RenderDensityLimit = max(RenderDensityMax, 0.001);
	const float ShadowDensity = RawDensity * TimeThiefSmokeObstacleOpen(ObstacleTexture, VolumeSampler, VolumeUVW) * BulletOpen * BulletOpen * RenderBoundaryFade * LifetimeAlpha * RenderDensityScale;
	return clamp(ShadowDensity, 0.0, RenderDensityLimit);
}

float ComputeSmokeSelfShadow(float3 LocalPosition, float3 LocalLightDirection, float LifetimeAlpha)
{
	float OpticalDepth = 0.0;
	const int SafeLightSteps = clamp(LightSelfShadowStepCount, 4, 16);
	const float LightStepSize = 0.46 / SafeLightSteps;

	[loop]
	for (int LightStepIndex = 1; LightStepIndex <= SafeLightSteps; ++LightStepIndex)
	{
		const float3 ShadowLocalPosition = LocalPosition + LocalLightDirection * (LightStepSize * LightStepIndex);
		const float3 ShadowUVW = ShadowLocalPosition * 0.5 + 0.5;
		OpticalDepth += ComputeSmokeShadowDensity(ShadowLocalPosition, ShadowUVW, LifetimeAlpha) * LightStepSize;
	}

	return exp(-OpticalDepth * Extinction * 2.15 * LightSelfShadowExtinctionScale);
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 SceneUV = SvPosition.xy * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, SceneUV, 0.0);
	const float SceneDeviceZ = SceneDepthTexture.Load(int3(uint2(SvPosition.xy), 0)).r;
	const float3 NearWorld = ReconstructWorldPosition(SvPosition.xy, 1.0);
	const float3 FarWorld = ReconstructWorldPosition(SvPosition.xy, 0.0);
	const bool bHasOpaqueSceneDepth = SceneDeviceZ > 0.000001;
	const float3 SceneWorld = bHasOpaqueSceneDepth ? ReconstructWorldPosition(SvPosition.xy, SceneDeviceZ) : FarWorld;
	const float3 LocalNear = mul(float4(NearWorld, 1.0), WorldToLocal).xyz / max(BoundsExtent, 1.0);
	const float3 LocalFar = mul(float4(FarWorld, 1.0), WorldToLocal).xyz / max(BoundsExtent, 1.0);
	const float3 LocalScene = mul(float4(SceneWorld, 1.0), WorldToLocal).xyz / max(BoundsExtent, 1.0);
	const float3 RayDirection = normalize(LocalFar - LocalNear);

	float TMin = 0.0;
	float TMax = 0.0;
	if (!TimeThiefSmokeIntersectUnitBox(LocalNear, RayDirection, TMin, TMax))
	{
		OutColor = SceneColor;
		return;
	}

	TMin = max(TMin, 0.0);
	TMax = min(TMax, dot(LocalScene - LocalNear, RayDirection));
	if (TMax <= TMin)
	{
		OutColor = SceneColor;
		return;
	}

	const int Steps = clamp(RenderStepCount, 16, 128);
	const float StepSize = max((TMax - TMin) / Steps, 0.0001);
	const float LifetimeAlpha = 1.0 - smoothstep(DurationSeconds, DurationSeconds + max(SmokeFadeOutDuration, 0.001), AgeSeconds);
	const float3 ViewDirection = normalize(LocalNear - LocalFar);
	const float3 LightDirectionWorld = normalize(View.DirectionalLightDirection + float3(0.0001, 0.0001, 0.0001));
	const float3 LocalLightDirection = normalize((mul(float4(LightDirectionWorld, 0.0), WorldToLocal).xyz / max(BoundsExtent, 1.0)) + 0.0001);
	float Transmittance = 1.0;
	float Scatter = 0.0;
	float LitVisibilityAccum = 0.0;
	float OpacityWeightAccum = 0.0;
	float DebugValue = 0.0;

	[loop]
	for (int StepIndex = 0; StepIndex < Steps; ++StepIndex)
	{
		const float T = TMin + (StepIndex + 0.5) * StepSize;
		const float3 LocalPosition = LocalNear + RayDirection * T;
		const float3 VolumeUVW = LocalPosition * 0.5 + 0.5;
		if (!TimeThiefSmokeInsideUVW(VolumeUVW))
		{
			continue;
		}

		const float RawDensity = max(DensityTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0), 0.0);
		const float Obstacle = ObstacleTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0);
		const float BulletSuppression = BulletSuppressionTexture.SampleLevel(VolumeSampler, VolumeUVW, 0.0);
		const float Density = ComputeSmokeRenderDensity(LocalPosition, VolumeUVW, LifetimeAlpha);

		if (DebugMode == 1)
		{
			DebugValue = max(DebugValue, saturate(RawDensity * 0.45));
		}
		else if (DebugMode == 2)
		{
			DebugValue = max(DebugValue, saturate(Obstacle));
		}
		else if (DebugMode == 3)
		{
			DebugValue = max(DebugValue, saturate(BulletSuppression));
		}
		else if (DebugMode == 4)
		{
			DebugValue = max(DebugValue, ComputeCarrierDebug(LocalPosition * BoundsExtent));
		}
		else if (DebugMode == 5)
		{
			const float3 SampleWorld = mul(float4(LocalPosition * BoundsExtent, 1.0), LocalToWorld).xyz;
			DebugValue = max(DebugValue, ComputeEventDebug(SampleWorld));
		}

		if (Density <= 0.0001)
		{
			continue;
		}

		const float Absorption = Density * Extinction * SmokeOpacityScale * StepSize;
		const float StepTransmittance = exp(-Absorption);
		const float StepOpacity = Transmittance * (1.0 - StepTransmittance);
		const float SelfShadow = ComputeSmokeSelfShadow(LocalPosition, LocalLightDirection, LifetimeAlpha);
		Scatter += Transmittance * (1.0 - StepTransmittance) * Density;
		LitVisibilityAccum += StepOpacity * SelfShadow;
		OpacityWeightAccum += StepOpacity;
		Transmittance *= StepTransmittance;

		if (Transmittance < 0.015)
		{
			break;
		}
	}

	if (DebugMode != 0)
	{
		float3 DebugColor = float3(0.85, 0.9, 1.0);
		if (DebugMode == 2)
		{
			DebugColor = float3(1.0, 0.18, 0.08);
		}
		else if (DebugMode == 3)
		{
			DebugColor = float3(1.0, 0.62, 0.08);
		}
		else if (DebugMode == 4)
		{
			DebugColor = float3(0.1, 0.8, 1.0);
		}
		else if (DebugMode == 5)
		{
			DebugColor = float3(1.0, 0.05, 0.85);
		}

		OutColor = float4(lerp(SceneColor.rgb, DebugColor, saturate(DebugValue * 0.88)), SceneColor.a);
		return;
	}

	const float SceneLuminance = TimeThiefSmokeLuminance(SceneColor.rgb);
	const float OpticalAlpha = saturate((1.0 - Transmittance) * 5.5 + Scatter * 0.12);
	const float SmokeCoverage = saturate(OpacityWeightAccum * 8.0);
	const float SmokeOpacity = saturate(max(smoothstep(0.015, 0.16, OpticalAlpha), SmokeCoverage * 0.98) + OpticalAlpha * 0.45);
	const float AverageSelfShadow = OpacityWeightAccum > 0.0001 ? saturate(LitVisibilityAccum / OpacityWeightAccum) : 1.0;
	const float PhaseCos = dot(ViewDirection, LocalLightDirection);
	const float Phase = TimeThiefSmokeHenyeyGreensteinPhase(PhaseCos, ScatteringAnisotropy) * 12.5663706;
	const float3 DirectionalTint = TimeThiefSmokeNormalizeTint(View.DirectionalLightColor.rgb);
	const float3 SkyTint = TimeThiefSmokeNormalizeTint(View.SkyLightColor.rgb);
	const float3 EnvironmentTint = TimeThiefSmokeNormalizeTint(lerp(SkyTint, DirectionalTint, 0.35));
	const float3 LightTint = saturate(lerp(float3(1.0, 1.0, 1.0), EnvironmentTint, 0.08));
	const float AmbientFloor = 0.88 * SmokeSkyLightStrength;
	const float AmbientTerm = max(AmbientFloor, lerp(0.8, 1.0, saturate(SceneLuminance * 0.9)) * SmokeSkyLightStrength);
	const float DirectTerm = lerp(0.04, 0.12, saturate(SceneLuminance * 1.1)) * lerp(0.75, 1.0, AverageSelfShadow) * SmokeDirectionalLightStrength;
	const float DepthShadow = lerp(1.0, 0.96, saturate(Scatter * 0.08));
	const float ShadowLift = lerp(0.96, 1.0, AverageSelfShadow);
	const float3 SmokeAlbedo = lerp(float3(0.96, 0.98, 0.96), float3(1.0, 1.0, 0.98), saturate(ScatteringAlbedo));
	float3 LitSmokeColor = SmokeAlbedo * LightTint * (AmbientTerm + DirectTerm * lerp(0.72, 1.12, Phase)) * ShadowLift * DepthShadow;
	LitSmokeColor = clamp(LitSmokeColor, float3(0.86, 0.88, 0.86), float3(1.0, 1.0, 0.98));
	float3 Composited = lerp(SceneColor.rgb, LitSmokeColor, SmokeOpacity);

	const float ExposureSafeMaxLuminance = max(1.08, SceneLuminance * lerp(1.12, 0.94, SmokeOpacity) + SmokeOpacity * 0.9);
	Composited = TimeThiefSmokeLimitLuminance(Composited, ExposureSafeMaxLuminance);
	OutColor = float4(Composited, SceneColor.a);
}
