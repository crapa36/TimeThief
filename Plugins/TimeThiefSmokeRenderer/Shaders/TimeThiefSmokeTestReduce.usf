#include "/Engine/Public/Platform.ush"

// Test-only parallel reduction. A 4x4x4 group reduces one tile, then a
// second pass reduces tile results without reading the 3D field on the CPU.

int3 GridResolution;
float3 BoundsExtent;
float SmokeDensityMax;

Texture3D<float> DensityTexture;
Texture3D<float> DisplacedDensityTexture;
Texture3D<float4> VelocityTexture;
Texture3D<float> BulletCutoutTexture;
Texture3D<float> BulletSinkTexture;
Texture3D<float> ObstacleTexture;
RWStructuredBuffer<float4> OutTileResults;

uint TileCount;
StructuredBuffer<float4> TileResults;
RWStructuredBuffer<float4> OutResult;

groupshared float4 GroupValues[64][5];

void CombineValues(uint Index, inout float4 Destination, float4 Source)
{
	if (Index == 0u)
	{
		Destination += Source;
	}
	else if (Index == 1u)
	{
		Destination.x += Source.x;
		Destination.y = max(Destination.y, Source.y);
		Destination.z = max(Destination.z, Source.z);
		Destination.w = max(Destination.w, Source.w);
	}
	else if (Index == 2u)
	{
		Destination += Source;
	}
	else if (Index == 3u)
	{
		Destination.xyz = max(Destination.xyz, Source.xyz);
		Destination.w += Source.w;
	}
	else
	{
		Destination += Source;
	}
}

[numthreads(4, 4, 4)]
void ReduceTilesCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex, uint3 GroupId : SV_GroupID)
{
	float4 Values[5] =
	{
		float4(0.0, 0.0, 0.0, 0.0),
		float4(0.0, 0.0, 0.0, 0.0),
		float4(0.0, 0.0, 0.0, 0.0),
		float4(0.0, 0.0, 0.0, 0.0),
		float4(0.0, 0.0, 0.0, 0.0)
	};

	if (all(DispatchThreadId < uint3(GridResolution)))
	{
		const int4 Coord = int4(DispatchThreadId, 0);
		const float NaturalDensity = max(0.0, DensityTexture.Load(Coord));
		const float DisplacedDensity = max(0.0, DisplacedDensityTexture.Load(Coord));
		const float Density = NaturalDensity + DisplacedDensity;
		const float3 Velocity = VelocityTexture.Load(Coord).xyz;
		const float VelocitySquared = dot(Velocity, Velocity);
		const float Cutout = max(0.0, BulletCutoutTexture.Load(Coord));
		const float Sink = max(0.0, BulletSinkTexture.Load(Coord));
		const float ObstacleSdf = ObstacleTexture.Load(Coord);
		const float3 UVW = (float3(DispatchThreadId) + 0.5) / float3(GridResolution);
		const float3 LocalPosition = (UVW * 2.0 - 1.0) * BoundsExtent;

		Values[0] = float4(NaturalDensity, DisplacedDensity, LocalPosition.xy * Density);
		Values[1] = float4(LocalPosition.z * Density, length(Velocity), Cutout, Sink);
		Values[2] = float4(Density > 0.0001 ? 1.0 : 0.0, max(Cutout, Sink) > 0.0001 ? 1.0 : 0.0, ObstacleSdf < 0.0 ? Density : 0.0, Density);
		Values[3] = float4(NaturalDensity, DisplacedDensity, Density, Density > SmokeDensityMax + 0.0001 ? 1.0 : 0.0);
		Values[4] = float4(ObstacleSdf < 0.0 ? 1.0 : 0.0, VelocitySquared, 0.0, 0.0);
	}

	[unroll]
	for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
	{
		GroupValues[GroupIndex][ValueIndex] = Values[ValueIndex];
	}
	GroupMemoryBarrierWithGroupSync();

	for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
	{
		if (GroupIndex < Stride)
		{
			[unroll]
			for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
			{
				CombineValues(ValueIndex, GroupValues[GroupIndex][ValueIndex], GroupValues[GroupIndex + Stride][ValueIndex]);
			}
		}
		GroupMemoryBarrierWithGroupSync();
	}

	if (GroupIndex == 0u)
	{
		const uint TileIndex = GroupId.x + GroupId.y * ((GridResolution.x + 3) / 4) + GroupId.z * ((GridResolution.x + 3) / 4) * ((GridResolution.y + 3) / 4);
		[unroll]
		for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
		{
			OutTileResults[TileIndex * 5u + ValueIndex] = GroupValues[0][ValueIndex];
		}
	}
}

[numthreads(64, 1, 1)]
void ReduceFinalCS(uint GroupIndex : SV_GroupIndex)
{
	float4 Values[5] =
	{
		float4(0.0, 0.0, 0.0, 0.0), float4(0.0, 0.0, 0.0, 0.0), float4(0.0, 0.0, 0.0, 0.0),
		float4(0.0, 0.0, 0.0, 0.0), float4(0.0, 0.0, 0.0, 0.0)
	};
	for (uint TileIndex = GroupIndex; TileIndex < TileCount; TileIndex += 64u)
	{
		[unroll]
		for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
		{
			CombineValues(ValueIndex, Values[ValueIndex], TileResults[TileIndex * 5u + ValueIndex]);
		}
	}
	[unroll]
	for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
	{
		GroupValues[GroupIndex][ValueIndex] = Values[ValueIndex];
	}
	GroupMemoryBarrierWithGroupSync();
	for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
	{
		if (GroupIndex < Stride)
		{
			[unroll]
			for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
			{
				CombineValues(ValueIndex, GroupValues[GroupIndex][ValueIndex], GroupValues[GroupIndex + Stride][ValueIndex]);
			}
		}
		GroupMemoryBarrierWithGroupSync();
	}
	if (GroupIndex == 0u)
	{
		[unroll]
		for (uint ValueIndex = 0u; ValueIndex < 5u; ++ValueIndex)
		{
			OutResult[ValueIndex] = GroupValues[0][ValueIndex];
		}
	}
}
