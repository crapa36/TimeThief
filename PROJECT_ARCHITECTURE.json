    "ExperienceDefinitions": "DA_Experience_Default"
  },
  "GameplayTags": {
    "Input": {
      "Action": ["Move", "Look", "Jump", "Fire", "Reload", "Aim", "Melee"]
    },
    "Weapon": {
      "Type": ["Rifle", "Pistol"],
      "State": ["Equipped", "Holstered", "Reloading", "Firing"]
    },
    "Status": {
      "State": ["Idle", "Moving", "Jumping", "Falling", "Dead"]
    },
    "InitState": ["Spawned", "DataAvailable", "DataInitialized", "GameplayReady"]
  },
  "Architecture": {
    "DataFlow": {
      "Initialization": [
        "1. GameMode creates player pawn",
        "2. GameMode sets Experience and loads PawnData",
        "3. PawnExtensionComponent InitState begins",
        "4. HeroComponent receives PawnData",
        "5. HeroComponent sets up input from PawnData.InputConfig",
        "6. InitState reaches GameplayReady"
      ],
      "Input": [
        "1. Enhanced Input triggers in PlayerController",
        "2. HeroComponent receives bound input",
        "3. Move/Look directly controls pawn",
        "4. Combat inputs route to CombatComponent.HandleInputPressed/Released",
        "5. CombatComponent executes action directly (fire, reload, melee)"
      ],
      "Combat": [
        "1. Input pressed in HeroComponent",
        "2. Routed to CombatComponent.HandleInputPressed(InputTag)",
        "3. CombatComponent checks InputTag and executes action",
        "4. Fire: Weapon->Fire(), Reload: Weapon->Reload()",
        "5. HealthComponent applies damage to targets",
        "6. UI and animation updates"
      ]
    },
    "NetworkModel": {
      "Character": "Replicated with autonomous proxy",
      "Components": "Replicated where needed (Health, Combat state)",
      "Combat": "Server-authoritative with client prediction",
      "Weapons": "Replicated actors owned by character"
    }
  },
  "Dependencies": {
    "RequiredModules": [
      "Core",
      "CoreUObject",
      "Engine",
      "InputCore",
      "EnhancedInput",
      "ModularGameplay",
      "GameFeatures",
      "GameplayTags",
      "MotionTrajectory",
      "PoseSearch",
      "AnimationWarping",
      "UMG"
    ],
    "RemovedModules": [
      "GameplayAbilities (GAS completely removed)"
    ]
  },
  "BuildConfiguration": {
    "EngineVersion": "5.7",
    "TargetPlatforms": ["Win64"]
  }
}

