{
  "Project": "TimeThief",
  "Version": "2.1",
  "Architecture": "Lyra-inspired Modular Component System",
  "LastUpdated": "2025-12-31",
  "CorePhilosophy": {
    "Design": "Data-driven, Component-based, Modular",
    "NoGAS": "No GameplayAbilitySystem - direct combat handling in components",
    "GameplayTags": "Retained for flexible identification and event handling",
    "Initialization": "InitState machine pattern for ordered component setup",
    "Combat": "Component-based combat - CombatComponent handles all actions directly"
  },
  "ClassReference": {
    "Character": {
      "ATimeThiefCharacterBase": {
        "Role": "모든 캐릭터의 기본 클래스",
        "Workflow": "Capsule/Movement 기본 설정, 자식 클래스에서 확장",
        "Key": "GetPawnCombatComponent() 가상 함수 제공"
      },
      "ATimeThiefPlayerCharacter": {
        "Role": "플레이어 캐릭터",
        "Workflow": "생성 시 Camera, HeroComponent, CombatComponent, TrajectoryComponent 초기화 → PossessedBy에서 PawnData 설정 대기 → GameMode가 SetPawnData 호출 → OnPawnDataSet에서 HeroComponent에 전달",
        "Components": ["CameraBoom", "FollowCamera", "HeroComponent", "PlayerCombatComponent", "CharacterTrajectoryComponent"],
        "Key": "PawnData 복제, SetupPlayerInputComponent에서 입력 초기화"
      },
      "ATimeThiefEnemyCharacter": {
        "Role": "적 캐릭터 기본 클래스",
        "Workflow": "BeginPlay에서 기본 초기화, AI Controller에 의해 제어",
        "Key": "향후 EnemyCombatComponent 추가 예정"
      },
      "UTimeThiefPawnData": {
        "Role": "Pawn 설정 데이터 에셋",
        "Workflow": "GameMode에서 로드 → PlayerCharacter에 전달 → HeroComponent가 InputConfig 사용",
        "Properties": ["PawnClass", "InputConfig", "PawnTags"]
      }
    },
    "Components": {
      "UTimeThiefPawnExtensionComponent": {
        "Role": "InitState 패턴 구현 기본 컴포넌트",
        "Workflow": "RegisterInitStateFeature → CheckDefaultInitialization → HandleChangeInitState → OnPawnReadyToInitialize",
        "Key": "IGameFrameworkInitStateInterface 구현, 모든 확장 컴포넌트의 부모"
      },
      "UTimeThiefHeroComponent": {
        "Role": "플레이어 입력 바인딩 및 라우팅",
        "Workflow": "SetPawnData 호출 → InitializePlayerInput에서 InputConfig 기반 바인딩 → Move/Look 직접 처리, 전투 입력은 CombatComponent로 라우팅",
        "Key": "Input_Move, Input_Look, HandleInputPressed/Released → CombatComponent 전달"
      },
      "UTimeThiefPawnCombatComponent": {
        "Role": "전투 시스템 기본 컴포넌트",
        "Workflow": "RegisterSpawnedWeapon으로 무기 등록 → EquipWeapon/UnequipCurrentWeapon으로 장착 관리 → HandleInputPressed에서 전투 입력 처리",
        "Properties": ["CharacterCarriedWeaponMap", "CurrentEquippedWeapon", "CurrentEquippedWeaponTag"],
        "Key": "무기 Attach/Detach, AnimLayer 링크/언링크"
      },
      "UTimeThiefPlayerCombatComponent": {
        "Role": "플레이어 전용 전투 컴포넌트",
        "Workflow": "BeginPlay에서 DefaultWeaponClasses 자동 스폰 → HandleInputPressed에서 장착 토글 (같은 무기면 해제, 다른 무기면 장착)",
        "Key": "SpawnAndRegisterWeapon, 1번 키로 라이플 토글"
      }
    },
    "Animation": {
      "UTimeThiefAnimInstance": {
        "Role": "모든 캐릭터 애니메이션 기본 클래스",
        "Workflow": "NativeInitializeAnimation에서 CharacterOwner/CharacterMovement 캐싱 → NativeUpdateAnimation에서 매 프레임 상태 업데이트",
        "Properties": {
          "Locomotion": ["Velocity", "GroundSpeed", "bHasVelocity", "bIsMoving"],
          "Jump": ["bIsFalling", "bIsJumping", "VerticalVelocity"]
        },
        "Key": "UpdateCharacterState, UpdateLocomotionData"
      },
      "UTimeThiefPlayerAnimInstance": {
        "Role": "플레이어 전용 애니메이션",
        "Workflow": "부모 업데이트 후 → UpdateWeaponData에서 무기 상태/IK 업데이트",
        "Properties": ["PlayerCharacter", "TrajectoryComponent", "EquippedWeaponTag", "LeftHandIKTransform", "bHasWeapon", "CurrentWeapon"],
        "Key": "Motion Matching 연동, 무기별 AnimLayer, Left Hand IK"
      }
    },
    "Input": {
      "UTimeThiefInputComponent": {
        "Role": "GameplayTag 기반 입력 바인딩",
        "Workflow": "BindActionsByTag로 InputConfig의 태그-액션 매핑을 일괄 바인딩",
        "Key": "템플릿 함수로 Pressed/Released 콜백 바인딩"
      },
      "UTimeThiefInputConfig": {
        "Role": "입력 설정 데이터 에셋",
        "Workflow": "GameplayTag와 UInputAction 매핑 저장 → HeroComponent에서 로드하여 바인딩",
        "Properties": ["NativeInputActions", "AbilityInputActions"],
        "Key": "FindNativeInputActionForTag, FindAbilityInputActionForTag"
      }
    },
    "Game": {
      "ATimeThiefGameMode": {
        "Role": "게임 규칙 및 플레이어 초기화",
        "Workflow": "InitGame에서 Experience 로드 → HandleStartingNewPlayer에서 플레이어에게 PawnData 전달",
        "Properties": ["DefaultExperience", "DefaultPawnData"],
        "Key": "SetPawnData 호출로 플레이어 초기화 완료"
      },
      "UTimeThiefExperienceDefinition": {
        "Role": "게임 경험 정의 데이터 에셋",
        "Workflow": "GameMode에서 로드 → DefaultPawnData 제공, 향후 GameFeatures 활성화",
        "Properties": ["DefaultPawnData", "GameFeaturesToEnable", "Actions", "ExperienceTags"]
      }
    },
    "Weapon": {
      "ATimeThiefWeaponBase": {
        "Role": "무기 기본 액터",
        "Workflow": "CombatComponent에서 스폰 → RegisterSpawnedWeapon으로 등록 → EquipWeapon 시 캐릭터 소켓에 Attach",
        "Properties": ["WeaponTag", "SocketName", "WeaponMesh", "EquipAnimLayer", "EquipMontage", "UnequipMontage"],
        "Key": "GetWeaponTag로 식별, GetEquipAnimLayer로 애니메이션 레이어 제공"
      }
    },
    "System": {
      "FTimeThiefGameplayTags": {
        "Role": "네이티브 GameplayTag 정의",
        "Workflow": "StartupModule에서 InitializeNativeGameplayTags 호출 → 싱글턴으로 전역 접근",
        "Tags": {
          "Input": ["Move", "Look", "Jump", "Fire", "Reload", "Aim", "Melee", "EquipRifle"],
          "Weapon": ["Rifle", "Pistol"],
          "State": ["Combat.Rifle", "Combat.Pistol"],
          "InitState": ["Spawned", "DataAvailable", "DataInitialized", "GameplayReady"]
        }
      }
    }
  },
  "Directories": {
    "Character": {
      "Status": "✓ Implemented",
      "Path": "Source/TimeThief/Character",
      "Classes": {
        "TimeThiefCharacterBase": {
